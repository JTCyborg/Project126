; PROJECT126 NeoGS physical RAM allocation, revision 0.1
; 4 MiB physical RAM, divided into 256 pages of 16 KiB.
; Physical allocation only: not the Z80 logical 64 KiB window map.

P126_NGS_PAGE_SHIFT          EQU 14
P126_NGS_PAGE_SIZE           EQU #4000
P126_NGS_RAM_SIZE            EQU #400000
P126_NGS_PAGE_COUNT          EQU P126_NGS_RAM_SIZE/P126_NGS_PAGE_SIZE

; Half-open page ranges [START, START+COUNT).
P126_NGS_KERNEL_PAGE         EQU #00
P126_NGS_KERNEL_PAGES        EQU #10
P126_NGS_SYSBIOS_PAGE        EQU #10
P126_NGS_SYSBIOS_PAGES       EQU #10
P126_NGS_VGABIOS_PAGE        EQU #20
P126_NGS_VGABIOS_PAGES       EQU #10
P126_NGS_VRAM_PAGE           EQU #30
P126_NGS_VRAM_PAGES          EQU #10
P126_NGS_FRAME_PAGE          EQU #40
P126_NGS_FRAME_PAGES         EQU 2
P126_NGS_DMA_PAGE            EQU #42
P126_NGS_DMA_PAGES           EQU 1
P126_NGS_IPC_PAGE            EQU #43
P126_NGS_IPC_PAGES           EQU 1
P126_NGS_GUEST_RAM_PAGE      EQU #44
P126_NGS_GUEST_RAM_PAGES     EQU #40
P126_NGS_RESERVED_PAGE       EQU #84
P126_NGS_RESERVED_PAGES      EQU #7C

; Project126 resident execution contract, revision 0.2:
; WIN0..WIN2 are reserved for resident code/data/stack.
; WIN3 (C000-FFFF) is the dedicated banked physical-RAM aperture.
; x86 memory helpers select WIN3 through MPAGEX port 10h. The physical page
; number is encoded with RRCA before OUT; port 23h is PG3, not MPAGEX.
; Callers and interrupt handlers must not place code/stack in WIN3.
P126_NGS_BANK_WINDOW_INDEX     EQU 3
P126_NGS_BANK_WINDOW_BASE      EQU #C000
P126_NGS_BANK_WINDOW_PORT      EQU #10
P126_NGS_GUEST_RAM_PAGE_BASE   EQU P126_NGS_GUEST_RAM_PAGE

; Guest memory backend page-bias constants for the WIN3 selector.
; page = (guest_high_nibble*4)+(guest_middle>>6)+bias.
P126_NGS_GUEST_VRAM_PAGE_BIAS       EQU #08
P126_NGS_GUEST_VGABIOS_PAGE_BIAS    EQU #F0
P126_NGS_GUEST_SYSBIOS_PAGE_BIAS    EQU #D1

; Physical byte offsets.
P126_NGS_KERNEL_BASE         EQU P126_NGS_KERNEL_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_KERNEL_LIMIT        EQU (P126_NGS_KERNEL_PAGE+P126_NGS_KERNEL_PAGES)*P126_NGS_PAGE_SIZE
P126_NGS_SYSBIOS_BASE        EQU P126_NGS_SYSBIOS_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_SYSBIOS_LIMIT       EQU (P126_NGS_SYSBIOS_PAGE+P126_NGS_SYSBIOS_PAGES)*P126_NGS_PAGE_SIZE
P126_NGS_VGABIOS_BASE        EQU P126_NGS_VGABIOS_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_VGABIOS_LIMIT       EQU (P126_NGS_VGABIOS_PAGE+P126_NGS_VGABIOS_PAGES)*P126_NGS_PAGE_SIZE
P126_NGS_VRAM_BASE           EQU P126_NGS_VRAM_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_VRAM_LIMIT          EQU (P126_NGS_VRAM_PAGE+P126_NGS_VRAM_PAGES)*P126_NGS_PAGE_SIZE
P126_NGS_FRAME_BASE          EQU P126_NGS_FRAME_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_FRAME_LIMIT         EQU (P126_NGS_FRAME_PAGE+P126_NGS_FRAME_PAGES)*P126_NGS_PAGE_SIZE
P126_NGS_DMA_BASE            EQU P126_NGS_DMA_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_DMA_LIMIT           EQU (P126_NGS_DMA_PAGE+P126_NGS_DMA_PAGES)*P126_NGS_PAGE_SIZE
P126_NGS_IPC_BASE            EQU P126_NGS_IPC_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_IPC_LIMIT           EQU (P126_NGS_IPC_PAGE+P126_NGS_IPC_PAGES)*P126_NGS_PAGE_SIZE
P126_NGS_GUEST_RAM_BASE      EQU P126_NGS_GUEST_RAM_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_GUEST_RAM_LIMIT     EQU (P126_NGS_GUEST_RAM_PAGE+P126_NGS_GUEST_RAM_PAGES)*P126_NGS_PAGE_SIZE
P126_NGS_RESERVED_BASE       EQU P126_NGS_RESERVED_PAGE*P126_NGS_PAGE_SIZE
P126_NGS_RESERVED_LIMIT      EQU (P126_NGS_RESERVED_PAGE+P126_NGS_RESERVED_PAGES)*P126_NGS_PAGE_SIZE

; Compile-time allocation integrity.
        ASSERT P126_NGS_PAGE_COUNT = #100
        ASSERT P126_NGS_KERNEL_PAGE = 0
        ASSERT P126_NGS_KERNEL_PAGE+P126_NGS_KERNEL_PAGES = P126_NGS_SYSBIOS_PAGE
        ASSERT P126_NGS_SYSBIOS_PAGE+P126_NGS_SYSBIOS_PAGES = P126_NGS_VGABIOS_PAGE
        ASSERT P126_NGS_VGABIOS_PAGE+P126_NGS_VGABIOS_PAGES = P126_NGS_VRAM_PAGE
        ASSERT P126_NGS_VRAM_PAGE+P126_NGS_VRAM_PAGES = P126_NGS_FRAME_PAGE
        ASSERT P126_NGS_FRAME_PAGE+P126_NGS_FRAME_PAGES = P126_NGS_DMA_PAGE
        ASSERT P126_NGS_DMA_PAGE+P126_NGS_DMA_PAGES = P126_NGS_IPC_PAGE
        ASSERT P126_NGS_IPC_PAGE+P126_NGS_IPC_PAGES = P126_NGS_GUEST_RAM_PAGE
        ASSERT P126_NGS_GUEST_RAM_PAGE+P126_NGS_GUEST_RAM_PAGES = P126_NGS_RESERVED_PAGE
        ASSERT P126_NGS_RESERVED_PAGE+P126_NGS_RESERVED_PAGES = P126_NGS_PAGE_COUNT
        ASSERT P126_NGS_KERNEL_PAGES*P126_NGS_PAGE_SIZE <= #40000
        ASSERT P126_NGS_SYSBIOS_PAGES*P126_NGS_PAGE_SIZE = #40000
        ASSERT P126_NGS_VRAM_PAGES*P126_NGS_PAGE_SIZE = #40000
        ASSERT P126_NGS_FRAME_PAGES*P126_NGS_PAGE_SIZE = #8000
        ASSERT P126_NGS_DMA_PAGES*P126_NGS_PAGE_SIZE = #4000
        ASSERT P126_NGS_GUEST_RAM_PAGES*P126_NGS_PAGE_SIZE = #100000
        ASSERT P126_NGS_BANK_WINDOW_INDEX = 3
        ASSERT P126_NGS_BANK_WINDOW_BASE = #C000
        ASSERT P126_NGS_BANK_WINDOW_PORT = #10
        ASSERT P126_NGS_GUEST_RAM_PAGE_BASE = #44
        ASSERT P126_NGS_GUEST_VRAM_PAGE_BIAS = #08
        ASSERT P126_NGS_GUEST_VGABIOS_PAGE_BIAS = #F0
        ASSERT P126_NGS_GUEST_SYSBIOS_PAGE_BIAS = #D1
        ASSERT P126_NGS_RESERVED_LIMIT = P126_NGS_RAM_SIZE
