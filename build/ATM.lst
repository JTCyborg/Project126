 69+  003E CB 7F                bit     P126_DBIT, a
 70+  0040 20 0A                jr      nz, .p126_dbit_set_ready
 71+  0042 0B                   dec     bc
 72+  0043 78                   ld      a, b
 73+  0044 B1                   or      c
