 17++ 0000              P126_M_CBIT         EQU #01
 18++ 0000              P126_M_DBIT         EQU #80
 19++ 0000
 20++ 0000              P126_GS_RESET       EQU #80
 21++ 0000              P126_GS_NMI         EQU #40
 22++ 0000              P126_GS_LED         EQU #20
 23++ 0000
 24++ 0000              ; Driver result convention:
 25++ 0000              ;   Carry clear = operation completed.
 26++ 0000              ;   Carry set   = timeout.
 27++ 0000              ;   A           = last observed GSSTAT on timeout / final status on wait.
 28++ 0000              ;   p126_ipc_last_status always contains the last sampled GSSTAT byte.
 29++ 0000
 30++ 0000              ; Public entry points (see docs/ATM_HOST_INTERFACE.md):
 31++ 0000              ;   p126_ipc_read_status
 32++ 0000              ;   p126_ipc_wait_cbit_clear
 33++ 0000              ;   p126_ipc_wait_dbit_clear
 34++ 0000              ;   p126_ipc_wait_dbit_set
 35++ 0000              ;   p126_ipc_send_command       A=command
 36++ 0000              ;   p126_ipc_send_argument      A=argument; preloads GSDAT before GSCOM
 37++ 0000              ;   p126_ipc_send_byte          A=data; waits for consumption
 38++ 0000              ;   p126_ipc_receive_byte       returns A=data
 39++ 0000              ;   p126_ipc_emit_version
 40++ 0000
 41++ 0000              P126_IPC_TIMEOUT    EQU #FFFF
