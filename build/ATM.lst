 83+  0051              ; -------------------------------------------------------------------------
 84+  0051              ; Send one command through GSCOM.
 85+  0051              ; IN : A=command.
 86+  0051              ; OUT: Carry clear after NeoGS clears CBIT; carry set on timeout.
 87+  0051              ; -------------------------------------------------------------------------
 88+  0051              p126_ipc_send_command:
 88+  0051
 89+  0051 32 DC 00             ld      (p126_ipc_tx_byte), a
 90+  0054 3A DC 00             ld      a, (p126_ipc_tx_byte)
 91+  0057 D3 BB                out     (P126_GSCOM), a
 92+  0059 C3 06 00             jp      p126_ipc_wait_cbit_clear
 93+  005C
 94+  005C              ; -------------------------------------------------------------------------
 95+  005C              ; Preload one data byte before issuing a command.
 96+  005C              ; This ordering is required by the stock GS105a #13/#14 command ABI.
 97+  005C              ; IN : A=argument.
 98+  005C              ; OUT: Carry clear after GSDAT write; carry set if the data slot is busy.
 99+  005C              ; -------------------------------------------------------------------------
100+  005C              p126_ipc_send_argument:
100+  005C
101+  005C 32 DC 00             ld      (p126_ipc_tx_byte), a
102+  005F CD 1F 00             call    p126_ipc_wait_dbit_clear
103+  0062 D8                   ret     c
104+  0063 3A DC 00             ld      a, (p126_ipc_tx_byte)
105+  0066 D3 B3                out     (P126_GSDAT), a
106+  0068 B7                   or      a
107+  0069 C9                   ret
108+  006A
109+  006A              ; -------------------------------------------------------------------------
110+  006A              ; Send a data byte and wait until NeoGS consumes it (DBIT clears).
111+  006A              ; IN : A=data.
112+  006A              ; OUT: Carry clear on consumption; carry set on timeout.
113+  006A              ; -------------------------------------------------------------------------
114+  006A              p126_ipc_send_byte:
114+  006A
115+  006A 32 DC 00             ld      (p126_ipc_tx_byte), a
116+  006D CD 1F 00             call    p126_ipc_wait_dbit_clear
117+  0070 D8                   ret     c
118+  0071 3A DC 00             ld      a, (p126_ipc_tx_byte)
119+  0074 D3 B3                out     (P126_GSDAT), a
120+  0076 C3 1F 00             jp      p126_ipc_wait_dbit_clear
121+  0079
122+  0079              ; -------------------------------------------------------------------------
123+  0079              ; Receive one byte published by NeoGS.
124+  0079              ; OUT: A=data; carry clear. Carry set on timeout.
125+  0079              ; Reading GSDAT acknowledges the byte and clears DBIT in the host view.
126+  0079              ; -------------------------------------------------------------------------
127+  0079              p126_ipc_receive_byte:
127+  0079
128+  0079 CD 38 00             call    p126_ipc_wait_dbit_set
129+  007C D8                   ret     c
130+  007D DB B3                in      a, (P126_GSDAT)
131+  007F 32 DD 00             ld      (p126_ipc_rx_byte), a
132+  0082 B7                   or      a
133+  0083 C9                   ret
134+  0084
135+  0084              ; -------------------------------------------------------------------------
136+  0084              ; CRC-16/CCITT-FALSE byte update for the shared P126 DMA/IPC frame ABI.
137+  0084              ; IN : HL=current CRC, A=next byte.
138+  0084              ; OUT: HL=updated CRC. BC and DE are preserved.
139+  0084              ; The caller initializes HL to #FFFF and processes header[0..15]
140+  0084              ; followed by exactly payload_length bytes.
141+  0084              ; -------------------------------------------------------------------------
142+  0084              p126_ipc_crc16_update:
142+  0084
143+  0084 C5                   push    bc
144+  0085 AC                   xor     h
145+  0086 67                   ld      h, a
146+  0087 06 08                ld      b, 8
147+  0089              .p126_crc_bit:
148+  0089 29                   add     hl, hl
149+  008A 30 08                jr      nc, .p126_crc_no_xor
150+  008C 7C                   ld      a, h
151+  008D EE 10                xor     #10
152+  008F 67                   ld      h, a
153+  0090 7D                   ld      a, l
154+  0091 EE 21                xor     #21
155+  0093 6F                   ld      l, a
156+  0094              .p126_crc_no_xor:
157+  0094 10 F3                djnz    .p126_crc_bit
158+  0096 C1                   pop     bc
159+  0097 C9                   ret
160+  0098
161+  0098              ; Standard CRC-16/CCITT-FALSE regression vector.
162+  0098              ; OUT: Carry clear and HL=#29B1 on pass; Carry set on failure.
163+  0098              p126_ipc_crc16_selftest:
163+  0098
164+  0098 C5                   push    bc
165+  0099 D5                   push    de
166+  009A 21 FF FF             ld      hl, #FFFF
167+  009D 11 BC 00             ld      de, p126_ipc_crc16_test_vector
168+  00A0 06 09                ld      b, 9
169+  00A2              .p126_crc_test_loop:
170+  00A2 1A                   ld      a, (de)
171+  00A3 13                   inc     de
172+  00A4 CD 84 00             call    p126_ipc_crc16_update
173+  00A7 10 F9                djnz    .p126_crc_test_loop
174+  00A9 11 B1 29             ld      de, #29B1
175+  00AC B7                   or      a
176+  00AD ED 52                sbc     hl, de
177+  00AF 20 07                jr      nz, .p126_crc_test_failed
178+  00B1 D1                   pop     de
179+  00B2 C1                   pop     bc
180+  00B3 21 B1 29             ld      hl, #29B1
181+  00B6 B7                   or      a
182+  00B7 C9                   ret
183+  00B8              .p126_crc_test_failed:
184+  00B8 D1                   pop     de
185+  00B9 C1                   pop     bc
186+  00BA 37                   scf
187+  00BB C9                   ret
188+  00BC
189+  00BC              p126_ipc_crc16_test_vector:
190+  00BC 31 32 33 34          db "123456789"
