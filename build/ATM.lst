 15+  0000              ; -------------------------------------------------------------------------
 16+  0000              ; Read the current hardware handshake state.
 17+  0000              ; OUT: A=status; p126_ipc_last_status updated.
 18+  0000              ; -------------------------------------------------------------------------
 19+  0000              p126_ipc_read_status:
 19+  0000
 20+  0000 DB BB                in      a, (P126_GSSTAT)
 21+  0002 32 DB 00             ld      (p126_ipc_last_status), a
 22+  0005 C9                   ret
 23+  0006
 24+  0006              ; -------------------------------------------------------------------------
 25+  0006              ; Wait routines. Every wait is bounded by P126_IPC_TIMEOUT.
 26+  0006              ; OUT: Carry clear on requested state; carry set on timeout.
 27+  0006              ;      A=last sampled GSSTAT. BC is clobbered.
 28+  0006              ; -------------------------------------------------------------------------
 29+  0006              p126_ipc_wait_cbit_clear:
 29+  0006
 30+  0006 01 FF FF             ld      bc, P126_IPC_TIMEOUT
 31+  0009              .p126_cbit_loop:
 32+  0009 CD 00 00             call    p126_ipc_read_status
 33+  000C CB 47                bit     P126_CBIT, a
 34+  000E 28 0A                jr      z, .p126_cbit_ready
 35+  0010 0B                   dec     bc
 36+  0011 78                   ld      a, b
 37+  0012 B1                   or      c
 38+  0013 20 F4                jr      nz, .p126_cbit_loop
 39+  0015 3A DB 00             ld      a, (p126_ipc_last_status)
 40+  0018 37                   scf
 41+  0019 C9                   ret
 42+  001A              .p126_cbit_ready:
 43+  001A 3A DB 00             ld      a, (p126_ipc_last_status)
 44+  001D B7                   or      a
 45+  001E C9                   ret
 46+  001F
 47+  001F              p126_ipc_wait_dbit_clear:
 47+  001F
 48+  001F 01 FF FF             ld      bc, P126_IPC_TIMEOUT
 49+  0022              .p126_dbit_clear_loop:
 50+  0022 CD 00 00             call    p126_ipc_read_status
 51+  0025 CB 7F                bit     P126_DBIT, a
 52+  0027 28 0A                jr      z, .p126_dbit_clear_ready
 53+  0029 0B                   dec     bc
 54+  002A 78                   ld      a, b
 55+  002B B1                   or      c
