 94+  005C              ; -------------------------------------------------------------------------
 95+  005C              ; Preload one data byte before issuing a command.
 96+  005C              ; This ordering is required by the stock GS105a #13/#14 command ABI.
 97+  005C              ; IN : A=argument.
 98+  005C              ; OUT: Carry clear after GSDAT write; carry set if the data slot is busy.
 99+  005C              ; -------------------------------------------------------------------------
100+  005C              p126_ipc_send_argument:
100+  005C
101+  005C 32 9B 00             ld      (p126_ipc_tx_byte), a
102+  005F CD 1F 00             call    p126_ipc_wait_dbit_clear
103+  0062 D8                   ret     c
104+  0063 3A 9B 00             ld      a, (p126_ipc_tx_byte)
105+  0066 D3 B3                out     (P126_GSDAT), a
106+  0068 B7                   or      a
107+  0069 C9                   ret
108+  006A
109+  006A              ; -------------------------------------------------------------------------
110+  006A              ; Send a data byte and wait until NeoGS consumes it (DBIT clears).
111+  006A              ; IN : A=data.
112+  006A              ; OUT: Carry clear on consumption; carry set on timeout.
113+  006A              ; -------------------------------------------------------------------------
114+  006A              p126_ipc_send_byte:
114+  006A
115+  006A 32 9B 00             ld      (p126_ipc_tx_byte), a
116+  006D CD 1F 00             call    p126_ipc_wait_dbit_clear
117+  0070 D8                   ret     c
118+  0071 3A 9B 00             ld      a, (p126_ipc_tx_byte)
119+  0074 D3 B3                out     (P126_GSDAT), a
120+  0076 C3 1F 00             jp      p126_ipc_wait_dbit_clear
121+  0079
122+  0079              ; -------------------------------------------------------------------------
123+  0079              ; Receive one byte published by NeoGS.
124+  0079              ; OUT: A=data; carry clear. Carry set on timeout.
125+  0079              ; Reading GSDAT acknowledges the byte and clears DBIT in the host view.
126+  0079              ; -------------------------------------------------------------------------
127+  0079              p126_ipc_receive_byte:
127+  0079
128+  0079 CD 38 00             call    p126_ipc_wait_dbit_set
129+  007C D8                   ret     c
130+  007D DB B3                in      a, (P126_GSDAT)
131+  007F 32 9C 00             ld      (p126_ipc_rx_byte), a
132+  0082 B7                   or      a
133+  0083 C9                   ret
134+  0084
135+  0084              ; -------------------------------------------------------------------------
136+  0084              ; Emit a build/runtime identity to ATM's independent debug port #EF.
137+  0084              ; Preserves AF, BC and HL.
138+  0084              ; -------------------------------------------------------------------------
139+  0084              p126_ipc_emit_version:
139+  0084
140+  0084 F5                   push    af
141+  0085 C5                   push    bc
142+  0086 E5                   push    hl
143+  0087 21 9D 00             ld      hl, p126_ipc_version_text
144+  008A 01 EF 00             ld      bc, #00EF
145+  008D              .p126_version_loop:
146+  008D 7E                   ld      a, (hl)
147+  008E 23                   inc     hl
148+  008F B7                   or      a
149+  0090 28 04                jr      z, .p126_version_done
150+  0092 ED 79                out     (c), a
151+  0094 18 F7                jr      .p126_version_loop
152+  0096              .p126_version_done:
153+  0096 E1                   pop     hl
154+  0097 C1                   pop     bc
155+  0098 F1                   pop     af
156+  0099 C9                   ret
157+  009A
