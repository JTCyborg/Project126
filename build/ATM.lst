161+  00A2              ; CRC-16/CCITT-FALSE byte update for the shared P126 DMA/IPC frame ABI.
162+  00A2              ; IN : HL=current CRC, A=next byte.
163+  00A2              ; OUT: HL=updated CRC. BC and DE are preserved.
164+  00A2              ; The caller initializes HL to #FFFF and processes header[0..15]
165+  00A2              ; followed by exactly payload_length bytes.
166+  00A2              ; -------------------------------------------------------------------------
167+  00A2              p126_ipc_crc16_update:
167+  00A2
