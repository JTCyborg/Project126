 36+  0011 78                   ld      a, b
 37+  0012 B1                   or      c
 38+  0013 20 F4                jr      nz, .p126_cbit_loop
 39+  0015 3A 9A 00             ld      a, (p126_ipc_last_status)
 40+  0018 37                   scf
