216+  00EF C2 DD 01             jp      nz,.p126_frame_version
217+  00F2 DD 7E 05             ld      a,(ix+5)
218+  00F5 FE 00                cp      P126_IPC_MINOR
219+  00F7 C2 DD 01             jp      nz,.p126_frame_version
220+  00FA DD 7E 06             ld      a,(ix+6)
