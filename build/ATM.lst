  11  0ADC              p126_atm_ipc_module_end:
  12  0ADC
  13  0ADC              ; The standalone IPC audit unit does not link the ATM screen-console module.
  14  0ADC              ; Provide audit-only renderer state/entry points so the IPC translation unit
  15  0ADC              ; can be assembled independently. The production ATM application links the
  16  0ADC              ; real definitions from p126_screen_console.asm.
  17  0ADC              p126_atm_video_mode:
  18  0ADC 06                   db P126_ATM_VIDEO_MODE_RG6_TEXT80X25
  19  0ADD
  20  0ADD              p126_screen_apply_text_frame:
  21  0ADD AF                   xor     a
  22  0ADE C9                   ret
  23  0ADF
  24  0ADF              ; The IPC audit unit has no linked host-main state. The production build
  25  0ADF              ; resolves this flag from project126_main.asm after console initialization.
  26  0ADF              p126_host_console_ready:
  27  0ADF 00                   db 0
  28  0AE0
  29  0AE0              BIOS_DebugConsole_PrintChar:
  30  0AE0 C9                   ret
  31  0AE1
  32  0AE1                  DISPLAY "P126_ATM_IPC_START=", /H, p126_atm_ipc_module_start
  33  0AE1                  DISPLAY "P126_ATM_IPC_END=", /H, p126_atm_ipc_module_end
  34  0AE1                  DISPLAY "P126_ATM_IPC_SIZE=", /D, p126_atm_ipc_module_end-p126_atm_ipc_module_start
  35  0AE1
  36  0AE1                  ASSERT p126_atm_ipc_module_end > p126_atm_ipc_module_start
  37  0AE1                  ASSERT p126_atm_ipc_module_end <= #10000
  38  0AE1
