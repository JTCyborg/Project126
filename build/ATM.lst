117+  0077 C3 06 00             jp      p126_ipc_wait_cbit_clear
118+  007A
119+  007A              ; -------------------------------------------------------------------------
120+  007A              ; Preload one data byte before issuing a command.
121+  007A              ; This ordering is required by the stock GS105a #13/#14 command ABI.
122+  007A              ; IN : A=argument.
123+  007A              ; OUT: Carry clear after GSDAT write; carry set if the data slot is busy.
124+  007A              ; -------------------------------------------------------------------------
125+  007A              p126_ipc_send_argument:
125+  007A
126+  007A 32 B8 02             ld      (p126_ipc_tx_byte), a
127+  007D CD 1F 00             call    p126_ipc_wait_dbit_clear
128+  0080 D8                   ret     c
129+  0081 3A B8 02             ld      a, (p126_ipc_tx_byte)
130+  0084 D3 B3                out     (P126_GSDAT), a
131+  0086 B7                   or      a
132+  0087 C9                   ret
133+  0088
134+  0088              ; -------------------------------------------------------------------------
135+  0088              ; Send a data byte and wait until NeoGS consumes it (DBIT clears).
136+  0088              ; IN : A=data.
137+  0088              ; OUT: Carry clear on consumption; carry set on timeout.
138+  0088              ; -------------------------------------------------------------------------
139+  0088              p126_ipc_send_byte:
139+  0088
140+  0088 32 B8 02             ld      (p126_ipc_tx_byte), a
141+  008B CD 1F 00             call    p126_ipc_wait_dbit_clear
142+  008E D8                   ret     c
143+  008F 3A B8 02             ld      a, (p126_ipc_tx_byte)
144+  0092 D3 B3                out     (P126_GSDAT), a
145+  0094 C3 1F 00             jp      p126_ipc_wait_dbit_clear
