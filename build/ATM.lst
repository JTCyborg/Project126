 36++ 0000              ;   p126_ipc_send_command       A=command
 37++ 0000              ;   p126_ipc_send_argument      A=argument; preloads GSDAT before GSCOM
 38++ 0000              ;   p126_ipc_send_byte          A=data; waits for consumption
 39++ 0000              ;   p126_ipc_receive_byte       returns A=data
 40++ 0000              ;   p126_ipc_emit_version
 41++ 0000              ; ABI 1.0 constants are imported from shared/p126_ipc_protocol.inc.
