176+  00AB EE 10                xor     #10
177+  00AD 67                   ld      h, a
178+  00AE 7D                   ld      a, l
179+  00AF EE 21                xor     #21
180+  00B1 6F                   ld      l, a
181+  00B2              .p126_crc_no_xor:
182+  00B2 10 F3                djnz    .p126_crc_bit
