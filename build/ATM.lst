169+  00A3 AC                   xor     h
170+  00A4 67                   ld      h, a
171+  00A5 06 08                ld      b, 8
172+  00A7              .p126_crc_bit:
173+  00A7 29                   add     hl, hl
174+  00A8 30 08                jr      nc, .p126_crc_no_xor
175+  00AA 7C                   ld      a, h
176+  00AB EE 10                xor     #10
177+  00AD 67                   ld      h, a
178+  00AE 7D                   ld      a, l
179+  00AF EE 21                xor     #21
180+  00B1 6F                   ld      l, a
181+  00B2              .p126_crc_no_xor:
