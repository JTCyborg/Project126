 13+  0000                      INCLUDE "atm_host/neogs_ipc.inc"
# file opened: neogs_ipc.inc
  1++ 0000              ; =========================================================================
  2++ 0000              ; PROJECT126 — ATM / NeoGS IPC public interface
  3++ 0000              ; Version: P126_ATM_IPC_API v0.1.0
  4++ 0000              ;
  5++ 0000              ; Include this file in ATM-side Z80 modules that call neogs_ipc.asm.
  6++ 0000              ; Physical transport: GSCOM/GSSTAT (#BB), GSDAT (#B3), GSCTR (#33).
  7++ 0000              ; The ATM-side driver never accesses NeoGS-local DMA registers.
  8++ 0000              ; =========================================================================
  9++ 0000
 10++ 0000              P126_GSCOM          EQU #BB
