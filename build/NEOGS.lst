 234+ 1DFB              ; -------------------------------------------------------------------------
 235+ 1DFB              ; Resident module registry for dynamically placed overlays.
 236+ 1DFB              ; IDs 1..4 are pinned (X86IO/X86ALU/X86DEV/X86EXEC). IDs 5..15 may own
 237+ 1DFB              ; one allocator page in 08h..0Fh. The registry stores physical page numbers;
 238+ 1DFB              ; call dispatch derives the WIN2 selector only at the point of use.
 239+ 1DFB              ;
 240+ 1DFB              ; p126_overlay_register_dynamic: IN A=module ID (5..15), B=physical page (08..0F).
 241+ 1DFB              ; p126_overlay_unregister_dynamic: IN A=module ID (5..15).
 242+ 1DFB              ; p126_overlay_call_module: IN A=loaded module ID, IX=entry in 8000h..BFFFh.
 243+ 1DFB              ; -------------------------------------------------------------------------
 244+ 1DFB              p126_overlay_register_dynamic:
 245+ 1DFB FE 05                cp      5
 246+ 1DFD 38 48                jr      c,.module_register_range_error
 247+ 1DFF FE 10                cp      16
 248+ 1E01 30 44                jr      nc,.module_register_range_error
 249+ 1E03 32 28 21             ld      (p126_overlay_manager_id),a
