 173+ 31B2                      ; Production page-42 validation. WIN3 is selected through MPAGEX (#10),
 174+ 31B2                      ; exactly as in Project125. MPAGEX expects the physical page number
 175+ 31B2                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
 176+ 31B2                      ; Resident stack/code remain in WIN0-WIN2.
 177+ 31B2 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
 178+ 31B4 0F                   rrca
 179+ 31B5 D3 10                out     (P126_NGS_MPAGEX_PORT),a
