  67+ 0000              P126_NGS_VRAM_BASE           EQU P126_NGS_VRAM_PAGE*P126_NGS_PAGE_SIZE
  68+ 0000              P126_NGS_VRAM_LIMIT          EQU (P126_NGS_VRAM_PAGE+P126_NGS_VRAM_PAGES)*P126_NGS_PAGE_SIZE
