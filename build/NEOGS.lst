   2+ 3C7D              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 3C7D              ;
   4+ 3C7D              ; API:
   5+ 3C7D              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 3C7D              ;   IX = entry address in 8000h-BFFFh
   7+ 3C7D              ;   CALL p126_overlay_call
   8+ 3C7D              ;
   9+ 3C7D              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 3C7D              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 3C7D              ; restores the previous selector before returning to the original caller.
  12+ 3C7D              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 3C7D              ;
  14+ 3C7D              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 3C7D              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 3C7D              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 3C7D              ; =========================================================================
