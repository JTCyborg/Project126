# file opened: p126_x86_machine_map.inc
  1+  0000              ; PROJECT126 guest Intel 8086 memory and ATM-PC/XT-hybrid profile v0.1
  2+  0000              ; Guest physical addresses are 20-bit, byte-addressed, 00000h..FFFFFh.
  3+  0000              ; This is the guest-visible map; do not confuse it with NeoGS physical RAM.
  4+  0000
  5+  0000              P126_X86_ADDRESS_SPACE_SIZE     EQU #100000
  6+  0000              P126_X86_ADDRESS_SPACE_MASK     EQU #0FFFFF
  7+  0000              P126_X86_RAM_BACKING_SIZE       EQU #100000
  8+  0000
  9+  0000              ; Guest memory regions: half-open ranges [BASE, BASE+SIZE).
 10+  0000              P126_X86_RAM_LOW_BASE           EQU #00000
 11+  0000              P126_X86_RAM_LOW_SIZE           EQU #A0000
 12+  0000              P126_X86_VGA_APERTURE_BASE      EQU #A0000
 13+  0000              P126_X86_VGA_APERTURE_SIZE      EQU #20000
 14+  0000              P126_X86_VGABIOS_BASE           EQU #C0000
 15+  0000              P126_X86_VGABIOS_SIZE           EQU #08000
 16+  0000              P126_X86_RAM_HIGH_BASE          EQU #C8000
 17+  0000              P126_X86_RAM_HIGH_SIZE          EQU #36000
 18+  0000              P126_X86_SYSBIOS_BASE           EQU #FE000
 19+  0000              P126_X86_SYSBIOS_SIZE           EQU #02000
 20+  0000
 21+  0000              ; Read/write classifier return values.
 22+  0000              P126_X86_MEM_RAM_LOW            EQU 0
 23+  0000              P126_X86_MEM_VGA_APERTURE       EQU 1
 24+  0000              P126_X86_MEM_VGABIOS            EQU 2
 25+  0000              P126_X86_MEM_RAM_HIGH           EQU 3
 26+  0000              P126_X86_MEM_SYSBIOS            EQU 4
 27+  0000
 28+  0000              ; BIOS image policy. Physical image storage is in the separate 256 KiB
 29+  0000              ; NeoGS BIOS slot. Initial XT-compatible ROM images are 8 KiB and map here.
 30+  0000              P126_X86_SYSBIOS_MAX_IMAGE      EQU #40000
 31+  0000              P126_X86_SYSBIOS_BOOT_IMAGE     EQU #02000
 32+  0000
 33+  0000              ; ATM-PC/XT hybrid I/O decode assignments. Device implementations are
 34+  0000              ; software models on NeoGS; no physical NeoGS IN/OUT is permitted.
 35+  0000              P126_X86_IO_DMA_BASE            EQU #0000
 36+  0000              P126_X86_IO_DMA_SIZE            EQU #0010
 37+  0000              P126_X86_IO_PIC_BASE            EQU #0020
 38+  0000              P126_X86_IO_PIC_SIZE            EQU #0002
 39+  0000              P126_X86_IO_PIT_BASE            EQU #0040
 40+  0000              P126_X86_IO_PIT_SIZE            EQU #0004
 41+  0000              P126_X86_IO_PPI_BASE            EQU #0060
 42+  0000              P126_X86_IO_PPI_SIZE            EQU #0004
 43+  0000              P126_X86_IO_RTC_BASE            EQU #0070
 44+  0000              P126_X86_IO_RTC_SIZE            EQU #0002
 45+  0000              P126_X86_IO_DMA_PAGE_BASE       EQU #0080
 46+  0000              P126_X86_IO_DMA_PAGE_SIZE       EQU #0004
 47+  0000              P126_X86_IO_IDE_BASE            EQU #01F0
 48+  0000              P126_X86_IO_IDE_SIZE            EQU #0008
 49+  0000              P126_X86_IO_VGA_MONO_BASE       EQU #03B0
 50+  0000              P126_X86_IO_VGA_COLOR_BASE      EQU #03D0
 51+  0000              P126_X86_IO_VGA_SIZE            EQU #0030
 52+  0000              P126_X86_IO_FDC_BASE            EQU #03F0
 53+  0000              P126_X86_IO_FDC_SIZE            EQU #0006
 54+  0000              P126_X86_IO_FDC_DIR             EQU #03F7
 55+  0000              P126_X86_IO_IDE_CTRL            EQU #03F6
 56+  0000
