  52+ 0000              P126_NGS_BANK_WINDOW_BASE         EQU #C000
  53+ 0000              P126_NGS_BANK_WINDOW_PORT         EQU #10
  54+ 0000              P126_NGS_GUEST_RAM_PAGE_BASE      EQU P126_NGS_GUEST_RAM_PAGE
  55+ 0000
  56+ 0000              ; Guest memory backend page-bias constants for the WIN3 selector.
  57+ 0000              ; page = (guest_high_nibble*4)+(guest_middle>>6)+bias.
  58+ 0000              P126_NGS_GUEST_VRAM_PAGE_BIAS       EQU #08
