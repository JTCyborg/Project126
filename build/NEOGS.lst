  1+  0000              ; PROJECT126 NeoGS physical RAM allocation, revision 0.1
  2+  0000              ; 4 MiB physical RAM, divided into 256 pages of 16 KiB.
  3+  0000              ; Physical allocation only: not the Z80 logical 64 KiB window map.
  4+  0000
  5+  0000              P126_NGS_PAGE_SHIFT          EQU 14
  6+  0000              P126_NGS_PAGE_SIZE           EQU #4000
  7+  0000              P126_NGS_RAM_SIZE            EQU #400000
  8+  0000              P126_NGS_PAGE_COUNT          EQU P126_NGS_RAM_SIZE/P126_NGS_PAGE_SIZE
  9+  0000
 10+  0000              ; Half-open page ranges [START, START+COUNT).
 11+  0000              P126_NGS_KERNEL_PAGE         EQU #00
 12+  0000              P126_NGS_KERNEL_PAGES        EQU #10
 13+  0000              P126_NGS_SYSBIOS_PAGE        EQU #10
 14+  0000              P126_NGS_SYSBIOS_PAGES       EQU #10
 15+  0000              P126_NGS_VGABIOS_PAGE        EQU #20
 16+  0000              P126_NGS_VGABIOS_PAGES       EQU #10
 17+  0000              P126_NGS_VRAM_PAGE           EQU #30
 18+  0000              P126_NGS_VRAM_PAGES          EQU #10
 19+  0000              P126_NGS_FRAME_PAGE          EQU #40
 20+  0000              P126_NGS_FRAME_PAGES         EQU 2
 21+  0000              P126_NGS_DMA_PAGE            EQU #42
 22+  0000              P126_NGS_DMA_PAGES           EQU 1
 23+  0000              P126_NGS_IPC_PAGE            EQU #43
 24+  0000              P126_NGS_IPC_PAGES           EQU 1
 25+  0000              P126_NGS_GUEST_RAM_PAGE      EQU #44
 26+  0000              P126_NGS_GUEST_RAM_PAGES     EQU #40
 27+  0000              P126_NGS_RESERVED_PAGE       EQU #84
 28+  0000              P126_NGS_RESERVED_PAGES      EQU #7C
 29+  0000
 30+  0000              ; Project126 resident execution contract, revision 0.2:
 31+  0000              ; WIN0..WIN2 are reserved for resident code/data/stack.
 32+  0000              ; WIN3 (C000-FFFF) is the dedicated banked physical-RAM aperture.
 33+  0000              ; x86 memory helpers select WIN3 through MPAGEX port 10h. The physical page
 34+  0000              ; number is encoded with RRCA before OUT; port 23h is PG3, not MPAGEX.
 35+  0000              ; Callers and interrupt handlers must not place code/stack in WIN3.
 36+  0000              P126_NGS_BANK_WINDOW_INDEX     EQU 3
 37+  0000              P126_NGS_BANK_WINDOW_BASE      EQU #C000
 38+  0000              P126_NGS_BANK_WINDOW_PORT      EQU #10
 39+  0000              P126_NGS_GUEST_RAM_PAGE_BASE   EQU P126_NGS_GUEST_RAM_PAGE
 40+  0000
 41+  0000              ; Guest memory backend page-bias constants for the WIN3 selector.
 42+  0000              ; page = (guest_high_nibble*4)+(guest_middle>>6)+bias.
 43+  0000              P126_NGS_GUEST_VRAM_PAGE_BIAS       EQU #08
 44+  0000              P126_NGS_GUEST_VGABIOS_PAGE_BIAS    EQU #F0
 45+  0000              P126_NGS_GUEST_SYSBIOS_PAGE_BIAS    EQU #D1
 46+  0000
 47+  0000              ; Physical byte offsets.
 48+  0000              P126_NGS_KERNEL_BASE         EQU P126_NGS_KERNEL_PAGE*P126_NGS_PAGE_SIZE
 49+  0000              P126_NGS_KERNEL_LIMIT        EQU (P126_NGS_KERNEL_PAGE+P126_NGS_KERNEL_PAGES)*P126_NGS_PAGE_SIZE
 50+  0000              P126_NGS_SYSBIOS_BASE        EQU P126_NGS_SYSBIOS_PAGE*P126_NGS_PAGE_SIZE
 51+  0000              P126_NGS_SYSBIOS_LIMIT       EQU (P126_NGS_SYSBIOS_PAGE+P126_NGS_SYSBIOS_PAGES)*P126_NGS_PAGE_SIZE
 52+  0000              P126_NGS_VGABIOS_BASE        EQU P126_NGS_VGABIOS_PAGE*P126_NGS_PAGE_SIZE
 53+  0000              P126_NGS_VGABIOS_LIMIT       EQU (P126_NGS_VGABIOS_PAGE+P126_NGS_VGABIOS_PAGES)*P126_NGS_PAGE_SIZE
 54+  0000              P126_NGS_VRAM_BASE           EQU P126_NGS_VRAM_PAGE*P126_NGS_PAGE_SIZE
 55+  0000              P126_NGS_VRAM_LIMIT          EQU (P126_NGS_VRAM_PAGE+P126_NGS_VRAM_PAGES)*P126_NGS_PAGE_SIZE
 56+  0000              P126_NGS_FRAME_BASE          EQU P126_NGS_FRAME_PAGE*P126_NGS_PAGE_SIZE
 57+  0000              P126_NGS_FRAME_LIMIT         EQU (P126_NGS_FRAME_PAGE+P126_NGS_FRAME_PAGES)*P126_NGS_PAGE_SIZE
 58+  0000              P126_NGS_DMA_BASE            EQU P126_NGS_DMA_PAGE*P126_NGS_PAGE_SIZE
 59+  0000              P126_NGS_DMA_LIMIT           EQU (P126_NGS_DMA_PAGE+P126_NGS_DMA_PAGES)*P126_NGS_PAGE_SIZE
 60+  0000              P126_NGS_IPC_BASE            EQU P126_NGS_IPC_PAGE*P126_NGS_PAGE_SIZE
 61+  0000              P126_NGS_IPC_LIMIT           EQU (P126_NGS_IPC_PAGE+P126_NGS_IPC_PAGES)*P126_NGS_PAGE_SIZE
 62+  0000              P126_NGS_GUEST_RAM_BASE      EQU P126_NGS_GUEST_RAM_PAGE*P126_NGS_PAGE_SIZE
 63+  0000              P126_NGS_GUEST_RAM_LIMIT     EQU (P126_NGS_GUEST_RAM_PAGE+P126_NGS_GUEST_RAM_PAGES)*P126_NGS_PAGE_SIZE
