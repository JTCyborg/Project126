 112  00A0              .check_bios_ready:
 113  00A0                      ; CPU execution calls X86IO/page04, which delegates DMA/PIT ports to
 114  00A0                      ; X86DEV/page06 through the resident nested overlay gate. BIOS waits
 115  00A0                      ; until all three overlay images have passed installation checks.
 116  00A0 3A 26 1B             ld      a,(p126_ngs_io_overlay_ready)
 117  00A3 B7                   or      a
 118  00A4 28 EC                jr      z,p126_ngs_resident_main_loop
 119  00A6 3A 27 1B             ld      a,(p126_ngs_alu_overlay_ready)
 120  00A9 B7                   or      a
 121  00AA 28 E6                jr      z,p126_ngs_resident_main_loop
 122  00AC 3A 28 1B             ld      a,(p126_ngs_dev_overlay_ready)
 123  00AF B7                   or      a
 124  00B0 28 E0                jr      z,p126_ngs_resident_main_loop
 125  00B2 3A 29 1B             ld      a,(p126_ngs_exec_overlay_ready)
 126  00B5 B7                   or      a
