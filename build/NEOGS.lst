215+  024D              ; -------------------------------------------------------------------------
216+  024D              ; Unified guest memory interface
217+  024D              ;
218+  024D              ; Guest physical address is classified before selecting its physical backing:
219+  024D              ;   00000-9FFFF / C8000-FDFFF : guest RAM, pages 44h-83h
220+  024D              ;   A0000-BFFFF               : linear VGA aperture backing, pages 30h-37h
221+  024D              ;   C0000-C7FFF               : VGA BIOS slot, pages 20h-21h
222+  024D              ;   FE000-FFFFF               : system BIOS slot, page 10h (8 KiB image)
223+  024D              ;
224+  024D              ; The VGA aperture backend is deliberately a byte-linear staging layer over
225+  024D              ; the first 128 KiB of the 256 KiB VRAM allocation. It is NOT yet IBM VGA
226+  024D              ; plane/latch/read-mode/write-mode emulation. VGA register semantics are a
227+  024D              ; separate implementation stage.
228+  024D              ;
229+  024D              ; All backing is reached through WIN3. A is the page bias for the address
230+  024D              ; formula: page = (guest_high_nibble*4)+(guest_middle>>6)+bias.
231+  024D              ; -------------------------------------------------------------------------
