  33  0000              ; =========================================================================
  34  0000              ; Project126 resident Z80 entry. Stage-0 copies this image to physical page
  35  0000              ; 00. WIN1/page 03 owns the resident stack; WIN2 is the overlay aperture;
  36  0000              ; WIN3 is the dedicated guest-memory aperture.
  37  0000              ; =========================================================================
  38  0000              p126_ngs_resident_entry_vector:
  39  0000 C3 08 00             jp      p126_ngs_resident_start
  40  0003 00 00 00...          BLOCK   5,0
  41  0008
  42  0008              p126_ngs_resident_start:
  43  0008 F3                   di
  44  0009 DB 0F                in      a,(#0F)
  45  000B E6 CF                and     #CF
  46  000D F6 29                or      #29                    ; 20 MHz + NOROM + EXPAG
  47  000F D3 0F                out     (#0F),a
  48  0011 AF                   xor     a
  49  0012 01 20 00             ld      bc,#0020
  50  0015 ED 79                out     (c),a                  ; WIN0 -> physical page 00
  51  0017 3E 03                ld      a,3
  52  0019 01 21 00             ld      bc,#0021
  53  001C ED 79                out     (c),a                  ; WIN1 -> physical page 03
  54  001E 3E 80                ld      a,#80
  55  0020 D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a ; WIN2 placeholder -> page 01
  56  0022 32 70 22             ld      (p126_overlay_current_selector),a
  57  0025 3E 01                ld      a,#01
  58  0027 D3 10                out     (#10),a                ; WIN3 -> physical page 02 until banked
  59  0029 31 FE 7F             ld      sp,#7FFE
  60  002C AF                   xor     a
  61  002D 32 6F 22             ld      (p126_overlay_call_depth),a
  62  0030 21 76 22             ld      hl,p126_overlay_call_pages
  63  0033 11 77 22             ld      de,p126_overlay_call_pages+1
  64  0036 01 07 00             ld      bc,P126_OVERLAY_MAX_CALL_DEPTH-1
  65  0039 77                   ld      (hl),a
  66  003A ED B0                ldir
  67  003C 21 90 22             ld      hl,p126_overlay_alloc_state
  68  003F 11 91 22             ld      de,p126_overlay_alloc_state+1
  69  0042 01 08 00             ld      bc,8
  70  0045 77                   ld      (hl),a
  71  0046 ED B0                ldir
  72  0048 3E 01                ld      a,1                      ; page07 is pinned to X86EXEC
  73  004A 32 90 22             ld      (p126_overlay_alloc_state),a
  74  004D CD 0A 1F             call    p126_overlay_allocator_selftest
  75  0050 38 08                jr      c,.p126_allocator_selftest_failed
  76  0052 21 5F 01             ld      hl,p126_ngs_resident_allocator_ok
  77  0055 CD F0 00             call    p126_ngs_resident_log
  78  0058 18 09                jr      .p126_allocator_selftest_done
  79  005A              .p126_allocator_selftest_failed:
  80  005A 21 7E 01             ld      hl,p126_ngs_resident_allocator_bad
  81  005D CD F0 00             call    p126_ngs_resident_log
  82  0060 C3 EB 00             jp      p126_ngs_resident_halt
  83  0063              .p126_allocator_selftest_done:
  84  0063 CD 04 20             call    p126_overlay_manager_selftest
  85  0066 DA 71 00             jp      c,.p126_module_manager_selftest_failed
  86  0069 21 9D 01             ld      hl,p126_ngs_resident_module_manager_ok
  87  006C CD F0 00             call    p126_ngs_resident_log
  88  006F 18 09                jr      .p126_module_manager_selftest_done
  89  0071              .p126_module_manager_selftest_failed:
  90  0071 21 B9 01             ld      hl,p126_ngs_resident_module_manager_bad
  91  0074 CD F0 00             call    p126_ngs_resident_log
  92  0077 C3 EB 00             jp      p126_ngs_resident_halt
  93  007A              .p126_module_manager_selftest_done:
  94  007A
  95  007A 21 2B 01             ld      hl,p126_ngs_resident_banner
  96  007D CD F0 00             call    p126_ngs_resident_log
  97  0080 CD 2E 1C             call    p126_ngs_ipc_crc16_selftest
  98  0083 38 57                jr      c,p126_ngs_resident_crc_fail
  99  0085 21 48 01             ld      hl,p126_ngs_resident_crc_ok
 100  0088 CD F0 00             call    p126_ngs_resident_log
 101  008B 3E A2                ld      a,#A2
 102  008D CD 01 01             call    p126_ngs_resident_send_boot_ack
 103  0090 38 53                jr      c,p126_ngs_resident_ack_fail
