125   0095 28 07                jr      z,.p126_ngs_resident_ack_free
126   0097 0B                   dec     bc
127   0098 78                   ld      a,b
128   0099 B1                   or      c
129   009A 20 F5                jr      nz,.p126_ngs_resident_ack_wait_free
130   009C 37                   scf
131   009D C9                   ret
132   009E              .p126_ngs_resident_ack_free:
133   009E 3A 52 01             ld      a,(p126_ngs_resident_tx)
134   00A1 D3 03                out     (#03),a
135   00A3 01 FF FF             ld      bc,#FFFF
