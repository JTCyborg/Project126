 148+ 3238              ; -------------------------------------------------------------------------
 149+ 3238              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 3238              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 3238              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 3238              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 3238              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 3238              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 3238              ; -------------------------------------------------------------------------
 156+ 3238              P126_NGS_DMA_MOD      EQU #1B
 157+ 3238              P126_NGS_DMA_HAD      EQU #1C
 158+ 3238              P126_NGS_DMA_MAD      EQU #1D
 159+ 3238              P126_NGS_DMA_LAD      EQU #1E
 160+ 3238              P126_NGS_DMA_CST      EQU #1F
 161+ 3238              P126_NGS_ZXSTAT       EQU #04
 162+ 3238              P126_NGS_CLRCBIT      EQU #05
 163+ 3238              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 3238              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 3238              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 3238              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 3238              ; until frame validation or reverse-transfer completion.
 168+ 3238              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 3238              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 3238              P126_NGS_DMA_WAIT_OUTER EQU 8
 171+ 3238
 172+ 3238              p126_ngs_ipc_dma_receive_frame:
 172+ 3238
 173+ 3238                      ; Production page-42 validation. WIN3 is selected through MPAGEX (#10),
 174+ 3238                      ; exactly as in Project125. MPAGEX expects the physical page number
 175+ 3238                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
 176+ 3238                      ; Resident stack/code remain in WIN0-WIN2.
 177+ 3238 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
 178+ 323A 0F                   rrca
 179+ 323B D3 10                out     (P126_NGS_MPAGEX_PORT),a
 180+ 323D 21 2F 3B             ld      hl,p126_ngs_ipc_log_dma_page42_premapped
