 237  20D8              ; Resident bank-call gate and compatibility entry points for X86IO and X86ALU.
 238  20D8                      INCLUDE "neogs_sub/p126_overlay_gate.asm"
# file opened: p126_overlay_gate.asm
   1+ 20D8              ; =========================================================================
   2+ 20D8              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 20D8              ;
   4+ 20D8              ; API:
   5+ 20D8              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 20D8              ;   IX = entry address in 8000h-BFFFh
   7+ 20D8              ;   CALL p126_overlay_call
   8+ 20D8              ;
   9+ 20D8              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 20D8              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 20D8              ; restores the previous selector before returning to the original caller.
  12+ 20D8              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 20D8              ;
  14+ 20D8              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 20D8              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 20D8              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 20D8              ; =========================================================================
  18+ 20D8
  19+ 20D8              P126_OVERLAY_MAX_CALL_DEPTH EQU 8
  20+ 20D8
  21+ 20D8              p126_overlay_call:
  22+ 20D8 DD 22 D2 25          ld      (p126_overlay_gate_entry),ix
  23+ 20DC 22 D4 25             ld      (p126_overlay_gate_saved_hl),hl
  24+ 20DF 08                   ex      af,af'                   ; keep caller AF while using A
  25+ 20E0 3A CF 25             ld      a,(p126_overlay_call_depth)
  26+ 20E3 FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 20E5 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 20E7 3C                   inc     a
  29+ 20E8 32 CF 25             ld      (p126_overlay_call_depth),a
  30+ 20EB                      ; Record the requested page for active-page release protection.
  31+ 20EB D5                   push    de
  32+ 20EC DD 21 D6 25          ld      ix,p126_overlay_call_pages
  33+ 20F0 3D                   dec     a
  34+ 20F1 5F                   ld      e,a
  35+ 20F2 16 00                ld      d,0
  36+ 20F4 DD 19                add     ix,de
  37+ 20F6 3A D1 25             ld      a,(p126_overlay_request_selector)
  38+ 20F9 DD 77 00             ld      (ix+0),a
  39+ 20FC D1                   pop     de
  40+ 20FD 3A D0 25             ld      a,(p126_overlay_current_selector)
  41+ 2100 F5                   push    af                       ; per-call previous-selector frame
  42+ 2101 3A D1 25             ld      a,(p126_overlay_request_selector)
  43+ 2104 32 D0 25             ld      (p126_overlay_current_selector),a
  44+ 2107 D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  45+ 2109 21 17 21             ld      hl,p126_overlay_gate_return
  46+ 210C E5                   push    hl                       ; overlay RET enters resident WIN0
  47+ 210D DD 2A D2 25          ld      ix,(p126_overlay_gate_entry)
  48+ 2111 2A D4 25             ld      hl,(p126_overlay_gate_saved_hl)
  49+ 2114 08                   ex      af,af'                   ; restore caller AF for module
  50+ 2115 DD E9                jp      (ix)
  51+ 2117
  52+ 2117              p126_overlay_gate_return:
  53+ 2117 08                   ex      af,af'                   ; preserve module return AF
  54+ 2118 F1                   pop     af                       ; restore previous WIN2 selector
  55+ 2119 32 D0 25             ld      (p126_overlay_current_selector),a
  56+ 211C D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  57+ 211E                      ; Clear this active-page slot before decrementing the frame depth.
  58+ 211E D5                   push    de
  59+ 211F 3A CF 25             ld      a,(p126_overlay_call_depth)
  60+ 2122 3D                   dec     a
  61+ 2123 5F                   ld      e,a
  62+ 2124 16 00                ld      d,0
  63+ 2126 DD 21 D6 25          ld      ix,p126_overlay_call_pages
