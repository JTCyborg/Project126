 237  1DE9              ; Resident bank-call gate and compatibility entry points for X86IO and X86ALU.
 238  1DE9                      INCLUDE "neogs_sub/p126_overlay_gate.asm"
# file opened: p126_overlay_gate.asm
   1+ 1DE9              ; =========================================================================
   2+ 1DE9              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 1DE9              ;
   4+ 1DE9              ; API:
   5+ 1DE9              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 1DE9              ;   IX = entry address in 8000h-BFFFh
   7+ 1DE9              ;   CALL p126_overlay_call
   8+ 1DE9              ;
   9+ 1DE9              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 1DE9              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 1DE9              ; restores the previous selector before returning to the original caller.
  12+ 1DE9              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 1DE9              ;
  14+ 1DE9              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 1DE9              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 1DE9              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 1DE9              ; =========================================================================
  18+ 1DE9
  19+ 1DE9              P126_OVERLAY_MAX_CALL_DEPTH EQU 8
  20+ 1DE9
  21+ 1DE9              p126_overlay_call:
  22+ 1DE9 DD 22 1B 22          ld      (p126_overlay_gate_entry),ix
  23+ 1DED 22 1D 22             ld      (p126_overlay_gate_saved_hl),hl
  24+ 1DF0 08                   ex      af,af'                   ; keep caller AF while using A
  25+ 1DF1 3A 18 22             ld      a,(p126_overlay_call_depth)
  26+ 1DF4 FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 1DF6 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 1DF8 3C                   inc     a
  29+ 1DF9 32 18 22             ld      (p126_overlay_call_depth),a
  30+ 1DFC                      ; Record the requested page for active-page release protection.
  31+ 1DFC D5                   push    de
  32+ 1DFD DD 21 1F 22          ld      ix,p126_overlay_call_pages
  33+ 1E01 3D                   dec     a
  34+ 1E02 5F                   ld      e,a
  35+ 1E03 16 00                ld      d,0
  36+ 1E05 DD 19                add     ix,de
  37+ 1E07 3A 1A 22             ld      a,(p126_overlay_request_selector)
  38+ 1E0A DD 77 00             ld      (ix+0),a
  39+ 1E0D D1                   pop     de
  40+ 1E0E 3A 19 22             ld      a,(p126_overlay_current_selector)
  41+ 1E11 F5                   push    af                       ; per-call previous-selector frame
  42+ 1E12 3A 1A 22             ld      a,(p126_overlay_request_selector)
  43+ 1E15 32 19 22             ld      (p126_overlay_current_selector),a
  44+ 1E18 D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  45+ 1E1A 21 28 1E             ld      hl,p126_overlay_gate_return
  46+ 1E1D E5                   push    hl                       ; overlay RET enters resident WIN0
  47+ 1E1E DD 2A 1B 22          ld      ix,(p126_overlay_gate_entry)
  48+ 1E22 2A 1D 22             ld      hl,(p126_overlay_gate_saved_hl)
  49+ 1E25 08                   ex      af,af'                   ; restore caller AF for module
  50+ 1E26 DD E9                jp      (ix)
  51+ 1E28
  52+ 1E28              p126_overlay_gate_return:
  53+ 1E28 08                   ex      af,af'                   ; preserve module return AF
  54+ 1E29 F1                   pop     af                       ; restore previous WIN2 selector
  55+ 1E2A 32 19 22             ld      (p126_overlay_current_selector),a
  56+ 1E2D D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  57+ 1E2F                      ; Clear this active-page slot before decrementing the frame depth.
  58+ 1E2F D5                   push    de
  59+ 1E30 3A 18 22             ld      a,(p126_overlay_call_depth)
  60+ 1E33 3D                   dec     a
  61+ 1E34 5F                   ld      e,a
  62+ 1E35 16 00                ld      d,0
  63+ 1E37 DD 21 1F 22          ld      ix,p126_overlay_call_pages
  64+ 1E3B DD 19                add     ix,de
  65+ 1E3D AF                   xor     a
  66+ 1E3E DD 77 00             ld      (ix+0),a
  67+ 1E41 D1                   pop     de
  68+ 1E42 3A 18 22             ld      a,(p126_overlay_call_depth)
  69+ 1E45 3D                   dec     a
  70+ 1E46 32 18 22             ld      (p126_overlay_call_depth),a
  71+ 1E49 08                   ex      af,af'                   ; restore module return AF
  72+ 1E4A C9                   ret
