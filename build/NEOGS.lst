 237  23A3              ; Resident bank-call gate and compatibility entry points for X86IO and X86ALU.
 238  23A3                      INCLUDE "neogs_sub/p126_overlay_gate.asm"
# file opened: p126_overlay_gate.asm
   1+ 23A3              ; =========================================================================
   2+ 23A3              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 23A3              ;
   4+ 23A3              ; API:
   5+ 23A3              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 23A3              ;   IX = entry address in 8000h-BFFFh
   7+ 23A3              ;   CALL p126_overlay_call
   8+ 23A3              ;
   9+ 23A3              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 23A3              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 23A3              ; restores the previous selector before returning to the original caller.
  12+ 23A3              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 23A3              ;
  14+ 23A3              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 23A3              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 23A3              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 23A3              ; =========================================================================
  18+ 23A3
  19+ 23A3              P126_OVERLAY_MAX_CALL_DEPTH EQU 8
  20+ 23A3
  21+ 23A3              p126_overlay_call:
  22+ 23A3 DD 22 9D 28          ld      (p126_overlay_gate_entry),ix
  23+ 23A7 22 9F 28             ld      (p126_overlay_gate_saved_hl),hl
  24+ 23AA 08                   ex      af,af'                   ; keep caller AF while using A
  25+ 23AB 3A 9A 28             ld      a,(p126_overlay_call_depth)
  26+ 23AE FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 23B0 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 23B2 3C                   inc     a
  29+ 23B3 32 9A 28             ld      (p126_overlay_call_depth),a
  30+ 23B6                      ; Record the requested page for active-page release protection.
  31+ 23B6 D5                   push    de
  32+ 23B7 DD 21 A1 28          ld      ix,p126_overlay_call_pages
  33+ 23BB 3D                   dec     a
  34+ 23BC 5F                   ld      e,a
  35+ 23BD 16 00                ld      d,0
  36+ 23BF DD 19                add     ix,de
  37+ 23C1 3A 9C 28             ld      a,(p126_overlay_request_selector)
  38+ 23C4 DD 77 00             ld      (ix+0),a
  39+ 23C7 D1                   pop     de
  40+ 23C8 3A 9B 28             ld      a,(p126_overlay_current_selector)
  41+ 23CB F5                   push    af                       ; per-call previous-selector frame
  42+ 23CC 3A 9C 28             ld      a,(p126_overlay_request_selector)
  43+ 23CF 32 9B 28             ld      (p126_overlay_current_selector),a
  44+ 23D2 D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  45+ 23D4 21 E2 23             ld      hl,p126_overlay_gate_return
