 183+ 1594 CD 83 23             call    p126_ngs_ipc_log
 184+ 1597
 185+ 1597                      ; Physical page 42h base = 108000h: HAD=10h, MAD=80h, LAD=00h.
 186+ 1597 3E 01                ld      a,1
 187+ 1599 D3 1B                out     (P126_NGS_DMA_MOD),a
 188+ 159B 3E 10                ld      a,#10
 189+ 159D D3 1C                out     (P126_NGS_DMA_HAD),a
