 148+ 321C              ; -------------------------------------------------------------------------
 149+ 321C              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 321C              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 321C              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 321C              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 321C              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 321C              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 321C              ; -------------------------------------------------------------------------
 156+ 321C              P126_NGS_DMA_MOD      EQU #1B
 157+ 321C              P126_NGS_DMA_HAD      EQU #1C
 158+ 321C              P126_NGS_DMA_MAD      EQU #1D
 159+ 321C              P126_NGS_DMA_LAD      EQU #1E
 160+ 321C              P126_NGS_DMA_CST      EQU #1F
 161+ 321C              P126_NGS_ZXSTAT       EQU #04
 162+ 321C              P126_NGS_CLRCBIT      EQU #05
 163+ 321C              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 321C              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 321C              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 321C              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 321C              ; until frame validation or reverse-transfer completion.
 168+ 321C              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 321C              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 321C              P126_NGS_DMA_WAIT_OUTER EQU 8
 171+ 321C
 172+ 321C              p126_ngs_ipc_dma_receive_frame:
 172+ 321C
 173+ 321C                      ; Production page-42 validation. WIN3 is selected through MPAGEX (#10),
 174+ 321C                      ; exactly as in Project125. MPAGEX expects the physical page number
 175+ 321C                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
 176+ 321C                      ; Resident stack/code remain in WIN0-WIN2.
 177+ 321C 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
 178+ 321E 0F                   rrca
 179+ 321F D3 10                out     (P126_NGS_MPAGEX_PORT),a
 180+ 3221 21 1C 3B             ld      hl,p126_ngs_ipc_log_dma_page42_premapped
 181+ 3224 CD 66 3C             call    p126_ngs_ipc_log
