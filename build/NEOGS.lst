 32   0000              ; =========================================================================
 33   0000              ; Project126 resident Z80 entry. Stage-0 copies this image to physical page
 34   0000              ; 00. WIN1/page 03 owns the resident stack; WIN3 is the banked aperture.
 35   0000              ; =========================================================================
 36   0000              p126_ngs_resident_entry_vector:
 37   0000 C3 08 00             jp      p126_ngs_resident_start
 38   0003 00 00 00...          BLOCK   5,0
 39   0008
 40   0008              p126_ngs_resident_start:
 41   0008 F3                   di
 42   0009 DB 0F                in      a,(#0F)
 43   000B E6 CF                and     #CF
 44   000D F6 29                or      #29                    ; 20 MHz + NOROM + EXPAG
 45   000F D3 0F                out     (#0F),a
 46   0011 AF                   xor     a
 47   0012 01 20 00             ld      bc,#0020
 48   0015 ED 79                out     (c),a                  ; WIN0 -> physical page 00
 49   0017 3E 03                ld      a,3
 50   0019 01 21 00             ld      bc,#0021
 51   001C ED 79                out     (c),a                  ; WIN1 -> physical page 03
 52   001E 3E 80                ld      a,#80
 53   0020 D3 00                out     (#00),a                ; WIN2 -> physical page 01
 54   0022 3E 01                ld      a,#01
 55   0024 D3 10                out     (#10),a                ; WIN3 -> physical page 02 until banked
 56   0026 31 FE 7F             ld      sp,#7FFE
 57   0029
 58   0029 21 B5 00             ld      hl,p126_ngs_resident_banner
 59   002C CD 7A 00             call    p126_ngs_resident_log
 60   002F CD 4F 0E             call    p126_ngs_ipc_crc16_selftest
 61   0032 38 34                jr      c,p126_ngs_resident_crc_fail
 62   0034 21 D2 00             ld      hl,p126_ngs_resident_crc_ok
 63   0037 CD 7A 00             call    p126_ngs_resident_log
 64   003A 3E A2                ld      a,#A2
 65   003C CD 8B 00             call    p126_ngs_resident_send_boot_ack
 66   003F 38 2F                jr      c,p126_ngs_resident_ack_fail
 67   0041
 68   0041              p126_ngs_resident_main_loop:
 69   0041 CD B2 0B             call    p126_ngs_ipc_dispatch_once
 70   0044 38 18                jr      c,p126_ngs_resident_frame_error
 71   0046 B7                   or      a
 72   0047 28 06                jr      z,.check_bios_ready
 73   0049 21 1F 01             ld      hl,p126_ngs_resident_frame_ok
 74   004C CD 7A 00             call    p126_ngs_resident_log
 75   004F              .check_bios_ready:
 76   004F 3A 56 0D             ld      a,(p126_ngs_bios_image_ready)
 77   0052 B7                   or      a
 78   0053 28 EC                jr      z,p126_ngs_resident_main_loop
 79   0055                      ; Consume the installation event before probing: one-shot transition.
 80   0055 AF                   xor     a
 81   0056 32 56 0D             ld      (p126_ngs_bios_image_ready),a
 82   0059 CD 91 01             call    x86_bios_reset_vector_probe
 83   005C 18 E3                jr      p126_ngs_resident_main_loop
 84   005E
 85   005E              p126_ngs_resident_frame_error:
 86   005E F5                   push    af
 87   005F 21 37 01             ld      hl,p126_ngs_resident_frame_bad
 88   0062 CD 7A 00             call    p126_ngs_resident_log
 89   0065 F1                   pop     af
 90   0066 18 D9                jr      p126_ngs_resident_main_loop
 91   0068              p126_ngs_resident_crc_fail:
 92   0068 21 E9 00             ld      hl,p126_ngs_resident_crc_bad
 93   006B CD 7A 00             call    p126_ngs_resident_log
 94   006E 18 06                jr      p126_ngs_resident_halt
 95   0070              p126_ngs_resident_ack_fail:
 96   0070 21 00 01             ld      hl,p126_ngs_resident_ack_bad
 97   0073 CD 7A 00             call    p126_ngs_resident_log
 98   0076              p126_ngs_resident_halt:
 99   0076 F3                   di
100   0077 76                   halt
101   0078 18 FC                jr      p126_ngs_resident_halt
102   007A
103   007A              p126_ngs_resident_log:
104   007A F5                   push    af
105   007B C5                   push    bc
106   007C 01 EF 00             ld      bc,#00EF
107   007F              .p126_ngs_resident_log_loop:
108   007F 7E                   ld      a,(hl)
109   0080 23                   inc     hl
110   0081 B7                   or      a
111   0082 28 04                jr      z,.p126_ngs_resident_log_done
112   0084 ED 79                out     (c),a
113   0086 18 F7                jr      .p126_ngs_resident_log_loop
114   0088              .p126_ngs_resident_log_done:
115   0088 C1                   pop     bc
116   0089 F1                   pop     af
117   008A C9                   ret
118   008B
119   008B              p126_ngs_resident_send_boot_ack:
120   008B 32 52 01             ld      (p126_ngs_resident_tx),a
121   008E 01 FF FF             ld      bc,#FFFF
122   0091              .p126_ngs_resident_ack_wait_free:
