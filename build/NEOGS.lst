  82+ 1E5A              ; -------------------------------------------------------------------------
  83+ 1E5A              ; Physical overlay-page allocator.
  84+ 1E5A              ; Pool: physical pages 08h..0Fh. Pages 04h/05h/06h/07h are pinned to X86IO/X86ALU/X86DEV/X86EXEC;
  85+ 1E5A              ; pages 00h..03h are never allocator-owned. WIN3 is not used here.
  86+ 1E5A              ;
  87+ 1E5A              ; p126_overlay_allocate_page:
  88+ 1E5A              ;   OUT A=physical page 07h..0Fh, carry clear; A=0/carry set if exhausted.
  89+ 1E5A              ;   Clobbers BC, IX.
  90+ 1E5A              ;
  91+ 1E5A              ; p126_overlay_release_page:
  92+ 1E5A              ;   IN A=physical page. Carry clear on release; carry set with A=status on
  93+ 1E5A              ;   invalid, already-free, currently mapped, or actively executing page.
  94+ 1E5A              ;   Clobbers BC, DE, HL, IX.
  95+ 1E5A              ; -------------------------------------------------------------------------
  96+ 1E5A              p126_overlay_allocate_page:
  97+ 1E5A DD 21 41 22          ld      ix,p126_overlay_alloc_state+1
  98+ 1E5E 06 08                ld      b,8
  99+ 1E60 0E 08                ld      c,8
