  82+ 3D78              ; -------------------------------------------------------------------------
  83+ 3D78              ; Physical overlay-page allocator.
  84+ 3D78              ; Pool: physical pages 07h..0Fh. Pages 04h/05h/06h are pinned to X86IO/X86ALU/X86DEV;
  85+ 3D78              ; pages 00h..03h are never allocator-owned. WIN3 is not used here.
  86+ 3D78              ;
  87+ 3D78              ; p126_overlay_allocate_page:
  88+ 3D78              ;   OUT A=physical page 07h..0Fh, carry clear; A=0/carry set if exhausted.
  89+ 3D78              ;   Clobbers BC, IX.
  90+ 3D78              ;
  91+ 3D78              ; p126_overlay_release_page:
  92+ 3D78              ;   IN A=physical page. Carry clear on release; carry set with A=status on
  93+ 3D78              ;   invalid, already-free, currently mapped, or actively executing page.
  94+ 3D78              ;   Clobbers BC, DE, HL, IX.
  95+ 3D78              ; -------------------------------------------------------------------------
  96+ 3D78              p126_overlay_allocate_page:
  97+ 3D78 DD 21 66 40          ld      ix,p126_overlay_alloc_state
  98+ 3D7C 06 09                ld      b,9
  99+ 3D7E 0E 07                ld      c,7
