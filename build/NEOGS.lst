 148+ 321A              ; -------------------------------------------------------------------------
 149+ 321A              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 321A              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 321A              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 321A              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 321A              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 321A              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 321A              ; -------------------------------------------------------------------------
 156+ 321A              P126_NGS_DMA_MOD      EQU #1B
 157+ 321A              P126_NGS_DMA_HAD      EQU #1C
 158+ 321A              P126_NGS_DMA_MAD      EQU #1D
 159+ 321A              P126_NGS_DMA_LAD      EQU #1E
 160+ 321A              P126_NGS_DMA_CST      EQU #1F
 161+ 321A              P126_NGS_ZXSTAT       EQU #04
 162+ 321A              P126_NGS_CLRCBIT      EQU #05
 163+ 321A              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 321A              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 321A              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 321A              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 321A              ; until frame validation or reverse-transfer completion.
 168+ 321A              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 321A              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 321A              P126_NGS_DMA_WAIT_OUTER EQU 8
 171+ 321A
 172+ 321A              p126_ngs_ipc_dma_receive_frame:
 172+ 321A
 173+ 321A                      ; Production page-42 validation. WIN3 is selected through MPAGEX (#10),
 174+ 321A                      ; exactly as in Project125. MPAGEX expects the physical page number
 175+ 321A                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
 176+ 321A                      ; Resident stack/code remain in WIN0-WIN2.
 177+ 321A 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
 178+ 321C 0F                   rrca
 179+ 321D D3 10                out     (P126_NGS_MPAGEX_PORT),a
