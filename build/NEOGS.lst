 148+ 3562              ; -------------------------------------------------------------------------
 149+ 3562              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 3562              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 3562              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 3562              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 3562              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 3562              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 3562              ; -------------------------------------------------------------------------
 156+ 3562              P126_NGS_DMA_MOD      EQU #1B
 157+ 3562              P126_NGS_DMA_HAD      EQU #1C
 158+ 3562              P126_NGS_DMA_MAD      EQU #1D
 159+ 3562              P126_NGS_DMA_LAD      EQU #1E
 160+ 3562              P126_NGS_DMA_CST      EQU #1F
 161+ 3562              P126_NGS_ZXSTAT       EQU #04
 162+ 3562              P126_NGS_CLRCBIT      EQU #05
 163+ 3562              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 3562              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 3562              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 3562              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 3562              ; until frame validation or reverse-transfer completion.
 168+ 3562              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 3562              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 3562              P126_NGS_DMA_WAIT_OUTER EQU 8
