 219  8000              x86_io_module_start:
 220  8000                      INCLUDE "neogs_sub/x86_io.asm"
# file opened: x86_io.asm
   1+ 8000              ; PROJECT126 — virtual 8086 I/O port bus.
   2+ 8000              ; Guest I/O devices are software models on NeoGS. No guest port number is
   3+ 8000              ; ever issued as a physical NeoGS/Z80 I/O operation.
   4+ 8000              ;
   5+ 8000              ; Implemented:
   6+ 8000              ;   00E0h: retained 16-bit diagnostic test latch.
   7+ 8000              ;   0060h-0063h: initial XT-compatible 8255 PPI / keyboard interface.
   8+ 8000              ;   x86_io_keyboard_push_impl: host/IPC producer API for XT scan-code bytes.
   9+ 8000              ;
  10+ 8000              ; PPI compatibility slice:
  11+ 8000              ;   60h = port A / keyboard data (FIFO consumer when configured input).
  12+ 8000              ;   61h = port B / system control; bit-6 rising edge resets XT keyboard,
  13+ 8000              ;         bit 7 acknowledges/clears the current keyboard data latch.
  14+ 8000              ;   62h = port C input/output composition.
  15+ 8000              ;   63h = mode-set and bit-set/reset control register (mode 0 implemented).
  16+ 8000              ;   PPI reset defaults follow PCem/ppi.c: PA=00h, PB=40h.
  17+ 8000              ;
  18+ 8000              ; Keyboard bytes are queued here only. ATM input delivery and PIC IRQ1
  19+ 8000              ; signaling are separate services and are not claimed implemented yet.
  20+ 8000
  21+ 8000              x86_io_reset_impl:
  22+ 8000 21 00 00             ld      hl,0
  23+ 8003 22 2A 83             ld      (x86_io_count_in),hl
  24+ 8006 22 2C 83             ld      (x86_io_count_out),hl
  25+ 8009 22 05 83             ld      (x86_io_test_latch),hl
  26+ 800C AF                   xor     a
