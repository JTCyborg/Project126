  33  0000              ; =========================================================================
  34  0000              ; Project126 resident Z80 entry. Stage-0 copies this image to physical page
  35  0000              ; 00. WIN1/page 03 owns the resident stack; WIN2 is the overlay aperture;
  36  0000              ; WIN3 is the dedicated guest-memory aperture.
  37  0000              ; =========================================================================
  38  0000              p126_ngs_resident_entry_vector:
  39  0000 C3 08 00             jp      p126_ngs_resident_start
  40  0003 00 00 00...          BLOCK   5,0
  41  0008
  42  0008              p126_ngs_resident_start:
  43  0008 F3                   di
  44  0009 DB 0F                in      a,(#0F)
  45  000B E6 CF                and     #CF
  46  000D F6 29                or      #29                    ; 20 MHz + NOROM + EXPAG
  47  000F D3 0F                out     (#0F),a
  48  0011 AF                   xor     a
  49  0012 01 20 00             ld      bc,#0020
  50  0015 ED 79                out     (c),a                  ; WIN0 -> physical page 00
  51  0017 3E 03                ld      a,3
  52  0019 01 21 00             ld      bc,#0021
  53  001C ED 79                out     (c),a                  ; WIN1 -> physical page 03
  54  001E 3E 80                ld      a,#80
  55  0020 D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a ; WIN2 placeholder -> page 01
  56  0022 32 DE 3F             ld      (p126_overlay_current_selector),a
  57  0025 3E 01                ld      a,#01
  58  0027 D3 10                out     (#10),a                ; WIN3 -> physical page 02 until banked
  59  0029 31 FE 7F             ld      sp,#7FFE
  60  002C AF                   xor     a
  61  002D 32 DD 3F             ld      (p126_overlay_call_depth),a
  62  0030 21 E4 3F             ld      hl,p126_overlay_call_pages
  63  0033 11 E5 3F             ld      de,p126_overlay_call_pages+1
  64  0036 01 07 00             ld      bc,P126_OVERLAY_MAX_CALL_DEPTH-1
  65  0039 77                   ld      (hl),a
  66  003A ED B0                ldir
  67  003C 21 EC 3F             ld      hl,p126_overlay_alloc_state
  68  003F 11 ED 3F             ld      de,p126_overlay_alloc_state+1
  69  0042 01 08 00             ld      bc,8
  70  0045 77                   ld      (hl),a
  71  0046 ED B0                ldir
  72  0048 CD 47 3D             call    p126_overlay_allocator_selftest
  73  004B 38 08                jr      c,.p126_allocator_selftest_failed
  74  004D 21 3A 01             ld      hl,p126_ngs_resident_allocator_ok
  75  0050 CD CB 00             call    p126_ngs_resident_log
  76  0053 18 08                jr      .p126_allocator_selftest_done
  77  0055              .p126_allocator_selftest_failed:
  78  0055 21 59 01             ld      hl,p126_ngs_resident_allocator_bad
  79  0058 CD CB 00             call    p126_ngs_resident_log
  80  005B 18 6A                jr      p126_ngs_resident_halt
  81  005D              .p126_allocator_selftest_done:
  82  005D
  83  005D 21 06 01             ld      hl,p126_ngs_resident_banner
  84  0060 CD CB 00             call    p126_ngs_resident_log
  85  0063 CD 6B 3A             call    p126_ngs_ipc_crc16_selftest
  86  0066 38 51                jr      c,p126_ngs_resident_crc_fail
  87  0068 21 23 01             ld      hl,p126_ngs_resident_crc_ok
  88  006B CD CB 00             call    p126_ngs_resident_log
  89  006E 3E A2                ld      a,#A2
  90  0070 CD DC 00             call    p126_ngs_resident_send_boot_ack
  91  0073 38 4C                jr      c,p126_ngs_resident_ack_fail
  92  0075
  93  0075              p126_ngs_resident_main_loop:
  94  0075 CD 47 34             call    p126_ngs_ipc_dispatch_once
  95  0078 38 35                jr      c,p126_ngs_resident_frame_error
  96  007A B7                   or      a
  97  007B 28 06                jr      z,.check_bios_ready
  98  007D 21 AE 01             ld      hl,p126_ngs_resident_frame_ok
  99  0080 CD CB 00             call    p126_ngs_resident_log
 100  0083              .check_bios_ready:
 101  0083                      ; CPU execution calls X86IO/page04, which delegates DMA/PIT ports to
 102  0083                      ; X86DEV/page06 through the resident nested overlay gate. BIOS waits
 103  0083                      ; until all three overlay images have passed installation checks.
 104  0083 3A 41 39             ld      a,(p126_ngs_io_overlay_ready)
 105  0086 B7                   or      a
 106  0087 28 EC                jr      z,p126_ngs_resident_main_loop
 107  0089 3A 42 39             ld      a,(p126_ngs_alu_overlay_ready)
 108  008C B7                   or      a
 109  008D 28 E6                jr      z,p126_ngs_resident_main_loop
 110  008F 3A 43 39             ld      a,(p126_ngs_dev_overlay_ready)
 111  0092 B7                   or      a
 112  0093 28 E0                jr      z,p126_ngs_resident_main_loop
 113  0095 3A 40 39             ld      a,(p126_ngs_bios_image_ready)
 114  0098 B7                   or      a
 115  0099 28 09                jr      z,.check_bios_running
 116  009B                      ; Consume the installation event before the first bounded CPU slice.
 117  009B AF                   xor     a
 118  009C 32 40 39             ld      (p126_ngs_bios_image_ready),a
 119  009F CD 57 02             call    x86_bios_startup_trace
 120  00A2 18 D1                jr      p126_ngs_resident_main_loop
 121  00A4              .check_bios_running:
 122  00A4                      ; Return to IPC dispatch after every 64 guest instructions. Long BIOS
 123  00A4                      ; POST loops must never monopolize the NeoGS resident command loop.
 124  00A4 3A 50 07             ld      a,(x86_bios_trace_active)
 125  00A7 B7                   or      a
 126  00A8 28 CB                jr      z,p126_ngs_resident_main_loop
 127  00AA CD 57 02             call    x86_bios_startup_trace
 128  00AD 18 C6                jr      p126_ngs_resident_main_loop
 129  00AF
 130  00AF              p126_ngs_resident_frame_error:
 131  00AF F5                   push    af
 132  00B0 21 BC 01             ld      hl,p126_ngs_resident_frame_bad
 133  00B3 CD CB 00             call    p126_ngs_resident_log
 134  00B6 F1                   pop     af
 135  00B7 18 BC                jr      p126_ngs_resident_main_loop
