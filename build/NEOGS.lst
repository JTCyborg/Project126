   1+ 1CDA              ; =========================================================================
   2+ 1CDA              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 1CDA              ;
   4+ 1CDA              ; API:
   5+ 1CDA              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 1CDA              ;   IX = entry address in 8000h-BFFFh
   7+ 1CDA              ;   CALL p126_overlay_call
   8+ 1CDA              ;
   9+ 1CDA              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 1CDA              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 1CDA              ; restores the previous selector before returning to the original caller.
  12+ 1CDA              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 1CDA              ;
  14+ 1CDA              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 1CDA              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 1CDA              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 1CDA              ; =========================================================================
  18+ 1CDA
