 183+ 322A CD 66 3C             call    p126_ngs_ipc_log
 184+ 322D
 185+ 322D                      ; Physical page 42h base = 108000h: HAD=10h, MAD=80h, LAD=00h.
 186+ 322D 3E 01                ld      a,1
 187+ 322F D3 1B                out     (P126_NGS_DMA_MOD),a
 188+ 3231 3E 10                ld      a,#10
 189+ 3233 D3 1C                out     (P126_NGS_DMA_HAD),a
 190+ 3235 3E 80                ld      a,#80
 191+ 3237 D3 1D                out     (P126_NGS_DMA_MAD),a
