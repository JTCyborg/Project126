  34+ 3D27 5F                   ld      e,a
  35+ 3D28 16 00                ld      d,0
  36+ 3D2A DD 19                add     ix,de
  37+ 3D2C 3A 59 40             ld      a,(p126_overlay_request_selector)
  38+ 3D2F DD 77 00             ld      (ix+0),a
  39+ 3D32 D1                   pop     de
  40+ 3D33 3A 58 40             ld      a,(p126_overlay_current_selector)
  41+ 3D36 F5                   push    af                       ; per-call previous-selector frame
  42+ 3D37 3A 59 40             ld      a,(p126_overlay_request_selector)
  43+ 3D3A 32 58 40             ld      (p126_overlay_current_selector),a
  44+ 3D3D D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
