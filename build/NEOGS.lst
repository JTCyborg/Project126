 148+ 325F              ; -------------------------------------------------------------------------
 149+ 325F              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 325F              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 325F              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 325F              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 325F              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 325F              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 325F              ; -------------------------------------------------------------------------
 156+ 325F              P126_NGS_DMA_MOD      EQU #1B
 157+ 325F              P126_NGS_DMA_HAD      EQU #1C
 158+ 325F              P126_NGS_DMA_MAD      EQU #1D
 159+ 325F              P126_NGS_DMA_LAD      EQU #1E
 160+ 325F              P126_NGS_DMA_CST      EQU #1F
 161+ 325F              P126_NGS_ZXSTAT       EQU #04
 162+ 325F              P126_NGS_CLRCBIT      EQU #05
 163+ 325F              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 325F              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 325F              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 325F              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 325F              ; until frame validation or reverse-transfer completion.
 168+ 325F              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 325F              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 325F              P126_NGS_DMA_WAIT_OUTER EQU 8
 171+ 325F
 172+ 325F              p126_ngs_ipc_dma_receive_frame:
 172+ 325F
 173+ 325F                      ; Production page-42 validation. WIN3 is selected through MPAGEX (#10),
 174+ 325F                      ; exactly as in Project125. MPAGEX expects the physical page number
 175+ 325F                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
 176+ 325F                      ; Resident stack/code remain in WIN0-WIN2.
 177+ 325F 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
 178+ 3261 0F                   rrca
 179+ 3262 D3 10                out     (P126_NGS_MPAGEX_PORT),a
 180+ 3264 21 56 3B             ld      hl,p126_ngs_ipc_log_dma_page42_premapped
