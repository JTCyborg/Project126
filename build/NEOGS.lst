  32  0000              ; =========================================================================
  33  0000              ; Project126 resident Z80 entry. Stage-0 copies this image to physical page
  34  0000              ; 00. WIN1/page 03 owns the resident stack; WIN3 is the banked aperture.
  35  0000              ; =========================================================================
  36  0000              p126_ngs_resident_entry_vector:
  37  0000 C3 08 00             jp      p126_ngs_resident_start
  38  0003 00 00 00...          BLOCK   5,0
  39  0008
  40  0008              p126_ngs_resident_start:
  41  0008 F3                   di
  42  0009 DB 0F                in      a,(#0F)
  43  000B E6 CF                and     #CF
  44  000D F6 29                or      #29                    ; 20 MHz + NOROM + EXPAG
  45  000F D3 0F                out     (#0F),a
  46  0011 AF                   xor     a
  47  0012 01 20 00             ld      bc,#0020
  48  0015 ED 79                out     (c),a                  ; WIN0 -> physical page 00
  49  0017 3E 03                ld      a,3
  50  0019 01 21 00             ld      bc,#0021
  51  001C ED 79                out     (c),a                  ; WIN1 -> physical page 03
  52  001E 3E 80                ld      a,#80
  53  0020 D3 00                out     (#00),a                ; WIN2 -> physical page 01
  54  0022 3E 01                ld      a,#01
  55  0024 D3 10                out     (#10),a                ; WIN3 -> physical page 02 until banked
  56  0026 31 FE 7F             ld      sp,#7FFE
  57  0029
  58  0029 21 B8 00             ld      hl,p126_ngs_resident_banner
  59  002C CD 7D 00             call    p126_ngs_resident_log
  60  002F CD ED 33             call    p126_ngs_ipc_crc16_selftest
  61  0032 38 37                jr      c,p126_ngs_resident_crc_fail
  62  0034 21 D5 00             ld      hl,p126_ngs_resident_crc_ok
  63  0037 CD 7D 00             call    p126_ngs_resident_log
  64  003A 3E A2                ld      a,#A2
  65  003C CD 8E 00             call    p126_ngs_resident_send_boot_ack
  66  003F 38 32                jr      c,p126_ngs_resident_ack_fail
  67  0041
  68  0041              p126_ngs_resident_main_loop:
  69  0041 CD 50 31             call    p126_ngs_ipc_dispatch_once
  70  0044 38 1B                jr      c,p126_ngs_resident_frame_error
  71  0046 B7                   or      a
  72  0047 28 06                jr      z,.check_bios_ready
  73  0049 21 22 01             ld      hl,p126_ngs_resident_frame_ok
  74  004C CD 7D 00             call    p126_ngs_resident_log
  75  004F              .check_bios_ready:
  76  004F 3A F4 32             ld      a,(p126_ngs_bios_image_ready)
  77  0052 B7                   or      a
  78  0053 28 EC                jr      z,p126_ngs_resident_main_loop
  79  0055                      ; Consume the installation event before probing: one-shot transition.
  80  0055 AF                   xor     a
  81  0056 32 F4 32             ld      (p126_ngs_bios_image_ready),a
  82  0059                      ; CPU/BIOS execution remains deliberately gated until the complete
  83  0059                      ; PCem 8086 semantic port has been reviewed. Image installation is
  84  0059                      ; acknowledged, but no guest instruction is executed here.
  85  0059 21 55 01             ld      hl,p126_ngs_bios_exec_gated
  86  005C CD 7D 00             call    p126_ngs_resident_log
  87  005F 18 E0                jr      p126_ngs_resident_main_loop
  88  0061
  89  0061              p126_ngs_resident_frame_error:
  90  0061 F5                   push    af
  91  0062 21 3A 01             ld      hl,p126_ngs_resident_frame_bad
  92  0065 CD 7D 00             call    p126_ngs_resident_log
  93  0068 F1                   pop     af
  94  0069 18 D6                jr      p126_ngs_resident_main_loop
  95  006B              p126_ngs_resident_crc_fail:
