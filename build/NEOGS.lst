  74+ 1E4B              p126_overlay_depth_rejected:
  75+ 1E4B                      ; No selector change or stack frame is made on overflow.
  76+ 1E4B 2A 1D 22             ld      hl,(p126_overlay_gate_saved_hl)
  77+ 1E4E 08                   ex      af,af'                   ; restore the caller's alternate AF
