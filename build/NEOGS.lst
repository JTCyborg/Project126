 148+ 11EE              ; -------------------------------------------------------------------------
 149+ 11EE              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 11EE              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 11EE              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 11EE              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 11EE              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 11EE              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 11EE              ; -------------------------------------------------------------------------
 156+ 11EE              P126_NGS_DMA_MOD      EQU #1B
 157+ 11EE              P126_NGS_DMA_HAD      EQU #1C
 158+ 11EE              P126_NGS_DMA_MAD      EQU #1D
 159+ 11EE              P126_NGS_DMA_LAD      EQU #1E
 160+ 11EE              P126_NGS_DMA_CST      EQU #1F
 161+ 11EE              P126_NGS_ZXSTAT       EQU #04
 162+ 11EE              P126_NGS_CLRCBIT      EQU #05
 163+ 11EE              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 11EE              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 11EE              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 11EE              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 11EE              ; until frame validation or reverse-transfer completion.
 168+ 11EE              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 11EE              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 11EE              P126_NGS_DMA_WAIT_OUTER EQU 8
 171+ 11EE
 172+ 11EE              p126_ngs_ipc_dma_receive_frame:
 172+ 11EE
 173+ 11EE                      ; Production page-42 validation. WIN3 is selected through MPAGEX (#10),
 174+ 11EE                      ; exactly as in Project125. MPAGEX expects the physical page number
 175+ 11EE                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
 176+ 11EE                      ; Resident stack/code remain in WIN0-WIN2.
 177+ 11EE 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
