  55+ 0000              P126_NGS_X86VGA_OVERLAY_PAGE       EQU #08
  56+ 0000              P126_NGS_X86VID_MODULE_ID           EQU #06
  57+ 0000              P126_NGS_X86VID_OVERLAY_PAGE        EQU #09
  58+ 0000              P126_NGS_OVERLAY_TEST_PAGE        EQU P126_NGS_ALU_OVERLAY_PAGE
  59+ 0000              P126_NGS_BANK_WINDOW_INDEX        EQU 3
  60+ 0000              P126_NGS_BANK_WINDOW_BASE         EQU #C000
  61+ 0000              P126_NGS_BANK_WINDOW_PORT         EQU #10
  62+ 0000              P126_NGS_GUEST_RAM_PAGE_BASE      EQU P126_NGS_GUEST_RAM_PAGE
  63+ 0000
