 148+ 1586              ; -------------------------------------------------------------------------
 149+ 1586              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 1586              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 1586              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 1586              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 1586              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 1586              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 1586              ; -------------------------------------------------------------------------
 156+ 1586              P126_NGS_DMA_MOD      EQU #1B
 157+ 1586              P126_NGS_DMA_HAD      EQU #1C
 158+ 1586              P126_NGS_DMA_MAD      EQU #1D
 159+ 1586              P126_NGS_DMA_LAD      EQU #1E
 160+ 1586              P126_NGS_DMA_CST      EQU #1F
 161+ 1586              P126_NGS_ZXSTAT       EQU #04
 162+ 1586              P126_NGS_CLRCBIT      EQU #05
 163+ 1586              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 1586              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 1586              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 1586              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 1586              ; until frame validation or reverse-transfer completion.
 168+ 1586              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 1586              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 1586              P126_NGS_DMA_WAIT_OUTER EQU 8
 171+ 1586
 172+ 1586              p126_ngs_ipc_dma_receive_frame:
 172+ 1586
 173+ 1586                      ; Production page-42 validation. WIN3 is selected through MPAGEX (#10),
 174+ 1586                      ; exactly as in Project125. MPAGEX expects the physical page number
 175+ 1586                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
 176+ 1586                      ; Resident stack/code remain in WIN0-WIN2.
 177+ 1586 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
 178+ 1588 0F                   rrca
 179+ 1589 D3 10                out     (P126_NGS_MPAGEX_PORT),a
 180+ 158B 21 46 22             ld      hl,p126_ngs_ipc_log_dma_page42_premapped
