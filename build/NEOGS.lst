  54+ 1E80 F1                   pop     af                       ; restore previous WIN2 selector
  55+ 1E81 32 70 22             ld      (p126_overlay_current_selector),a
  56+ 1E84 D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
