# file opened: p126_overlay_gate.asm
   1+ 1DF0              ; =========================================================================
   2+ 1DF0              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 1DF0              ;
   4+ 1DF0              ; API:
   5+ 1DF0              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 1DF0              ;   IX = entry address in 8000h-BFFFh
   7+ 1DF0              ;   CALL p126_overlay_call
   8+ 1DF0              ;
   9+ 1DF0              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 1DF0              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 1DF0              ; restores the previous selector before returning to the original caller.
  12+ 1DF0              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 1DF0              ;
  14+ 1DF0              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 1DF0              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 1DF0              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 1DF0              ; =========================================================================
  18+ 1DF0
  19+ 1DF0              P126_OVERLAY_MAX_CALL_DEPTH EQU 8
  20+ 1DF0
  21+ 1DF0              p126_overlay_call:
  22+ 1DF0 DD 22 22 22          ld      (p126_overlay_gate_entry),ix
  23+ 1DF4 22 24 22             ld      (p126_overlay_gate_saved_hl),hl
  24+ 1DF7 08                   ex      af,af'                   ; keep caller AF while using A
  25+ 1DF8 3A 1F 22             ld      a,(p126_overlay_call_depth)
  26+ 1DFB FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 1DFD 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 1DFF 3C                   inc     a
  29+ 1E00 32 1F 22             ld      (p126_overlay_call_depth),a
  30+ 1E03                      ; Record the requested page for active-page release protection.
  31+ 1E03 D5                   push    de
  32+ 1E04 DD 21 26 22          ld      ix,p126_overlay_call_pages
  33+ 1E08 3D                   dec     a
  34+ 1E09 5F                   ld      e,a
  35+ 1E0A 16 00                ld      d,0
  36+ 1E0C DD 19                add     ix,de
  37+ 1E0E 3A 21 22             ld      a,(p126_overlay_request_selector)
  38+ 1E11 DD 77 00             ld      (ix+0),a
  39+ 1E14 D1                   pop     de
  40+ 1E15 3A 20 22             ld      a,(p126_overlay_current_selector)
  41+ 1E18 F5                   push    af                       ; per-call previous-selector frame
  42+ 1E19 3A 21 22             ld      a,(p126_overlay_request_selector)
  43+ 1E1C 32 20 22             ld      (p126_overlay_current_selector),a
  44+ 1E1F D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  45+ 1E21 21 2F 1E             ld      hl,p126_overlay_gate_return
  46+ 1E24 E5                   push    hl                       ; overlay RET enters resident WIN0
  47+ 1E25 DD 2A 22 22          ld      ix,(p126_overlay_gate_entry)
  48+ 1E29 2A 24 22             ld      hl,(p126_overlay_gate_saved_hl)
  49+ 1E2C 08                   ex      af,af'                   ; restore caller AF for module
  50+ 1E2D DD E9                jp      (ix)
