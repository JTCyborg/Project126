 28+  0000              P126_NGS_RESERVED_PAGES      EQU #7C
 29+  0000
 30+  0000              ; Project126 resident execution contract, revision 0.2:
 31+  0000              ; WIN0..WIN2 are reserved for resident code/data/stack.
 32+  0000              ; WIN3 (C000-FFFF) is the dedicated banked physical-RAM aperture.
 33+  0000              ; x86 memory helpers switch WIN3 by writing the physical page to port 23h.
 34+  0000              ; Callers and interrupt handlers must not place code/stack in WIN3.
 35+  0000              P126_NGS_BANK_WINDOW_INDEX     EQU 3
 36+  0000              P126_NGS_BANK_WINDOW_BASE      EQU #C000
 37+  0000              P126_NGS_BANK_WINDOW_PORT      EQU #23
 38+  0000              P126_NGS_GUEST_RAM_PAGE_BASE   EQU P126_NGS_GUEST_RAM_PAGE
 39+  0000
 40+  0000              ; Guest memory backend page-bias constants for the WIN3 selector.
 41+  0000              ; page = (guest_high_nibble*4)+(guest_middle>>6)+bias.
 42+  0000              P126_NGS_GUEST_VRAM_PAGE_BIAS       EQU #08
 43+  0000              P126_NGS_GUEST_VGABIOS_PAGE_BIAS    EQU #F0
 44+  0000              P126_NGS_GUEST_SYSBIOS_PAGE_BIAS    EQU #D1
 45+  0000
