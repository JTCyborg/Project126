  50+ 0000              P126_NGS_GUEST_RAM_PAGE_BASE      EQU P126_NGS_GUEST_RAM_PAGE
  51+ 0000
  52+ 0000              ; Guest memory backend page-bias constants for the WIN3 selector.
  53+ 0000              ; page = (guest_high_nibble*4)+(guest_middle>>6)+bias.
  54+ 0000              P126_NGS_GUEST_VRAM_PAGE_BIAS       EQU #08
  55+ 0000              P126_NGS_GUEST_VGABIOS_PAGE_BIAS    EQU #F0
  56+ 0000              P126_NGS_GUEST_SYSBIOS_PAGE_BIAS    EQU #D1
  57+ 0000
  58+ 0000              ; Physical byte offsets.
  59+ 0000              P126_NGS_KERNEL_BASE         EQU P126_NGS_KERNEL_PAGE*P126_NGS_PAGE_SIZE
  60+ 0000              P126_NGS_KERNEL_LIMIT        EQU (P126_NGS_KERNEL_PAGE+P126_NGS_KERNEL_PAGES)*P126_NGS_PAGE_SIZE
