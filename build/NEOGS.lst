  25+ 1CE2 3A 09 21             ld      a,(p126_overlay_call_depth)
  26+ 1CE5 FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 1CE7 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 1CE9 3C                   inc     a
  29+ 1CEA 32 09 21             ld      (p126_overlay_call_depth),a
