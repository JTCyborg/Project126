 237  1E9C              ; Resident bank-call gate and compatibility entry points for X86IO and X86ALU.
 238  1E9C                      INCLUDE "neogs_sub/p126_overlay_gate.asm"
# file opened: p126_overlay_gate.asm
   1+ 1E9C              ; =========================================================================
   2+ 1E9C              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 1E9C              ;
   4+ 1E9C              ; API:
   5+ 1E9C              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 1E9C              ;   IX = entry address in 8000h-BFFFh
   7+ 1E9C              ;   CALL p126_overlay_call
   8+ 1E9C              ;
   9+ 1E9C              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 1E9C              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 1E9C              ; restores the previous selector before returning to the original caller.
  12+ 1E9C              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 1E9C              ;
  14+ 1E9C              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 1E9C              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 1E9C              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 1E9C              ; =========================================================================
  18+ 1E9C
  19+ 1E9C              P126_OVERLAY_MAX_CALL_DEPTH EQU 8
  20+ 1E9C
  21+ 1E9C              p126_overlay_call:
  22+ 1E9C DD 22 CE 22          ld      (p126_overlay_gate_entry),ix
  23+ 1EA0 22 D0 22             ld      (p126_overlay_gate_saved_hl),hl
  24+ 1EA3 08                   ex      af,af'                   ; keep caller AF while using A
  25+ 1EA4 3A CB 22             ld      a,(p126_overlay_call_depth)
  26+ 1EA7 FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 1EA9 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 1EAB 3C                   inc     a
  29+ 1EAC 32 CB 22             ld      (p126_overlay_call_depth),a
  30+ 1EAF                      ; Record the requested page for active-page release protection.
  31+ 1EAF D5                   push    de
  32+ 1EB0 DD 21 D2 22          ld      ix,p126_overlay_call_pages
  33+ 1EB4 3D                   dec     a
  34+ 1EB5 5F                   ld      e,a
  35+ 1EB6 16 00                ld      d,0
  36+ 1EB8 DD 19                add     ix,de
  37+ 1EBA 3A CD 22             ld      a,(p126_overlay_request_selector)
