 395+ 043D              ; -------------------------------------------------------------------------
 396+ 043D              ; Unified guest memory interface
 397+ 043D              ;
 398+ 043D              ; Guest physical address is classified before selecting its physical backing:
 399+ 043D              ;   00000-9FFFF / C8000-FDFFF : guest RAM, pages 44h-83h
 400+ 043D              ;   A0000-BFFFF               : linear VGA aperture backing, pages 30h-37h
 401+ 043D              ;   C0000-C7FFF               : VGA BIOS slot, pages 20h-21h
 402+ 043D              ;   FE000-FFFFF               : system BIOS slot, page 10h (8 KiB image)
 403+ 043D              ;
 404+ 043D              ; The VGA aperture backend is deliberately a byte-linear staging layer over
 405+ 043D              ; the first 128 KiB of the 256 KiB VRAM allocation. It is NOT yet IBM VGA
 406+ 043D              ; plane/latch/read-mode/write-mode emulation. VGA register semantics are a
 407+ 043D              ; separate implementation stage.
 408+ 043D              ;
 409+ 043D              ; All backing is reached through WIN3. A is the page bias for the address
 410+ 043D              ; formula: page = (guest_high_nibble*4)+(guest_middle>>6)+bias.
