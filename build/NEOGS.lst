   2+ 3C0D              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 3C0D              ;
   4+ 3C0D              ; API:
   5+ 3C0D              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 3C0D              ;   IX = entry address in 8000h-BFFFh
