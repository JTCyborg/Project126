 214  3D0E              ; Resident bank-call gate and compatibility entry points for X86IO and X86ALU.
 215  3D0E                      INCLUDE "neogs_sub/p126_overlay_gate.asm"
# file opened: p126_overlay_gate.asm
   1+ 3D0E              ; =========================================================================
   2+ 3D0E              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 3D0E              ;
   4+ 3D0E              ; API:
   5+ 3D0E              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 3D0E              ;   IX = entry address in 8000h-BFFFh
   7+ 3D0E              ;   CALL p126_overlay_call
   8+ 3D0E              ;
   9+ 3D0E              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 3D0E              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 3D0E              ; restores the previous selector before returning to the original caller.
  12+ 3D0E              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 3D0E              ;
  14+ 3D0E              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 3D0E              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 3D0E              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 3D0E              ; =========================================================================
  18+ 3D0E
  19+ 3D0E              P126_OVERLAY_MAX_CALL_DEPTH EQU 8
  20+ 3D0E
  21+ 3D0E              p126_overlay_call:
