 148+ 31AA              ; -------------------------------------------------------------------------
 149+ 31AA              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 31AA              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 31AA              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 31AA              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 31AA              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 31AA              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 31AA              ; -------------------------------------------------------------------------
 156+ 31AA              P126_NGS_DMA_MOD      EQU #1B
 157+ 31AA              P126_NGS_DMA_HAD      EQU #1C
 158+ 31AA              P126_NGS_DMA_MAD      EQU #1D
 159+ 31AA              P126_NGS_DMA_LAD      EQU #1E
 160+ 31AA              P126_NGS_DMA_CST      EQU #1F
 161+ 31AA              P126_NGS_ZXSTAT       EQU #04
 162+ 31AA              P126_NGS_CLRCBIT      EQU #05
 163+ 31AA              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 31AA              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 31AA              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 31AA              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 31AA              ; until frame validation or reverse-transfer completion.
 168+ 31AA              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 31AA              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 31AA              P126_NGS_DMA_WAIT_OUTER EQU 8
