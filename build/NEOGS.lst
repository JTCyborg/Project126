 122  009F 21 B5 01             ld      hl,p126_ngs_resident_frame_bad
 123  00A2 CD BA 00             call    p126_ngs_resident_log
 124  00A5 F1                   pop     af
 125  00A6 18 CD                jr      p126_ngs_resident_main_loop
