102   0074 B7                   or      a
103   0075 28 04                jr      z,.p126_ngs_resident_log_done
104   0077 ED 79                out     (c),a
105   0079 18 F7                jr      .p126_ngs_resident_log_loop
106   007B              .p126_ngs_resident_log_done:
107   007B C1                   pop     bc
108   007C F1                   pop     af
109   007D C9                   ret
