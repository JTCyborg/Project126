  53+ 0000              P126_NGS_VGABIOS_LIMIT       EQU (P126_NGS_VGABIOS_PAGE+P126_NGS_VGABIOS_PAGES)*P126_NGS_PAGE_SIZE
  54+ 0000              P126_NGS_VRAM_BASE           EQU P126_NGS_VRAM_PAGE*P126_NGS_PAGE_SIZE
