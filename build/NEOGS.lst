 197+ 3243 CD 66 3C             call    p126_ngs_ipc_log
 198+ 3246 AF                   xor     a
 199+ 3247 D3 05                out     (P126_NGS_CLRCBIT),a
 200+ 3249 21 B6 3A             ld      hl,p126_ngs_ipc_log_dma_ready
