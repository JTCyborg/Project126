 182+ 323F 21 AC 3A             ld      hl,p126_ngs_ipc_log_dma_cfg_begin
 183+ 3242 CD 7E 3C             call    p126_ngs_ipc_log
 184+ 3245
 185+ 3245                      ; Physical page 42h base = 108000h: HAD=10h, MAD=80h, LAD=00h.
 186+ 3245 3E 01                ld      a,1
