 47+  0000              P126_NGS_KERNEL_BASE         EQU P126_NGS_KERNEL_PAGE*P126_NGS_PAGE_SIZE
 48+  0000              P126_NGS_KERNEL_LIMIT        EQU (P126_NGS_KERNEL_PAGE+P126_NGS_KERNEL_PAGES)*P126_NGS_PAGE_SIZE
 49+  0000              P126_NGS_SYSBIOS_BASE        EQU P126_NGS_SYSBIOS_PAGE*P126_NGS_PAGE_SIZE
