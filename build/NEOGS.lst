 237  1E40              ; Resident bank-call gate and compatibility entry points for X86IO and X86ALU.
 238  1E40                      INCLUDE "neogs_sub/p126_overlay_gate.asm"
# file opened: p126_overlay_gate.asm
   1+ 1E40              ; =========================================================================
   2+ 1E40              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 1E40              ;
   4+ 1E40              ; API:
   5+ 1E40              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 1E40              ;   IX = entry address in 8000h-BFFFh
   7+ 1E40              ;   CALL p126_overlay_call
   8+ 1E40              ;
   9+ 1E40              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 1E40              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 1E40              ; restores the previous selector before returning to the original caller.
  12+ 1E40              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 1E40              ;
  14+ 1E40              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 1E40              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 1E40              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 1E40              ; =========================================================================
  18+ 1E40
  19+ 1E40              P126_OVERLAY_MAX_CALL_DEPTH EQU 8
  20+ 1E40
  21+ 1E40              p126_overlay_call:
  22+ 1E40 DD 22 72 22          ld      (p126_overlay_gate_entry),ix
  23+ 1E44 22 74 22             ld      (p126_overlay_gate_saved_hl),hl
  24+ 1E47 08                   ex      af,af'                   ; keep caller AF while using A
  25+ 1E48 3A 6F 22             ld      a,(p126_overlay_call_depth)
  26+ 1E4B FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 1E4D 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 1E4F 3C                   inc     a
  29+ 1E50 32 6F 22             ld      (p126_overlay_call_depth),a
  30+ 1E53                      ; Record the requested page for active-page release protection.
  31+ 1E53 D5                   push    de
  32+ 1E54 DD 21 76 22          ld      ix,p126_overlay_call_pages
  33+ 1E58 3D                   dec     a
  34+ 1E59 5F                   ld      e,a
  35+ 1E5A 16 00                ld      d,0
  36+ 1E5C DD 19                add     ix,de
  37+ 1E5E 3A 71 22             ld      a,(p126_overlay_request_selector)
  38+ 1E61 DD 77 00             ld      (ix+0),a
  39+ 1E64 D1                   pop     de
  40+ 1E65 3A 70 22             ld      a,(p126_overlay_current_selector)
  41+ 1E68 F5                   push    af                       ; per-call previous-selector frame
  42+ 1E69 3A 71 22             ld      a,(p126_overlay_request_selector)
  43+ 1E6C 32 70 22             ld      (p126_overlay_current_selector),a
  44+ 1E6F D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  45+ 1E71 21 7F 1E             ld      hl,p126_overlay_gate_return
  46+ 1E74 E5                   push    hl                       ; overlay RET enters resident WIN0
  47+ 1E75 DD 2A 72 22          ld      ix,(p126_overlay_gate_entry)
  48+ 1E79 2A 74 22             ld      hl,(p126_overlay_gate_saved_hl)
  49+ 1E7C 08                   ex      af,af'                   ; restore caller AF for module
  50+ 1E7D DD E9                jp      (ix)
  51+ 1E7F
  52+ 1E7F              p126_overlay_gate_return:
