  90  0062 CD 7A 00             call    p126_ngs_resident_log
  91  0065 F1                   pop     af
  92  0066 18 D9                jr      p126_ngs_resident_main_loop
  93  0068              p126_ngs_resident_crc_fail:
  94  0068 21 E9 00             ld      hl,p126_ngs_resident_crc_bad
  95  006B CD 7A 00             call    p126_ngs_resident_log
  96  006E 18 06                jr      p126_ngs_resident_halt
  97  0070              p126_ngs_resident_ack_fail:
