 148+ 31BB              ; -------------------------------------------------------------------------
 149+ 31BB              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
 150+ 31BB              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
 151+ 31BB              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
 152+ 31BB              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
 153+ 31BB              ; carry set/A=status. Production DMA destination is physical 108000h on
 154+ 31BB              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
 155+ 31BB              ; -------------------------------------------------------------------------
 156+ 31BB              P126_NGS_DMA_MOD      EQU #1B
 157+ 31BB              P126_NGS_DMA_HAD      EQU #1C
 158+ 31BB              P126_NGS_DMA_MAD      EQU #1D
 159+ 31BB              P126_NGS_DMA_LAD      EQU #1E
 160+ 31BB              P126_NGS_DMA_CST      EQU #1F
 161+ 31BB              P126_NGS_ZXSTAT       EQU #04
 162+ 31BB              P126_NGS_CLRCBIT      EQU #05
 163+ 31BB              P126_NGS_MPAGEX_PORT  EQU #10
 164+ 31BB              ; Production DMA staging allocation: physical page 42h = 108000h.
 165+ 31BB              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
 166+ 31BB              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
 167+ 31BB              ; until frame validation or reverse-transfer completion.
 168+ 31BB              P126_NGS_DMA_PROD_PAGE EQU #42
 169+ 31BB              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
 170+ 31BB              P126_NGS_DMA_WAIT_OUTER EQU 8
