  33  0000              ; =========================================================================
  34  0000              ; Project126 resident Z80 entry. Stage-0 copies this image to physical page
  35  0000              ; 00. WIN1/page 03 owns the resident stack; WIN2 is the overlay aperture;
  36  0000              ; WIN3 is the dedicated guest-memory aperture.
  37  0000              ; =========================================================================
  38  0000              p126_ngs_resident_entry_vector:
  39  0000 C3 08 00             jp      p126_ngs_resident_start
  40  0003 00 00 00...          BLOCK   5,0
  41  0008
  42  0008              p126_ngs_resident_start:
  43  0008 F3                   di
  44  0009 DB 0F                in      a,(#0F)
  45  000B E6 CF                and     #CF
  46  000D F6 29                or      #29                    ; 20 MHz + NOROM + EXPAG
  47  000F D3 0F                out     (#0F),a
  48  0011 AF                   xor     a
  49  0012 01 20 00             ld      bc,#0020
  50  0015 ED 79                out     (c),a                  ; WIN0 -> physical page 00
  51  0017 3E 03                ld      a,3
  52  0019 01 21 00             ld      bc,#0021
  53  001C ED 79                out     (c),a                  ; WIN1 -> physical page 03
  54  001E 3E 80                ld      a,#80
  55  0020 D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a ; WIN2 placeholder -> page 01
  56  0022 32 A1 3E             ld      (p126_overlay_current_selector),a
  57  0025 3E 01                ld      a,#01
  58  0027 D3 10                out     (#10),a                ; WIN3 -> physical page 02 until banked
  59  0029 31 FE 7F             ld      sp,#7FFE
  60  002C AF                   xor     a
  61  002D 32 A0 3E             ld      (p126_overlay_call_depth),a
  62  0030 21 A7 3E             ld      hl,p126_overlay_call_pages
  63  0033 11 A8 3E             ld      de,p126_overlay_call_pages+1
  64  0036 01 07 00             ld      bc,P126_OVERLAY_MAX_CALL_DEPTH-1
  65  0039 77                   ld      (hl),a
  66  003A ED B0                ldir
  67  003C 21 AF 3E             ld      hl,p126_overlay_alloc_state
  68  003F 11 B0 3E             ld      de,p126_overlay_alloc_state+1
  69  0042 01 09 00             ld      bc,9
  70  0045 77                   ld      (hl),a
  71  0046 ED B0                ldir
  72  0048 CD 94 3C             call    p126_overlay_allocator_selftest
  73  004B 38 08                jr      c,.p126_allocator_selftest_failed
  74  004D 21 29 01             ld      hl,p126_ngs_resident_allocator_ok
  75  0050 CD BA 00             call    p126_ngs_resident_log
  76  0053 18 08                jr      .p126_allocator_selftest_done
  77  0055              .p126_allocator_selftest_failed:
  78  0055 21 48 01             ld      hl,p126_ngs_resident_allocator_bad
  79  0058 CD BA 00             call    p126_ngs_resident_log
  80  005B 18 59                jr      p126_ngs_resident_halt
  81  005D              .p126_allocator_selftest_done:
  82  005D
  83  005D 21 F5 00             ld      hl,p126_ngs_resident_banner
  84  0060 CD BA 00             call    p126_ngs_resident_log
  85  0063 CD 4D 39             call    p126_ngs_ipc_crc16_selftest
  86  0066 38 40                jr      c,p126_ngs_resident_crc_fail
  87  0068 21 12 01             ld      hl,p126_ngs_resident_crc_ok
  88  006B CD BA 00             call    p126_ngs_resident_log
  89  006E 3E A2                ld      a,#A2
  90  0070 CD CB 00             call    p126_ngs_resident_send_boot_ack
  91  0073 38 3B                jr      c,p126_ngs_resident_ack_fail
  92  0075
  93  0075              p126_ngs_resident_main_loop:
  94  0075 CD B2 33             call    p126_ngs_ipc_dispatch_once
  95  0078 38 24                jr      c,p126_ngs_resident_frame_error
  96  007A B7                   or      a
  97  007B 28 06                jr      z,.check_bios_ready
  98  007D 21 9D 01             ld      hl,p126_ngs_resident_frame_ok
  99  0080 CD BA 00             call    p126_ngs_resident_log
 100  0083              .check_bios_ready:
 101  0083                      ; CPU execution calls the fixed-origin I/O overlay at 8000h.
 102  0083                      ; Do not enter the BIOS until its page-04 image has been verified
 103  0083                      ; and mapped into WIN2 by IMAGE_FINISH.
 104  0083 3A F6 37             ld      a,(p126_ngs_io_overlay_ready)
 105  0086 B7                   or      a
 106  0087 28 EC                jr      z,p126_ngs_resident_main_loop
 107  0089 3A F7 37             ld      a,(p126_ngs_alu_overlay_ready)
 108  008C B7                   or      a
 109  008D 28 E6                jr      z,p126_ngs_resident_main_loop
 110  008F 3A F5 37             ld      a,(p126_ngs_bios_image_ready)
 111  0092 B7                   or      a
 112  0093 28 E0                jr      z,p126_ngs_resident_main_loop
 113  0095                      ; Consume the installation event before probing: one-shot transition.
 114  0095 AF                   xor     a
 115  0096 32 F5 37             ld      (p126_ngs_bios_image_ready),a
 116  0099                      ; Begin BIOS bring-up only after both IMAGE_FINISH/readback gates.
 117  0099 CD 5C 02             call    x86_bios_startup_trace
 118  009C 18 D7                jr      p126_ngs_resident_main_loop
 119  009E
