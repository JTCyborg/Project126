 211  3BCA              ; Resident bank-call gate and compatibility entry points for X86IO and X86ALU.
 212  3BCA                      INCLUDE "neogs_sub/p126_overlay_gate.asm"
# file opened: p126_overlay_gate.asm
   1+ 3BCA              ; =========================================================================
   2+ 3BCA              ; PROJECT126 — resident WIN2 overlay call gate
   3+ 3BCA              ;
   4+ 3BCA              ; API:
   5+ 3BCA              ;   p126_overlay_request_selector = ROR8(physical overlay page)
   6+ 3BCA              ;   IX = entry address in 8000h-BFFFh
   7+ 3BCA              ;   CALL p126_overlay_call
   8+ 3BCA              ;
   9+ 3BCA              ; AF, BC, DE, HL and IY are preserved at module entry; IX is consumed as
  10+ 3BCA              ; the entry pointer. The module returns with RET. The resident trampoline
  11+ 3BCA              ; restores the previous selector before returning to the original caller.
  12+ 3BCA              ; Each nesting level stores its previous selector on the WIN1 stack.
  13+ 3BCA              ;
  14+ 3BCA              ; The request selector, entry and caller HL are copied/restored before module entry, so
  15+ 3BCA              ; nested calls may safely reuse the resident scratch bytes/words.
  16+ 3BCA              ; Host Z80 interrupts remain disabled by the resident execution contract.
  17+ 3BCA              ; =========================================================================
  18+ 3BCA
  19+ 3BCA              P126_OVERLAY_MAX_CALL_DEPTH EQU 8
  20+ 3BCA
  21+ 3BCA              p126_overlay_call:
  22+ 3BCA DD 22 A3 3E          ld      (p126_overlay_gate_entry),ix
  23+ 3BCE 22 A5 3E             ld      (p126_overlay_gate_saved_hl),hl
  24+ 3BD1 08                   ex      af,af'                   ; keep caller AF while using A
  25+ 3BD2 3A A0 3E             ld      a,(p126_overlay_call_depth)
  26+ 3BD5 FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 3BD7 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 3BD9 3C                   inc     a
  29+ 3BDA 32 A0 3E             ld      (p126_overlay_call_depth),a
  30+ 3BDD                      ; Record the requested page for active-page release protection.
  31+ 3BDD D5                   push    de
  32+ 3BDE DD 21 A7 3E          ld      ix,p126_overlay_call_pages
  33+ 3BE2 3D                   dec     a
  34+ 3BE3 5F                   ld      e,a
  35+ 3BE4 16 00                ld      d,0
  36+ 3BE6 DD 19                add     ix,de
  37+ 3BE8 3A A2 3E             ld      a,(p126_overlay_request_selector)
  38+ 3BEB DD 77 00             ld      (ix+0),a
  39+ 3BEE D1                   pop     de
  40+ 3BEF 3A A1 3E             ld      a,(p126_overlay_current_selector)
  41+ 3BF2 F5                   push    af                       ; per-call previous-selector frame
  42+ 3BF3 3A A2 3E             ld      a,(p126_overlay_request_selector)
  43+ 3BF6 32 A1 3E             ld      (p126_overlay_current_selector),a
  44+ 3BF9 D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  45+ 3BFB 21 09 3C             ld      hl,p126_overlay_gate_return
  46+ 3BFE E5                   push    hl                       ; overlay RET enters resident WIN0
  47+ 3BFF DD 2A A3 3E          ld      ix,(p126_overlay_gate_entry)
  48+ 3C03 2A A5 3E             ld      hl,(p126_overlay_gate_saved_hl)
  49+ 3C06 08                   ex      af,af'                   ; restore caller AF for module
  50+ 3C07 DD E9                jp      (ix)
  51+ 3C09
  52+ 3C09              p126_overlay_gate_return:
  53+ 3C09 08                   ex      af,af'                   ; preserve module return AF
  54+ 3C0A F1                   pop     af                       ; restore previous WIN2 selector
  55+ 3C0B 32 A1 3E             ld      (p126_overlay_current_selector),a
  56+ 3C0E D3 00                out     (P126_NGS_OVERLAY_WINDOW_PORT),a
  57+ 3C10                      ; Clear this active-page slot before decrementing the frame depth.
  58+ 3C10 D5                   push    de
  59+ 3C11 3A A0 3E             ld      a,(p126_overlay_call_depth)
  60+ 3C14 3D                   dec     a
  61+ 3C15 5F                   ld      e,a
  62+ 3C16 16 00                ld      d,0
  63+ 3C18 DD 21 A7 3E          ld      ix,p126_overlay_call_pages
