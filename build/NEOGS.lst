  58+ 1E86 D5                   push    de
  59+ 1E87 3A 6F 22             ld      a,(p126_overlay_call_depth)
  60+ 1E8A 3D                   dec     a
  61+ 1E8B 5F                   ld      e,a
  62+ 1E8C 16 00                ld      d,0
  63+ 1E8E DD 21 76 22          ld      ix,p126_overlay_call_pages
