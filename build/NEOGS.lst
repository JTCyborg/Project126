  25+ 3D16 3A 57 40             ld      a,(p126_overlay_call_depth)
  26+ 3D19 FE 08                cp      P126_OVERLAY_MAX_CALL_DEPTH
  27+ 3D1B 30 53                jr      nc,p126_overlay_depth_rejected
  28+ 3D1D 3C                   inc     a
  29+ 3D1E 32 57 40             ld      (p126_overlay_call_depth),a
