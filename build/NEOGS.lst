148+  087D              ; -------------------------------------------------------------------------
149+  087D              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
150+  087D              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
151+  087D              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
152+  087D              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
153+  087D              ; carry set/A=status. Production DMA destination is physical 108000h on
154+  087D              ; page 42h, mapped into WIN3 through MPAGEX (#10) using Project125 selector encoding.
155+  087D              ; -------------------------------------------------------------------------
156+  087D              P126_NGS_DMA_MOD      EQU #1B
157+  087D              P126_NGS_DMA_HAD      EQU #1C
158+  087D              P126_NGS_DMA_MAD      EQU #1D
159+  087D              P126_NGS_DMA_LAD      EQU #1E
160+  087D              P126_NGS_DMA_CST      EQU #1F
161+  087D              P126_NGS_ZXSTAT       EQU #04
162+  087D              P126_NGS_CLRCBIT      EQU #05
163+  087D              P126_NGS_MPAGEX_PORT  EQU #10
164+  087D              ; Production DMA staging allocation: physical page 42h = 108000h.
165+  087D              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
166+  087D              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
167+  087D              ; until frame validation or reverse-transfer completion.
168+  087D              P126_NGS_DMA_PROD_PAGE EQU #42
169+  087D              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
170+  087D              P126_NGS_DMA_WAIT_OUTER EQU 8
171+  087D
172+  087D              p126_ngs_ipc_dma_receive_frame:
172+  087D
173+  087D                      ; Production page-42 validation. WIN3 is selected through MPAGEX (#10),
174+  087D                      ; exactly as in Project125. MPAGEX expects the physical page number
175+  087D                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
176+  087D                      ; Resident stack/code remain in WIN0-WIN2.
177+  087D 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
178+  087F 0F                   rrca
179+  0880 D3 10                out     (P126_NGS_MPAGEX_PORT),a
180+  0882 21 93 0D             ld      hl,p126_ngs_ipc_log_dma_page42_premapped
181+  0885 CD 87 0F             call    p126_ngs_ipc_log
182+  0888 21 DA 0C             ld      hl,p126_ngs_ipc_log_dma_cfg_begin
183+  088B CD 87 0F             call    p126_ngs_ipc_log
184+  088E
185+  088E                      ; Physical page 42h base = 108000h: HAD=10h, MAD=80h, LAD=00h.
186+  088E 3E 01                ld      a,1
187+  0890 D3 1B                out     (P126_NGS_DMA_MOD),a
188+  0892 3E 10                ld      a,#10
189+  0894 D3 1C                out     (P126_NGS_DMA_HAD),a
190+  0896 3E 80                ld      a,#80
191+  0898 D3 1D                out     (P126_NGS_DMA_MAD),a
192+  089A AF                   xor     a
193+  089B D3 1E                out     (P126_NGS_DMA_LAD),a
194+  089D 3E 80                ld      a,#80
195+  089F D3 1F                out     (P126_NGS_DMA_CST),a
