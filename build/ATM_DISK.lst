 224++65AE              ; -------------------------------------------------------------------------
 225++65AE              ; A = DS12887 register number, returns register value in A.
 226++65AE              ; Caller must have opened the EFF7 CMOS gate.
 227++65AE              ; No writes are made to the selected RTC register.
 228++65AE              ; -------------------------------------------------------------------------
 229++65AE              DS12887_READ_REG:
 230++65AE C5                   push    bc
 231++65AF 4F                   ld      c, a
 232++65B0 3A A5 66             ld      a, (ds12887_backend)
 233++65B3 B7                   or      a
 234++65B4 20 0D                jr      nz, ds12887_read_smuc
 235++65B6 79                   ld      a, c
 236++65B7 01 F7 DF             ld      bc, #DFF7
 237++65BA ED 79                out     (c), a
 238++65BC 01 F7 BF             ld      bc, #BFF7
 239++65BF ED 78                in      a, (c)
 240++65C1 C1                   pop     bc
 241++65C2 C9                   ret
 242++65C3              ds12887_read_smuc:
 243++65C3 79                   ld      a, c
 244++65C4 01 BA DF             ld      bc, #DFBA
 245++65C7 ED 79                out     (c), a
 246++65C9 ED 78                in      a, (c)
 247++65CB C1                   pop     bc
 248++65CC C9                   ret
