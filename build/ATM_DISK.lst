  55++64B1 CD 61 65             call    DS12887_VALIDATE_STATUS
  56++64B4 DA C5 64             jp      c, ds12887_probe_invalid
  57++64B7
  58++64B7 3E 01                ld      a, 1
  59++64B9 32 9A 66             ld      (ds12887_available), a
  60++64BC
  61++64BC CD C3 65             call    DS12887_READ_SNAPSHOT
  62++64BF DA CC 64             jp      c, ds12887_probe_read_error
  63++64C2
  64++64C2 C3 D0 64             jp      ds12887_probe_done
  65++64C5
  66++64C5              ds12887_probe_invalid:
  67++64C5 AF                   xor     a
  68++64C6 32 9A 66             ld      (ds12887_available), a
