  25++669A              ; Driver result convention:
  26++669A              ;   Carry clear = operation completed.
  27++669A              ;   Carry set   = timeout.
  28++669A              ;   A           = last observed GSSTAT on timeout / final status on wait.
  29++669A              ;   p126_ipc_last_status always contains the last sampled GSSTAT byte.
  30++669A
  31++669A              ; Public entry points (see docs/ATM_HOST_INTERFACE.md):
  32++669A              ;   p126_ipc_read_status
  33++669A              ;   p126_ipc_wait_cbit_clear
  34++669A              ;   p126_ipc_wait_dbit_clear
  35++669A              ;   p126_ipc_wait_dbit_set
  36++669A              ;   p126_ipc_send_command       A=command
  37++669A              ;   p126_ipc_send_argument      A=argument; preloads GSDAT before GSCOM
  38++669A              ;   p126_ipc_send_byte          A=data; waits for consumption
  39++669A              ;   p126_ipc_receive_byte       returns A=data
  40++669A              ;   p126_ipc_emit_version
  41++669A              ;   p126_ipc_validate_frame HL=frame, BC=size; carry/A=status
  42++669A              ;   p126_ipc_dma_send_frame HL=frame, BC=size; carry/A=status
  43++669A              ;   p126_ipc_dma_receive_test returns carry clear only after reverse-DMA CRC/pattern PASS
  44++669A              ; ABI 1.0 constants are imported from shared/p126_ipc_protocol.inc.
  45++669A
