  43++A00B              ; ATM shadow-port and text-mode initialization.
  44++A00B              ; The TR-DOS ROM trampoline must run before any #7FF7/#FFF7/#0177 access.
  45++A00B              ; =========================================================================
  46++A00B              p126_atm_video_init:
  46++A00B
  47++A00B F5                   push    af
  48++A00C C5                   push    bc
  49++A00D D5                   push    de
  50++A00E E5                   push    hl
  51++A00F
  52++A00F                      ; Reset the ATM paging/control latch BEFORE enabling permanent
  53++A00F                      ; DOSEN. On this board #EFF7 is part of the ATM paging control path;
  54++A00F                      ; resetting it after the #0177 shadow-port setup can undo the state
  55++A00F                      ; needed by the TR-DOS overlay.
  56++A00F AF                   xor     a
  57++A010 01 F7 EF             ld      bc, #EFF7
  58++A013 ED 79                out     (c), a
  59++A015
  60++A015                      ; ROM2=1 (D4) is required for TR-DOS overlay; D3 selects alternate
  61++A015                      ; video pages 7/3. This is #18, matching the host display setup.
  62++A015 3E 18                ld      a, #18
  63++A017 01 FD 7F             ld      bc, #7FFD
  64++A01A ED 79                out     (c), a
  65++A01C 32 3B 5C             ld      (#5C3B), a
  66++A01F
  67++A01F                      ; Open shadow ports and hold DOSEN permanently (A9=0) using the
  68++A01F                      ; documented TR-DOS ROM trampoline. Do this AFTER the paging reset.
  69++A01F 01 2F A0             ld      bc, p126_atm_ports_open_done
  70++A022 C5                   push    bc
  71++A023 01 53 2A             ld      bc, #2A53
  72++A026 C5                   push    bc
  73++A027 01 77 01             ld      bc, #0177
  74++A02A 3E C3                ld      a, #C3
  75++A02C C3 2F 3D             jp      #3D2F
  76++A02F
  77++A02F              p126_atm_ports_open_done:
  78++A02F                      ; Window 0 must use ROM with D7=1 so its ROM page selection is
  79++A02F                      ; coupled to ROM2/DOSEN. #BF selects the low ROM page with the
  80++A02F                      ; DOSEN-controlled low ROM select: BASIC-48 when DOSEN=0, TR-DOS
  81++A02F                      ; when DOSEN=1. This is the ATM2+ documented auto-TR-DOS mapping.
  82++A02F 3E BF                ld      a, #BF
  83++A031 01 F7 3F             ld      bc, #3FF7
  84++A034 ED 79                out     (c), a
  85++A036
  86++A036
  87++A036                      ; Map the alternate screen pages while the 32-byte mode trampoline
  88++A036                      ; is installed at #FFEC. Window 3 uses a fixed RAM page here; the
  89++A036                      ; TR-DOS auto-select mux is configured separately in window 0.
  90++A036 3E 78                ld      a, P126_VIDEO_PAGE7
  91++A038 01 F7 7F             ld      bc, #7FF7
  92++A03B ED 79                out     (c), a
  93++A03D 3E 7C                ld      a, P126_VIDEO_PAGE3
  94++A03F 01 F7 FF             ld      bc, #FFF7
  95++A042 ED 79                out     (c), a
  96++A044
  97++A044                      ; LD BC,#0177 / OUT (C),A / JP p126_atm_video_mode_ready
  98++A044 21 EC FF             ld      hl, #FFEC
  99++A047 36 01                ld      (hl), #01
 100++A049 23                   inc     hl
 101++A04A 36 77                ld      (hl), #77
 102++A04C 23                   inc     hl
 103++A04D 36 01                ld      (hl), #01
 104++A04F 23                   inc     hl
 105++A050 36 ED                ld      (hl), #ED
 106++A052 23                   inc     hl
 107++A053 36 79                ld      (hl), #79
 108++A055 23                   inc     hl
 109++A056 36 C3                ld      (hl), #C3
 110++A058 23                   inc     hl
 111++A059 36 68                ld      (hl), p126_atm_video_mode_ready & #FF
 112++A05B 23                   inc     hl
 113++A05C 36 A0                ld      (hl), p126_atm_video_mode_ready >> 8
 114++A05E
 115++A05E                      ; ATM Turbo 2+ RG=6: hardware text 80x25.
 116++A05E 3E 06                ld      a,P126_ATM_VIDEO_MODE_RG6_TEXT80X25
 117++A060 32 00 A0             ld      (p126_atm_video_mode),a
 118++A063 3E C6                ld      a, #C6
 119++A065 C3 EC FF             jp      #FFEC
