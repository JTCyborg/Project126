 177++64E8              ; -------------------------------------------------------------------------
 178++64E8              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++64E8              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++64E8              ; -------------------------------------------------------------------------
 181++64E8              DS12887_OPEN:
 182++64E8 F5                   push    af
 183++64E9 C5                   push    bc
