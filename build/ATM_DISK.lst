   1++6471              ; =========================================================================
   2++6471              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++6471              ; Version: D1.07
   4++6471              ;
   5++6471              ; ATM710 dual interface:
   6++6471              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++6471              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++6471              ; The RTC data/control registers are never written by this driver.
   9++6471              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++6471              ;
  11++6471              ; DS12887 registers used:
  12++6471              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++6471              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++6471              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15++6471              ; =========================================================================
  16++6471
