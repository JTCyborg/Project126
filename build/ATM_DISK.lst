  34++648A                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++648A CD 85 65             call    DS12887_CLOSE
  36++648D 3E 01                ld      a, 1
  37++648F 32 90 66             ld      (ds12887_backend), a
  38++6492 CD 6A 65             call    DS12887_OPEN
  39++6495 CD 21 65             call    DS12887_READ_STATUS
  40++6498                      ; Read back the SMUC system port after selecting address mode.
  41++6498                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42++6498                      ; an FF readback therefore identifies a closed DOS-port gate.
  43++6498 3A 90 66             ld      a, (ds12887_backend)
  44++649B B7                   or      a
  45++649C 28 08                jr      z, ds12887_probe_status_ready
  46++649E                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47++649E                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
  48++649E                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
  49++649E                      ; this is a useful decoder-presence test.
  50++649E 01 BE 5F             ld      bc, #5FBE
  51++64A1 ED 78                in      a, (c)
  52++64A3 32 91 66             ld      (ds12887_smuc_control), a
