 177++64B2              ; -------------------------------------------------------------------------
 178++64B2              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++64B2              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++64B2              ; -------------------------------------------------------------------------
 181++64B2              DS12887_OPEN:
