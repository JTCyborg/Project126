 177++657F              ; -------------------------------------------------------------------------
 178++657F              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++657F              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++657F              ; -------------------------------------------------------------------------
 181++657F              DS12887_OPEN:
 182++657F F5                   push    af
 183++6580 C5                   push    bc
 184++6581 3A A5 66             ld      a, (ds12887_backend)
 185++6584 B7                   or      a
 186++6585 20 09                jr      nz, ds12887_open_smuc
 187++6587 01 F7 EF             ld      bc, #EFF7
 188++658A 3E 80                ld      a, #80
 189++658C ED 79                out     (c), a
 190++658E 18 07                jr      ds12887_open_done
 191++6590              ds12887_open_smuc:
 192++6590                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++6590                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++6590                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++6590                      ; the SMUC multiplexed ISA address/control configuration and can
 196++6590                      ; interfere with later TR-DOS disk operations.
 197++6590 01 BA FF             ld      bc, #FFBA
 198++6593 3E 71                ld      a, #71
 199++6595 ED 79                out     (c), a
 200++6597              ds12887_open_done:
 201++6597 C1                   pop     bc
 202++6598 F1                   pop     af
 203++6599 C9                   ret
 204++659A
 205++659A              DS12887_CLOSE:
 206++659A F5                   push    af
 207++659B C5                   push    bc
 208++659C 3A A5 66             ld      a, (ds12887_backend)
 209++659F B7                   or      a
 210++65A0 20 09                jr      nz, ds12887_close_done
 211++65A2 01 F7 EF             ld      bc, #EFF7
 212++65A5 AF                   xor     a
 213++65A6 ED 79                out     (c), a
 214++65A8                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
 215++65A8                      ; path established by p126_atm_video_init. RTC access is performed
 216++65A8                      ; after video initialization in Project126, so restore the documented
 217++65A8                      ; #0177 state and RG=6 text mode before returning to the host.
 218++65A8 CD 7B A0             call    p126_atm_restore_dosen
 219++65AB              ds12887_close_done:
 220++65AB C1                   pop     bc
 221++65AC F1                   pop     af
 222++65AD C9                   ret
