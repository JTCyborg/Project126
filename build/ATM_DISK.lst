  1++ 6F28              ; =========================================================================
  2++ 6F28              ; PROJECT126 — ATM host NeoGS bootstrap/firmware loader
  3++ 6F28              ; Runs before ATM video paging is enabled. TR-DOS sector reads use the same
  4++ 6F28              ; C=5/B=1 ABI already validated by p126_catalog_read_disk.
  5++ 6F28              ; =========================================================================
  6++ 6F28              P126_NGS_GSCOM EQU #BB
  7++ 6F28              P126_NGS_GSSTAT EQU #BB
  8++ 6F28              P126_NGS_GSDAT EQU #B3
  9++ 6F28              P126_NGS_GSCTR EQU #33
 10++ 6F28              P126_NGS_CBIT EQU 0
 11++ 6F28              P126_NGS_DBIT EQU 7
 12++ 6F28              P126_NGS_CMD_RAM EQU #20
 13++ 6F28              P126_NGS_CMD_JUMP EQU #13
 14++ 6F28              P126_NGS_CMD_RECV EQU #14
 15++ 6F28              P126_NGS_ACK_READY EQU #A1
 16++ 6F28              P126_NGS_ACK_LENGTH EQU #A3
 17++ 6F28              P126_NGS_ACK_DONE EQU #A2
 18++ 6F28              P126_NGS_TIMEOUT EQU #FFFF
 19++ 6F28
 20++ 6F28              ; Called after directory preload and before ATM video initialization.
 21++ 6F28              ; Carry clear means the resident image sent its A2h ready acknowledgement.
 22++ 6F28              p126_neogs_startup:
 22++ 6F28
 23++ 6F28 3E 31                ld      a,'1'
 24++ 6F2A 32 1B 73             ld      (p126_neogs_startup_stage),a
 25++ 6F2D 21 E3 72             ld      hl,p126_neogs_boot_name
 26++ 6F30 CD B6 70             call    p126_neogs_open_file
 27++ 6F33 D8                   ret     c
 28++ 6F34 3E 32                ld      a,'2'
 29++ 6F36 32 1B 73             ld      (p126_neogs_startup_stage),a
 30++ 6F39                      ; The build deliberately permits a full 256-byte ROM #14 block.
 31++ 6F39                      ; Accept lengths 1..255 and exactly 256 (0100h); reject 0 and >256.
