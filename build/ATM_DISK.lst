 108++64FF 3A AB 66             ld      a, (ds12887_minutes)
 109++6502 CD 4A 66             call    DS12887_TO_BINARY
 110++6505 21 A0 66             ld      hl, txt_min
 111++6508 CD 65 66             call    DS12887_TO_DECIMAL
 112++650B
