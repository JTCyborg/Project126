# file opened: ds12887_rtc.asm
   1++648C              ; =========================================================================
   2++648C              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++648C              ; Version: D1.07
   4++648C              ;
   5++648C              ; ATM710 dual interface:
   6++648C              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++648C              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++648C              ; The RTC data/control registers are never written by this driver.
   9++648C              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++648C              ;
  11++648C              ; DS12887 registers used:
  12++648C              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++648C              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++648C              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15++648C              ; =========================================================================
  16++648C
  17++648C              DS12887_PROBE:
  17++648C
  18++648C F5                   push    af
  19++648D C5                   push    bc
  20++648E D5                   push    de
  21++648F E5                   push    hl
  22++6490
  23++6490                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++6490 AF                   xor     a
  25++6491 32 A5 66             ld      (ds12887_backend), a
  26++6494 CD 7F 65             call    DS12887_OPEN
  27++6497 CD 36 65             call    DS12887_READ_STATUS
  28++649A                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++649A                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++649A CD 6B 65             call    DS12887_VALIDATE_STATUS
  31++649D 30 1C                jr      nc, ds12887_probe_status_ready
  32++649F
  33++649F                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++649F                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++649F CD 9A 65             call    DS12887_CLOSE
  36++64A2 3E 01                ld      a, 1
  37++64A4 32 A5 66             ld      (ds12887_backend), a
  38++64A7 CD 7F 65             call    DS12887_OPEN
  39++64AA CD 36 65             call    DS12887_READ_STATUS
  40++64AD                      ; Read back the SMUC system port after selecting address mode.
  41++64AD                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42++64AD                      ; an FF readback therefore identifies a closed DOS-port gate.
  43++64AD 3A A5 66             ld      a, (ds12887_backend)
  44++64B0 B7                   or      a
  45++64B1 28 08                jr      z, ds12887_probe_status_ready
  46++64B3                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47++64B3                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
  48++64B3                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
  49++64B3                      ; this is a useful decoder-presence test.
  50++64B3 01 BE 5F             ld      bc, #5FBE
  51++64B6 ED 78                in      a, (c)
  52++64B8 32 A6 66             ld      (ds12887_smuc_control), a
  53++64BB
  54++64BB              ds12887_probe_status_ready:
  55++64BB CD 6B 65             call    DS12887_VALIDATE_STATUS
  56++64BE DA CF 64             jp      c, ds12887_probe_invalid
  57++64C1
  58++64C1 3E 01                ld      a, 1
  59++64C3 32 A4 66             ld      (ds12887_available), a
  60++64C6
  61++64C6 CD CD 65             call    DS12887_READ_SNAPSHOT
  62++64C9 DA D6 64             jp      c, ds12887_probe_read_error
  63++64CC
  64++64CC C3 DA 64             jp      ds12887_probe_done
  65++64CF
  66++64CF              ds12887_probe_invalid:
  67++64CF AF                   xor     a
  68++64D0 32 A4 66             ld      (ds12887_available), a
  69++64D3 C3 DA 64             jp      ds12887_probe_done
  70++64D6
  71++64D6              ds12887_probe_read_error:
  72++64D6 AF                   xor     a
  73++64D7 32 A4 66             ld      (ds12887_available), a
  74++64DA
  75++64DA              ds12887_probe_done:
  76++64DA CD 9A 65             call    DS12887_CLOSE
  77++64DD E1                   pop     hl
  78++64DE D1                   pop     de
  79++64DF C1                   pop     bc
  80++64E0 F1                   pop     af
  81++64E1 C9                   ret
  82++64E2
  83++64E2              ; -------------------------------------------------------------------------
  84++64E2              ; Public timestamp API.
  85++64E2              ; Output txt_hour/txt_min/txt_sec = two decimal ASCII digits.
  86++64E2              ; If DS12887 is unavailable or UIP never clears, outputs "??".
  87++64E2              ; AF/BC/DE/HL are preserved for the caller.
  88++64E2              ; -------------------------------------------------------------------------
  89++64E2              READ_CURRENT_TIME:
  89++64E2
  90++64E2 F5                   push    af
  91++64E3 C5                   push    bc
  92++64E4 D5                   push    de
  93++64E5 E5                   push    hl
  94++64E6
  95++64E6 CD 7F 65             call    DS12887_OPEN
  96++64E9 3A A4 66             ld      a, (ds12887_available)
  97++64EC B7                   or      a
  98++64ED CA 1A 65             jp      z, ds12887_time_unknown
  99++64F0
 100++64F0 CD CD 65             call    DS12887_READ_SNAPSHOT
 101++64F3 DA 1A 65             jp      c, ds12887_time_unknown
