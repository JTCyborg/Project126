  25++6697              ; Driver result convention:
  26++6697              ;   Carry clear = operation completed.
  27++6697              ;   Carry set   = timeout.
  28++6697              ;   A           = last observed GSSTAT on timeout / final status on wait.
  29++6697              ;   p126_ipc_last_status always contains the last sampled GSSTAT byte.
  30++6697
  31++6697              ; Public entry points (see docs/ATM_HOST_INTERFACE.md):
  32++6697              ;   p126_ipc_read_status
  33++6697              ;   p126_ipc_wait_cbit_clear
  34++6697              ;   p126_ipc_wait_dbit_clear
  35++6697              ;   p126_ipc_wait_dbit_set
  36++6697              ;   p126_ipc_send_command       A=command
  37++6697              ;   p126_ipc_send_argument      A=argument; preloads GSDAT before GSCOM
  38++6697              ;   p126_ipc_send_byte          A=data; waits for consumption
  39++6697              ;   p126_ipc_receive_byte       returns A=data
  40++6697              ;   p126_ipc_emit_version
  41++6697              ;   p126_ipc_validate_frame HL=frame, BC=size; carry/A=status
  42++6697              ;   p126_ipc_dma_send_frame HL=frame, BC=size; carry/A=status
  43++6697              ;   p126_ipc_dma_receive_test returns carry clear only after reverse-DMA CRC/pattern PASS
  44++6697              ; ABI 1.0 constants are imported from shared/p126_ipc_protocol.inc.
  45++6697
  46++6697              P126_IPC_TIMEOUT    EQU #FFFF
