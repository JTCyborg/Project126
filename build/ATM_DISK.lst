296+  640E                      INCLUDE "atm_host/ds12887_rtc.asm"
# file opened: ds12887_rtc.asm
  1++ 640E              ; =========================================================================
  2++ 640E              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
  3++ 640E              ; Version: D1.07
  4++ 640E              ;
  5++ 640E              ; ATM710 dual interface:
  6++ 640E              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 640E              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 640E              ; The RTC data/control registers are never written by this driver.
  9++ 640E              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 640E              ;
 11++ 640E              ; DS12887 registers used:
 12++ 640E              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 640E              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 640E              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
 15++ 640E              ; =========================================================================
 16++ 640E
 17++ 640E              DS12887_PROBE:
 17++ 640E
 18++ 640E F5                   push    af
 19++ 640F C5                   push    bc
 20++ 6410 D5                   push    de
 21++ 6411 E5                   push    hl
 22++ 6412
 23++ 6412                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
