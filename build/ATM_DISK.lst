 38++ 64BC CD 94 65             call    DS12887_OPEN
 39++ 64BF CD 4B 65             call    DS12887_READ_STATUS
 40++ 64C2                      ; Read back the SMUC system port after selecting address mode.
 41++ 64C2                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
 42++ 64C2                      ; an FF readback therefore identifies a closed DOS-port gate.
 43++ 64C2 3A B7 66             ld      a, (ds12887_backend)
 44++ 64C5 B7                   or      a
