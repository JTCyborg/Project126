 149++654F              ; Print the last captured Status D/A/B triplet.
 150++654F              DS12887_PRINT_STATUS:
 151++654F 3A A9 66             ld      a, (ds12887_status_d)
 152++6552 CD 7B 66             call    DS12887_PRINT_HEX8
