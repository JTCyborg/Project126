  38++648F CD 67 65             call    DS12887_OPEN
  39++6492 CD 1E 65             call    DS12887_READ_STATUS
  40++6495                      ; Read back the SMUC system port after selecting address mode.
  41++6495                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42++6495                      ; an FF readback therefore identifies a closed DOS-port gate.
  43++6495 3A 8D 66             ld      a, (ds12887_backend)
  44++6498 B7                   or      a
  45++6499 28 08                jr      z, ds12887_probe_status_ready
  46++649B                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47++649B                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
