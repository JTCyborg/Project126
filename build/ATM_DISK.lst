 121++A068              p126_atm_video_mode_ready:
 122++A068                      ; Restore CPU-visible host/staging pages. Keep D7 clear on #FFF7 so
 123++A068                      ; window 3 remains fixed to RAM page 0 for the TR-DOS staging buffer.
 124++A068 3E 7A                ld      a, P126_HOST_PAGE5
 125++A06A 01 F7 7F             ld      bc, #7FF7
 126++A06D ED 79                out     (c), a
 127++A06F 3E 7F                ld      a, P126_HOST_PAGE0
 128++A071 01 F7 FF             ld      bc, #FFF7
 129++A074 ED 79                out     (c), a
 130++A076
 131++A076 E1                   pop     hl
 132++A077 D1                   pop     de
 133++A078 C1                   pop     bc
 134++A079 F1                   pop     af
 135++A07A C9                   ret
