  5++ 64B2              ; ATM710 dual interface:
  6++ 64B2              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 64B2              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 64B2              ; The RTC data/control registers are never written by this driver.
  9++ 64B2              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 64B2              ;
 11++ 64B2              ; DS12887 registers used:
 12++ 64B2              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 64B2              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 64B2              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
