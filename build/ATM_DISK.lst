  1++ 620F              ; =========================================================================
  2++ 620F              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
  3++ 620F              ; Version: D1.07
  4++ 620F              ;
  5++ 620F              ; ATM710 dual interface:
  6++ 620F              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 620F              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 620F              ; The RTC data/control registers are never written by this driver.
  9++ 620F              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 620F              ;
 11++ 620F              ; DS12887 registers used:
 12++ 620F              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 620F              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 620F              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
 15++ 620F              ; =========================================================================
 16++ 620F
 17++ 620F              DS12887_PROBE:
 17++ 620F
 18++ 620F F5                   push    af
 19++ 6210 C5                   push    bc
 20++ 6211 D5                   push    de
 21++ 6212 E5                   push    hl
