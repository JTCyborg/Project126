  55++64BE CD 6E 65             call    DS12887_VALIDATE_STATUS
  56++64C1 DA D2 64             jp      c, ds12887_probe_invalid
  57++64C4
  58++64C4 3E 01                ld      a, 1
  59++64C6 32 A7 66             ld      (ds12887_available), a
  60++64C9
  61++64C9 CD D0 65             call    DS12887_READ_SNAPSHOT
  62++64CC DA D9 64             jp      c, ds12887_probe_read_error
  63++64CF
  64++64CF C3 DD 64             jp      ds12887_probe_done
  65++64D2
  66++64D2              ds12887_probe_invalid:
  67++64D2 AF                   xor     a
