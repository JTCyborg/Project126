 138++A07A 3E C6                ld      a,#C6
 139++A07C C3 2F 3D             jp      #3D2F
 140++A07F              p126_atm_restore_dosen_done:
 141++A07F C1                   pop     bc
 142++A080 F1                   pop     af
 143++A081 C9                   ret
