 177++6584              ; -------------------------------------------------------------------------
 178++6584              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++6584              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++6584              ; -------------------------------------------------------------------------
 181++6584              DS12887_OPEN:
 182++6584 F5                   push    af
 183++6585 C5                   push    bc
 184++6586 3A AA 66             ld      a, (ds12887_backend)
 185++6589 B7                   or      a
 186++658A 20 09                jr      nz, ds12887_open_smuc
 187++658C 01 F7 EF             ld      bc, #EFF7
 188++658F 3E 80                ld      a, #80
 189++6591 ED 79                out     (c), a
 190++6593 18 07                jr      ds12887_open_done
 191++6595              ds12887_open_smuc:
 192++6595                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++6595                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++6595                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++6595                      ; the SMUC multiplexed ISA address/control configuration and can
 196++6595                      ; interfere with later TR-DOS disk operations.
 197++6595 01 BA FF             ld      bc, #FFBA
 198++6598 3E 71                ld      a, #71
 199++659A ED 79                out     (c), a
 200++659C              ds12887_open_done:
 201++659C C1                   pop     bc
 202++659D F1                   pop     af
 203++659E C9                   ret
 204++659F
 205++659F              DS12887_CLOSE:
 206++659F F5                   push    af
 207++65A0 C5                   push    bc
 208++65A1 3A AA 66             ld      a, (ds12887_backend)
 209++65A4 B7                   or      a
 210++65A5 20 09                jr      nz, ds12887_close_done
 211++65A7 01 F7 EF             ld      bc, #EFF7
 212++65AA AF                   xor     a
 213++65AB ED 79                out     (c), a
 214++65AD                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
 215++65AD                      ; path established by p126_atm_video_init. RTC access is performed
 216++65AD                      ; after video initialization in Project126, so restore the documented
 217++65AD                      ; #0177 state and RG=6 text mode before returning to the host.
 218++65AD CD 7B A0             call    p126_atm_restore_dosen
 219++65B0              ds12887_close_done:
 220++65B0 C1                   pop     bc
 221++65B1 F1                   pop     af
 222++65B2 C9                   ret
