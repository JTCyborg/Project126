 177++656A              ; -------------------------------------------------------------------------
 178++656A              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++656A              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++656A              ; -------------------------------------------------------------------------
 181++656A              DS12887_OPEN:
 182++656A F5                   push    af
 183++656B C5                   push    bc
 184++656C 3A 90 66             ld      a, (ds12887_backend)
 185++656F B7                   or      a
