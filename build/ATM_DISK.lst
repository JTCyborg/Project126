 187++647E 01 F7 EF             ld      bc, #EFF7
 188++6481 3E 80                ld      a, #80
 189++6483 ED 79                out     (c), a
 190++6485 18 07                jr      ds12887_open_done
 191++6487              ds12887_open_smuc:
 192++6487                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++6487                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++6487                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++6487                      ; the SMUC multiplexed ISA address/control configuration and can
 196++6487                      ; interfere with later TR-DOS disk operations.
 197++6487 01 BA FF             ld      bc, #FFBA
 198++648A 3E 71                ld      a, #71
 199++648C ED 79                out     (c), a
