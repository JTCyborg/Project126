  75++64D6              ds12887_probe_done:
  76++64D6 CD 96 65             call    DS12887_CLOSE
  77++64D9 E1                   pop     hl
  78++64DA D1                   pop     de
  79++64DB C1                   pop     bc
  80++64DC F1                   pop     af
  81++64DD C9                   ret
  82++64DE
  83++64DE              ; -------------------------------------------------------------------------
  84++64DE              ; Public timestamp API.
  85++64DE              ; Output txt_hour/txt_min/txt_sec = two decimal ASCII digits.
  86++64DE              ; If DS12887 is unavailable or UIP never clears, outputs "??".
  87++64DE              ; AF/BC/DE/HL are preserved for the caller.
