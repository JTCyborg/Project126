# file opened: ds12887_rtc.asm
   1++6488              ; =========================================================================
   2++6488              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++6488              ; Version: D1.07
   4++6488              ;
   5++6488              ; ATM710 dual interface:
   6++6488              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++6488              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++6488              ; The RTC data/control registers are never written by this driver.
   9++6488              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++6488              ;
  11++6488              ; DS12887 registers used:
  12++6488              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++6488              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++6488              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15++6488              ; =========================================================================
  16++6488
  17++6488              DS12887_PROBE:
  17++6488
  18++6488 F5                   push    af
  19++6489 C5                   push    bc
  20++648A D5                   push    de
  21++648B E5                   push    hl
  22++648C
  23++648C                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++648C AF                   xor     a
  25++648D 32 A1 66             ld      (ds12887_backend), a
  26++6490 CD 7B 65             call    DS12887_OPEN
  27++6493 CD 32 65             call    DS12887_READ_STATUS
  28++6496                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++6496                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++6496 CD 67 65             call    DS12887_VALIDATE_STATUS
  31++6499 30 1C                jr      nc, ds12887_probe_status_ready
  32++649B
  33++649B                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++649B                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++649B CD 96 65             call    DS12887_CLOSE
  36++649E 3E 01                ld      a, 1
  37++64A0 32 A1 66             ld      (ds12887_backend), a
  38++64A3 CD 7B 65             call    DS12887_OPEN
  39++64A6 CD 32 65             call    DS12887_READ_STATUS
  40++64A9                      ; Read back the SMUC system port after selecting address mode.
  41++64A9                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42++64A9                      ; an FF readback therefore identifies a closed DOS-port gate.
  43++64A9 3A A1 66             ld      a, (ds12887_backend)
  44++64AC B7                   or      a
  45++64AD 28 08                jr      z, ds12887_probe_status_ready
  46++64AF                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47++64AF                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
  48++64AF                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
  49++64AF                      ; this is a useful decoder-presence test.
  50++64AF 01 BE 5F             ld      bc, #5FBE
  51++64B2 ED 78                in      a, (c)
  52++64B4 32 A2 66             ld      (ds12887_smuc_control), a
  53++64B7
  54++64B7              ds12887_probe_status_ready:
  55++64B7 CD 67 65             call    DS12887_VALIDATE_STATUS
  56++64BA DA CB 64             jp      c, ds12887_probe_invalid
  57++64BD
  58++64BD 3E 01                ld      a, 1
  59++64BF 32 A0 66             ld      (ds12887_available), a
  60++64C2
  61++64C2 CD C9 65             call    DS12887_READ_SNAPSHOT
  62++64C5 DA D2 64             jp      c, ds12887_probe_read_error
  63++64C8
  64++64C8 C3 D6 64             jp      ds12887_probe_done
  65++64CB
  66++64CB              ds12887_probe_invalid:
  67++64CB AF                   xor     a
  68++64CC 32 A0 66             ld      (ds12887_available), a
  69++64CF C3 D6 64             jp      ds12887_probe_done
  70++64D2
