 177++6476              ; -------------------------------------------------------------------------
 178++6476              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++6476              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++6476              ; -------------------------------------------------------------------------
 181++6476              DS12887_OPEN:
 182++6476 F5                   push    af
 183++6477 C5                   push    bc
 184++6478 3A 9C 65             ld      a, (ds12887_backend)
 185++647B B7                   or      a
