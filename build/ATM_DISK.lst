 325+ 63BF                      INCLUDE "atm_host/ds12887_rtc.asm"
# file opened: ds12887_rtc.asm
   1++63BF              ; =========================================================================
   2++63BF              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++63BF              ; Version: D1.07
   4++63BF              ;
   5++63BF              ; ATM710 dual interface:
   6++63BF              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++63BF              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++63BF              ; The RTC data/control registers are never written by this driver.
   9++63BF              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++63BF              ;
  11++63BF              ; DS12887 registers used:
  12++63BF              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++63BF              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++63BF              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15++63BF              ; =========================================================================
  16++63BF
  17++63BF              DS12887_PROBE:
  17++63BF
  18++63BF F5                   push    af
  19++63C0 C5                   push    bc
  20++63C1 D5                   push    de
  21++63C2 E5                   push    hl
  22++63C3
  23++63C3                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++63C3 AF                   xor     a
  25++63C4 32 D8 65             ld      (ds12887_backend), a
  26++63C7 CD B2 64             call    DS12887_OPEN
  27++63CA CD 69 64             call    DS12887_READ_STATUS
  28++63CD                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++63CD                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++63CD CD 9E 64             call    DS12887_VALIDATE_STATUS
  31++63D0 30 1C                jr      nc, ds12887_probe_status_ready
  32++63D2
  33++63D2                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++63D2                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++63D2 CD CD 64             call    DS12887_CLOSE
  36++63D5 3E 01                ld      a, 1
