285+  63DF                      INCLUDE "atm_host/ds12887_rtc.asm"
# file opened: ds12887_rtc.asm
  1++ 63DF              ; =========================================================================
  2++ 63DF              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
  3++ 63DF              ; Version: D1.07
  4++ 63DF              ;
  5++ 63DF              ; ATM710 dual interface:
  6++ 63DF              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 63DF              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 63DF              ; The RTC data/control registers are never written by this driver.
  9++ 63DF              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 63DF              ;
 11++ 63DF              ; DS12887 registers used:
 12++ 63DF              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 63DF              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 63DF              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
 15++ 63DF              ; =========================================================================
 16++ 63DF
 17++ 63DF              DS12887_PROBE:
 17++ 63DF
 18++ 63DF F5                   push    af
 19++ 63E0 C5                   push    bc
 20++ 63E1 D5                   push    de
 21++ 63E2 E5                   push    hl
 22++ 63E3
 23++ 63E3                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
 24++ 63E3 AF                   xor     a
 25++ 63E4 32 F5 65             ld      (ds12887_backend), a
 26++ 63E7 CD D2 64             call    DS12887_OPEN
 27++ 63EA CD 89 64             call    DS12887_READ_STATUS
 28++ 63ED                      ; A floating/unimplemented port often reads FF. A valid DS12887
 29++ 63ED                      ; has Status D exactly 80h and Status A divider bits 010b.
 30++ 63ED CD BE 64             call    DS12887_VALIDATE_STATUS
 31++ 63F0 30 1C                jr      nc, ds12887_probe_status_ready
 32++ 63F2
 33++ 63F2                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
 34++ 63F2                      ; Retry through the SMUC DFBA/FFBA index/data interface.
 35++ 63F2 CD ED 64             call    DS12887_CLOSE
 36++ 63F5 3E 01                ld      a, 1
 37++ 63F7 32 F5 65             ld      (ds12887_backend), a
 38++ 63FA CD D2 64             call    DS12887_OPEN
 39++ 63FD CD 89 64             call    DS12887_READ_STATUS
 40++ 6400                      ; Read back the SMUC system port after selecting address mode.
