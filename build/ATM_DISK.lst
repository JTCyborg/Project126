# file closed: p126_bios_loader.asm
 330+ 84E0
 331+ 84E0              ; Project125-derived ATM-native text console, relocated to window 2.
 332+ 84E0              ; Its renderer maps video pages only for each write and restores host pages.
 333+ 84E0                      PAGE 0
 334+ 84E0                      ORG #A000
 335+ A000                      INCLUDE "atm_host/p126_screen_console.asm"
# file opened: p126_screen_console.asm
   1++A000              ; =========================================================================
   2++A000              ; PROJECT126 — ATM TURBO 2+ native 80x25 text console
   3++A000              ;
   4++A000              ; This module is deliberately placed at #A000 in window 2. The host program
   5++A000              ; is loaded at #6000 in physical page 5; the ATM text screen uses the
   6++A000              ; alternate screen pair page 7/page 3 selected by bit 3 of port #7FFD.
   7++A000              ;
   8++A000              ; The renderer temporarily maps page 7 to #4000 and page 3 to #C000, writes
   9++A000              ; the character/attribute, then restores page 5/page 0 before returning to
  10++A000              ; the caller. Code at #6000 and the TR-DOS #C000 staging buffer are preserved.
  11++A000              ;
  12++A000              ; Text layout follows the tested Project112 ATM 80x25 renderer:
  13++A000              ;   offset = #01C0 + row*64 + column/2
  14++A000              ;   character even: page 7, #4000+offset
  15++A000              ;   character odd : page 7, #6000+offset
  16++A000              ;   attribute even: page 3, #E000+offset
  17++A000              ;   attribute odd : page 3, #C000+offset+1
  18++A000              ; =========================================================================
  19++A000
  20++A000              BIOS_DEBUG_COLUMNS EQU 80
  21++A000              BIOS_DEBUG_ROWS    EQU 13
  22++A000              BIOS_DEBUG_TOP     EQU 12
  23++A000              P126_VIDEO_PAGE7   EQU #78          ; RAM page 7, inverted page number
  24++A000              P126_VIDEO_PAGE3   EQU #7C          ; RAM page 3, inverted page number
  25++A000              P126_HOST_PAGE5    EQU #7A          ; RAM page 5, host code at #6000
  26++A000              P126_HOST_PAGE0    EQU #7F          ; RAM page 0, TR-DOS staging at #C000
  27++A000
  28++A000 00           Console_X: db 0
  29++A001 0C           Console_Y: db BIOS_DEBUG_TOP
  30++A002
  31++A002              ; =========================================================================
  32++A002              ; ATM shadow-port and text-mode initialization.
  33++A002              ; The TR-DOS ROM trampoline must run before any #7FF7/#FFF7/#0177 access.
  34++A002              ; =========================================================================
  35++A002              p126_atm_video_init:
  35++A002
  36++A002 F5                   push    af
  37++A003 C5                   push    bc
  38++A004 D5                   push    de
  39++A005 E5                   push    hl
  40++A006
  41++A006                      ; Reset the ATM paging/control latch BEFORE enabling permanent
  42++A006                      ; DOSEN. On this board #EFF7 is part of the ATM paging control path;
  43++A006                      ; resetting it after the #0177 shadow-port setup can undo the state
  44++A006                      ; needed by the TR-DOS overlay.
  45++A006 AF                   xor     a
  46++A007 01 F7 EF             ld      bc, #EFF7
  47++A00A ED 79                out     (c), a
  48++A00C
  49++A00C                      ; ROM2=1 (D4) is required for TR-DOS overlay; D3 selects alternate
  50++A00C                      ; video pages 7/3. This is #18, matching the host display setup.
  51++A00C 3E 18                ld      a, #18
  52++A00E 01 FD 7F             ld      bc, #7FFD
  53++A011 ED 79                out     (c), a
  54++A013 32 3B 5C             ld      (#5C3B), a
  55++A016
  56++A016                      ; Open shadow ports and hold DOSEN permanently (A9=0) using the
  57++A016                      ; documented TR-DOS ROM trampoline. Do this AFTER the paging reset.
  58++A016 01 26 A0             ld      bc, p126_atm_ports_open_done
  59++A019 C5                   push    bc
  60++A01A 01 53 2A             ld      bc, #2A53
  61++A01D C5                   push    bc
  62++A01E 01 77 01             ld      bc, #0177
  63++A021 3E C3                ld      a, #C3
  64++A023 C3 2F 3D             jp      #3D2F
  65++A026
  66++A026              p126_atm_ports_open_done:
  67++A026                      ; Window 0 must use ROM with D7=1 so its ROM page selection is
  68++A026                      ; coupled to ROM2/DOSEN. #BF selects the low ROM page with the
  69++A026                      ; DOSEN-controlled low ROM select: BASIC-48 when DOSEN=0, TR-DOS
  70++A026                      ; when DOSEN=1. This is the ATM2+ documented auto-TR-DOS mapping.
  71++A026 3E BF                ld      a, #BF
  72++A028 01 F7 3F             ld      bc, #3FF7
  73++A02B ED 79                out     (c), a
  74++A02D
  75++A02D
  76++A02D                      ; Map the alternate screen pages while the 32-byte mode trampoline
  77++A02D                      ; is installed at #FFEC. Window 3 uses a fixed RAM page here; the
  78++A02D                      ; TR-DOS auto-select mux is configured separately in window 0.
  79++A02D 3E 78                ld      a, P126_VIDEO_PAGE7
  80++A02F 01 F7 7F             ld      bc, #7FF7
  81++A032 ED 79                out     (c), a
  82++A034 3E 7C                ld      a, P126_VIDEO_PAGE3
  83++A036 01 F7 FF             ld      bc, #FFF7
  84++A039 ED 79                out     (c), a
  85++A03B
  86++A03B                      ; LD BC,#0177 / OUT (C),A / JP p126_atm_video_mode_ready
  87++A03B 21 EC FF             ld      hl, #FFEC
  88++A03E 36 01                ld      (hl), #01
  89++A040 23                   inc     hl
  90++A041 36 77                ld      (hl), #77
  91++A043 23                   inc     hl
  92++A044 36 01                ld      (hl), #01
  93++A046 23                   inc     hl
  94++A047 36 ED                ld      (hl), #ED
  95++A049 23                   inc     hl
  96++A04A 36 79                ld      (hl), #79
  97++A04C 23                   inc     hl
  98++A04D 36 C3                ld      (hl), #C3
  99++A04F 23                   inc     hl
 100++A050 36 5A                ld      (hl), p126_atm_video_mode_ready & #FF
 101++A052 23                   inc     hl
 102++A053 36 A0                ld      (hl), p126_atm_video_mode_ready >> 8
 103++A055
 104++A055                      ; ATM Turbo 2+ RG=6: hardware text 80x25.
 105++A055 3E C6                ld      a, #C6
 106++A057 C3 EC FF             jp      #FFEC
 107++A05A
 108++A05A              p126_atm_video_mode_ready:
 109++A05A                      ; Restore CPU-visible host/staging pages. Keep D7 clear on #FFF7 so
 110++A05A                      ; window 3 remains fixed to RAM page 0 for the TR-DOS staging buffer.
 111++A05A 3E 7A                ld      a, P126_HOST_PAGE5
 112++A05C 01 F7 7F             ld      bc, #7FF7
 113++A05F ED 79                out     (c), a
 114++A061 3E 7F                ld      a, P126_HOST_PAGE0
 115++A063 01 F7 FF             ld      bc, #FFF7
 116++A066 ED 79                out     (c), a
 117++A068
 118++A068 E1                   pop     hl
 119++A069 D1                   pop     de
 120++A06A C1                   pop     bc
 121++A06B F1                   pop     af
 122++A06C C9                   ret
 123++A06D
 124++A06D              ; Reopen the permanent ATM shadow-port/DOSEN state after an RTC access.
 125++A06D              ; DS12887_OPEN/CLOSE uses #EFF7, whose A9=1 write closes the permanent
 126++A06D              ; DOSEN path. Re-enter #3Dxx, execute OUT (C),A from the TR-DOS ROM, and
 127++A06D              ; write #C6 to #0177: A9=0 keeps shadow ports/DOSEN active and RG=6 restores
 128++A06D              ; the fixed ATM 80x25 text mode. ROM2 and WIN0 selector #3FF7=#BF must remain
 129++A06D              ; configured by p126_atm_video_init.
 130++A06D              p126_atm_restore_dosen:
 130++A06D
 131++A06D F5                   push    af
 132++A06E C5                   push    bc
 133++A06F 01 7F A0             ld      bc,p126_atm_restore_dosen_done
 134++A072 C5                   push    bc
 135++A073 01 53 2A             ld      bc,#2A53
 136++A076 C5                   push    bc
 137++A077 01 77 01             ld      bc,#0177
 138++A07A 3E C6                ld      a,#C6
 139++A07C C3 2F 3D             jp      #3D2F
 140++A07F              p126_atm_restore_dosen_done:
 141++A07F C1                   pop     bc
 142++A080 F1                   pop     af
 143++A081 C9                   ret
 144++A082
 145++A082              ; =========================================================================
 146++A082              ; Screen initialization and static Project124-style two-zone workspace.
 147++A082              ; The upper 12 rows are the status panel; the lower 13 rows are the log.
 148++A082              ; =========================================================================
 149++A082              BIOS_DebugConsole_Init:
 149++A082
 150++A082 AF                   xor     a
 151++A083 32 85 A4             ld      (bios_dbg_row), a
 152++A086 32 86 A4             ld      (bios_dbg_col), a
 153++A089 32 00 A0             ld      (Console_X), a
 154++A08C 3E 0C                ld      a, BIOS_DEBUG_TOP
 155++A08E 32 01 A0             ld      (Console_Y), a
 156++A091 C9                   ret
 157++A092
 158++A092              BIOS_DebugConsole_Clear:
 158++A092
 159++A092 F5                   push    af
 160++A093 C5                   push    bc
 161++A094 D5                   push    de
 162++A095 E5                   push    hl
 163++A096 CD 31 A3             call    p126_screen_map_video_pages
 164++A099
 165++A099                      ; Clear 25 rows x 64-byte stride in both character parity planes.
 166++A099 21 C0 41             ld      hl, #41C0
 167++A09C 11 C1 41             ld      de, #41C1
 168++A09F 36 20                ld      (hl), 32
 169++A0A1 01 3F 06             ld      bc, #063F
 170++A0A4 ED B0                ldir
