  25++66B4              ; Driver result convention:
  26++66B4              ;   Carry clear = operation completed.
  27++66B4              ;   Carry set   = timeout.
  28++66B4              ;   A           = last observed GSSTAT on timeout / final status on wait.
  29++66B4              ;   p126_ipc_last_status always contains the last sampled GSSTAT byte.
  30++66B4
