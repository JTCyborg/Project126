  8++ 6142              ; The RTC data/control registers are never written by this driver.
  9++ 6142              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 6142              ;
 11++ 6142              ; DS12887 registers used:
 12++ 6142              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 6142              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 6142              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
