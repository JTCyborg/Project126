 46++ 64C8                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
 47++ 64C8                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
 48++ 64C8                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
 49++ 64C8                      ; this is a useful decoder-presence test.
 50++ 64C8 01 BE 5F             ld      bc, #5FBE
