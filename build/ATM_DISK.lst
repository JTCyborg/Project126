304+  6391                      INCLUDE "atm_host/ds12887_rtc.asm"
# file opened: ds12887_rtc.asm
  1++ 6391              ; =========================================================================
  2++ 6391              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
  3++ 6391              ; Version: D1.07
  4++ 6391              ;
  5++ 6391              ; ATM710 dual interface:
  6++ 6391              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 6391              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 6391              ; The RTC data/control registers are never written by this driver.
  9++ 6391              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 6391              ;
 11++ 6391              ; DS12887 registers used:
 12++ 6391              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 6391              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 6391              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
 15++ 6391              ; =========================================================================
 16++ 6391
 17++ 6391              DS12887_PROBE:
 17++ 6391
 18++ 6391 F5                   push    af
 19++ 6392 C5                   push    bc
 20++ 6393 D5                   push    de
 21++ 6394 E5                   push    hl
 22++ 6395
 23++ 6395                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
 24++ 6395 AF                   xor     a
 25++ 6396 32 AA 65             ld      (ds12887_backend), a
 26++ 6399 CD 84 64             call    DS12887_OPEN
 27++ 639C CD 3B 64             call    DS12887_READ_STATUS
 28++ 639F                      ; A floating/unimplemented port often reads FF. A valid DS12887
 29++ 639F                      ; has Status D exactly 80h and Status A divider bits 010b.
 30++ 639F CD 70 64             call    DS12887_VALIDATE_STATUS
 31++ 63A2 30 1C                jr      nc, ds12887_probe_status_ready
 32++ 63A4
 33++ 63A4                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
 34++ 63A4                      ; Retry through the SMUC DFBA/FFBA index/data interface.
 35++ 63A4 CD 9F 64             call    DS12887_CLOSE
 36++ 63A7 3E 01                ld      a, 1
 37++ 63A9 32 AA 65             ld      (ds12887_backend), a
 38++ 63AC CD 84 64             call    DS12887_OPEN
 39++ 63AF CD 3B 64             call    DS12887_READ_STATUS
 40++ 63B2                      ; Read back the SMUC system port after selecting address mode.
 41++ 63B2                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
 42++ 63B2                      ; an FF readback therefore identifies a closed DOS-port gate.
 43++ 63B2 3A AA 65             ld      a, (ds12887_backend)
 44++ 63B5 B7                   or      a
