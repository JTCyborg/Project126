  25++66B2              ; Driver result convention:
  26++66B2              ;   Carry clear = operation completed.
  27++66B2              ;   Carry set   = timeout.
  28++66B2              ;   A           = last observed GSSTAT on timeout / final status on wait.
  29++66B2              ;   p126_ipc_last_status always contains the last sampled GSSTAT byte.
  30++66B2
  31++66B2              ; Public entry points (see docs/ATM_HOST_INTERFACE.md):
  32++66B2              ;   p126_ipc_read_status
  33++66B2              ;   p126_ipc_wait_cbit_clear
  34++66B2              ;   p126_ipc_wait_dbit_clear
  35++66B2              ;   p126_ipc_wait_dbit_set
  36++66B2              ;   p126_ipc_send_command       A=command
  37++66B2              ;   p126_ipc_send_argument      A=argument; preloads GSDAT before GSCOM
  38++66B2              ;   p126_ipc_send_byte          A=data; waits for consumption
  39++66B2              ;   p126_ipc_receive_byte       returns A=data
  40++66B2              ;   p126_ipc_emit_version
  41++66B2              ;   p126_ipc_validate_frame HL=frame, BC=size; carry/A=status
  42++66B2              ;   p126_ipc_dma_send_frame HL=frame, BC=size; carry/A=status
  43++66B2              ;   p126_ipc_dma_receive_test returns carry clear only after reverse-DMA CRC/pattern PASS
  44++66B2              ; ABI 1.0 constants are imported from shared/p126_ipc_protocol.inc.
  45++66B2
  46++66B2              P126_IPC_TIMEOUT    EQU #FFFF
