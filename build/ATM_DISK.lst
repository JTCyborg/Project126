  32++66B4              ;   p126_ipc_read_status
  33++66B4              ;   p126_ipc_wait_cbit_clear
  34++66B4              ;   p126_ipc_wait_dbit_clear
  35++66B4              ;   p126_ipc_wait_dbit_set
  36++66B4              ;   p126_ipc_send_command       A=command
  37++66B4              ;   p126_ipc_send_argument      A=argument; preloads GSDAT before GSCOM
  38++66B4              ;   p126_ipc_send_byte          A=data; waits for consumption
  39++66B4              ;   p126_ipc_receive_byte       returns A=data
  40++66B4              ;   p126_ipc_emit_version
  41++66B4              ;   p126_ipc_validate_frame HL=frame, BC=size; carry/A=status
  42++66B4              ;   p126_ipc_dma_send_frame HL=frame, BC=size; carry/A=status
  43++66B4              ;   p126_ipc_dma_receive_test returns carry clear only after reverse-DMA CRC/pattern PASS
  44++66B4              ; ABI 1.0 constants are imported from shared/p126_ipc_protocol.inc.
  45++66B4
