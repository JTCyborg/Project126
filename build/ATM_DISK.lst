  30++75B7                      ; The build deliberately permits a full 256-byte ROM #14 block.
  31++75B7                      ; Accept lengths 1..255 and exactly 256 (0100h); reject 0 and >256.
  32++75B7 2A 84 7F             ld      hl,(p126_neogs_file_length)
  33++75BA 7C                   ld      a,h
  34++75BB B7                   or      a
  35++75BC 28 0C                jr      z,.p126_neogs_boot_length_low
