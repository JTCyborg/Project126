# file opened: ds12887_rtc.asm
  1++ 6374              ; =========================================================================
  2++ 6374              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
  3++ 6374              ; Version: D1.07
  4++ 6374              ;
  5++ 6374              ; ATM710 dual interface:
  6++ 6374              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 6374              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 6374              ; The RTC data/control registers are never written by this driver.
  9++ 6374              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 6374              ;
 11++ 6374              ; DS12887 registers used:
 12++ 6374              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 6374              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 6374              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
 15++ 6374              ; =========================================================================
 16++ 6374
 17++ 6374              DS12887_PROBE:
 17++ 6374
 18++ 6374 F5                   push    af
 19++ 6375 C5                   push    bc
 20++ 6376 D5                   push    de
 21++ 6377 E5                   push    hl
 22++ 6378
 23++ 6378                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
 24++ 6378 AF                   xor     a
 25++ 6379 32 8A 65             ld      (ds12887_backend), a
 26++ 637C CD 67 64             call    DS12887_OPEN
 27++ 637F CD 1E 64             call    DS12887_READ_STATUS
 28++ 6382                      ; A floating/unimplemented port often reads FF. A valid DS12887
 29++ 6382                      ; has Status D exactly 80h and Status A divider bits 010b.
 30++ 6382 CD 53 64             call    DS12887_VALIDATE_STATUS
 31++ 6385 30 1C                jr      nc, ds12887_probe_status_ready
 32++ 6387
 33++ 6387                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
 34++ 6387                      ; Retry through the SMUC DFBA/FFBA index/data interface.
 35++ 6387 CD 82 64             call    DS12887_CLOSE
 36++ 638A 3E 01                ld      a, 1
 37++ 638C 32 8A 65             ld      (ds12887_backend), a
 38++ 638F CD 67 64             call    DS12887_OPEN
 39++ 6392 CD 1E 64             call    DS12887_READ_STATUS
 40++ 6395                      ; Read back the SMUC system port after selecting address mode.
 41++ 6395                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
 42++ 6395                      ; an FF readback therefore identifies a closed DOS-port gate.
 43++ 6395 3A 8A 65             ld      a, (ds12887_backend)
 44++ 6398 B7                   or      a
 45++ 6399 28 08                jr      z, ds12887_probe_status_ready
 46++ 639B                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
 47++ 639B                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
 48++ 639B                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
 49++ 639B                      ; this is a useful decoder-presence test.
 50++ 639B 01 BE 5F             ld      bc, #5FBE
 51++ 639E ED 78                in      a, (c)
 52++ 63A0 32 8B 65             ld      (ds12887_smuc_control), a
 53++ 63A3
 54++ 63A3              ds12887_probe_status_ready:
 55++ 63A3 CD 53 64             call    DS12887_VALIDATE_STATUS
 56++ 63A6 DA B7 63             jp      c, ds12887_probe_invalid
 57++ 63A9
 58++ 63A9 3E 01                ld      a, 1
 59++ 63AB 32 89 65             ld      (ds12887_available), a
 60++ 63AE
 61++ 63AE CD B2 64             call    DS12887_READ_SNAPSHOT
 62++ 63B1 DA BE 63             jp      c, ds12887_probe_read_error
 63++ 63B4
 64++ 63B4 C3 C2 63             jp      ds12887_probe_done
 65++ 63B7
 66++ 63B7              ds12887_probe_invalid:
 67++ 63B7 AF                   xor     a
 68++ 63B8 32 89 65             ld      (ds12887_available), a
 69++ 63BB C3 C2 63             jp      ds12887_probe_done
 70++ 63BE
 71++ 63BE              ds12887_probe_read_error:
 72++ 63BE AF                   xor     a
 73++ 63BF 32 89 65             ld      (ds12887_available), a
 74++ 63C2
 75++ 63C2              ds12887_probe_done:
 76++ 63C2 CD 82 64             call    DS12887_CLOSE
 77++ 63C5 E1                   pop     hl
 78++ 63C6 D1                   pop     de
 79++ 63C7 C1                   pop     bc
 80++ 63C8 F1                   pop     af
 81++ 63C9 C9                   ret
 82++ 63CA
 83++ 63CA              ; -------------------------------------------------------------------------
 84++ 63CA              ; Public timestamp API.
 85++ 63CA              ; Output txt_hour/txt_min/txt_sec = two decimal ASCII digits.
 86++ 63CA              ; If DS12887 is unavailable or UIP never clears, outputs "??".
 87++ 63CA              ; AF/BC/DE/HL are preserved for the caller.
 88++ 63CA              ; -------------------------------------------------------------------------
 89++ 63CA              READ_CURRENT_TIME:
 89++ 63CA
 90++ 63CA F5                   push    af
 91++ 63CB C5                   push    bc
 92++ 63CC D5                   push    de
 93++ 63CD E5                   push    hl
 94++ 63CE
