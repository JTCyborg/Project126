# file opened: ds12887_rtc.asm
   1++63BD              ; =========================================================================
   2++63BD              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++63BD              ; Version: D1.07
   4++63BD              ;
   5++63BD              ; ATM710 dual interface:
   6++63BD              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++63BD              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++63BD              ; The RTC data/control registers are never written by this driver.
   9++63BD              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++63BD              ;
  11++63BD              ; DS12887 registers used:
  12++63BD              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++63BD              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++63BD              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15++63BD              ; =========================================================================
  16++63BD
  17++63BD              DS12887_PROBE:
  17++63BD
  18++63BD F5                   push    af
  19++63BE C5                   push    bc
  20++63BF D5                   push    de
  21++63C0 E5                   push    hl
  22++63C1
  23++63C1                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++63C1 AF                   xor     a
  25++63C2 32 D6 65             ld      (ds12887_backend), a
  26++63C5 CD B0 64             call    DS12887_OPEN
  27++63C8 CD 67 64             call    DS12887_READ_STATUS
  28++63CB                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++63CB                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++63CB CD 9C 64             call    DS12887_VALIDATE_STATUS
  31++63CE 30 1C                jr      nc, ds12887_probe_status_ready
  32++63D0
  33++63D0                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++63D0                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++63D0 CD CB 64             call    DS12887_CLOSE
  36++63D3 3E 01                ld      a, 1
