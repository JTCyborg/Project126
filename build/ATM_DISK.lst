  1++ 72C2              ; =========================================================================
  2++ 72C2              ; PROJECT126 — ATM host NeoGS bootstrap/firmware loader
  3++ 72C2              ; Runs before ATM video paging is enabled. TR-DOS sector reads use the same
  4++ 72C2              ; C=5/B=1 ABI already validated by p126_catalog_read_disk.
  5++ 72C2              ; =========================================================================
  6++ 72C2              P126_NGS_GSCOM EQU #BB
  7++ 72C2              P126_NGS_GSSTAT EQU #BB
  8++ 72C2              P126_NGS_GSDAT EQU #B3
  9++ 72C2              P126_NGS_GSCTR EQU #33
 10++ 72C2              P126_NGS_CBIT EQU 0
 11++ 72C2              P126_NGS_DBIT EQU 7
 12++ 72C2              P126_NGS_CMD_RAM EQU #20
 13++ 72C2              P126_NGS_CMD_JUMP EQU #13
 14++ 72C2              P126_NGS_CMD_RECV EQU #14
 15++ 72C2              P126_NGS_ACK_READY EQU #A1
 16++ 72C2              P126_NGS_ACK_LENGTH EQU #A3
 17++ 72C2              P126_NGS_ACK_DONE EQU #A2
 18++ 72C2              P126_NGS_TIMEOUT EQU #FFFF
 19++ 72C2
 20++ 72C2              ; Called after directory preload and before ATM video initialization.
 21++ 72C2              ; Carry clear means the resident image sent its A2h ready acknowledgement.
 22++ 72C2              p126_neogs_startup:
 22++ 72C2
 23++ 72C2 3E 31                ld      a,'1'
 24++ 72C4 32 97 76             ld      (p126_neogs_startup_stage),a
