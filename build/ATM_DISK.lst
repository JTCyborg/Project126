  19++6492 C5                   push    bc
  20++6493 D5                   push    de
  21++6494 E5                   push    hl
  22++6495
  23++6495                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++6495 AF                   xor     a
  25++6496 32 AA 66             ld      (ds12887_backend), a
  26++6499 CD 84 65             call    DS12887_OPEN
  27++649C CD 3B 65             call    DS12887_READ_STATUS
  28++649F                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++649F                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++649F CD 70 65             call    DS12887_VALIDATE_STATUS
  31++64A2 30 1C                jr      nc, ds12887_probe_status_ready
  32++64A4
  33++64A4                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++64A4                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++64A4 CD 9F 65             call    DS12887_CLOSE
  36++64A7 3E 01                ld      a, 1
  37++64A9 32 AA 66             ld      (ds12887_backend), a
  38++64AC CD 84 65             call    DS12887_OPEN
  39++64AF CD 3B 65             call    DS12887_READ_STATUS
  40++64B2                      ; Read back the SMUC system port after selecting address mode.
  41++64B2                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42++64B2                      ; an FF readback therefore identifies a closed DOS-port gate.
  43++64B2 3A AA 66             ld      a, (ds12887_backend)
  44++64B5 B7                   or      a
  45++64B6 28 08                jr      z, ds12887_probe_status_ready
  46++64B8                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47++64B8                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
  48++64B8                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
  49++64B8                      ; this is a useful decoder-presence test.
  50++64B8 01 BE 5F             ld      bc, #5FBE
  51++64BB ED 78                in      a, (c)
  52++64BD 32 AB 66             ld      (ds12887_smuc_control), a
