 191++64C3              ds12887_open_smuc:
 192++64C3                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++64C3                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++64C3                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++64C3                      ; the SMUC multiplexed ISA address/control configuration and can
 196++64C3                      ; interfere with later TR-DOS disk operations.
 197++64C3 01 BA FF             ld      bc, #FFBA
 198++64C6 3E 71                ld      a, #71
