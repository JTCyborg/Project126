  1   0000              ; =========================================================================
  2   0000              ; PROJECT126 — TR-DOS disk image assembly
  3   0000              ; Version: P126_TRDOS_IMAGE v0.1.0
  4   0000              ;
  5   0000              ; Produces disk_A.trd containing:
  6   0000              ;   BOOT.B     BASIC boot loader
  7   0000              ;   PROJ126.C  ATM host program
  8   0000              ;   X86CORE.C  current NeoGS x86 CPU-state/ALU module image
  9   0000              ;
 10   0000              ; The x86 module is packaged as a disk file, but is not yet auto-uploaded:
 11   0000              ; the NeoGS resident command receiver/startup protocol is not implemented.
 12   0000              ; =========================================================================
 13   0000
 14   0000                      DEVICE ZXSPECTRUM128
 15   0000                      EMPTYTRD "disk_A.trd"
 16   0000
 17   0000              ; -------------------------------------------------------------------------
 18   0000              ; ATM resident program, loaded by boot.B at 6000h.
 19   0000              ; -------------------------------------------------------------------------
 20   0000                      PAGE 0
 21   0000                      ORG P126_HOST_LOAD_ADDRESS
 22   6000                      INCLUDE "atm_host/project126_main.asm"
