 201++659A C1                   pop     bc
 202++659B F1                   pop     af
 203++659C C9                   ret
 204++659D
 205++659D              DS12887_CLOSE:
 206++659D F5                   push    af
 207++659E C5                   push    bc
 208++659F 3A A8 66             ld      a, (ds12887_backend)
 209++65A2 B7                   or      a
 210++65A3 20 09                jr      nz, ds12887_close_done
 211++65A5 01 F7 EF             ld      bc, #EFF7
 212++65A8 AF                   xor     a
 213++65A9 ED 79                out     (c), a
 214++65AB                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
