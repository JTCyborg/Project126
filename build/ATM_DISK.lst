 172++A0A9 11 C1 61             ld      de, #61C1
 173++A0AC 36 20                ld      (hl), 32
 174++A0AE 01 3F 06             ld      bc, #063F
 175++A0B1 ED B0                ldir
 176++A0B3
 177++A0B3                      ; Default attributes, then color the status panel blue/white.
 178++A0B3 21 C0 E1             ld      hl, #E1C0
 179++A0B6 11 C1 E1             ld      de, #E1C1
 180++A0B9 36 47                ld      (hl), #47
 181++A0BB 01 3F 06             ld      bc, #063F
 182++A0BE ED B0                ldir
 183++A0C0 21 C1 C1             ld      hl, #C1C1
 184++A0C3 11 C2 C1             ld      de, #C1C2
 185++A0C6 36 47                ld      (hl), #47
 186++A0C8 01 3F 06             ld      bc, #063F
 187++A0CB ED B0                ldir
 188++A0CD
 189++A0CD 21 C0 E1             ld      hl, #E1C0
 190++A0D0 11 C1 E1             ld      de, #E1C1
 191++A0D3 36 4F                ld      (hl), #4F
 192++A0D5 01 FF 02             ld      bc, #02FF
 193++A0D8 ED B0                ldir
 194++A0DA 21 C1 C1             ld      hl, #C1C1
 195++A0DD 11 C2 C1             ld      de, #C1C2
 196++A0E0 36 4F                ld      (hl), #4F
 197++A0E2 01 FF 02             ld      bc, #02FF
 198++A0E5 ED B0                ldir
 199++A0E7
 200++A0E7                      ; Lower log area: black background, green foreground.
 201++A0E7 21 C0 E4             ld      hl, #E4C0
 202++A0EA 11 C1 E4             ld      de, #E4C1
 203++A0ED 36 44                ld      (hl), #44
 204++A0EF 01 3F 03             ld      bc, #033F
 205++A0F2 ED B0                ldir
 206++A0F4 21 C1 C4             ld      hl, #C4C1
 207++A0F7 11 C2 C4             ld      de, #C4C2
 208++A0FA 36 44                ld      (hl), #44
 209++A0FC 01 3F 03             ld      bc, #033F
 210++A0FF ED B0                ldir
