 201++658D C1                   pop     bc
 202++658E F1                   pop     af
 203++658F C9                   ret
 204++6590
 205++6590              DS12887_CLOSE:
 206++6590 F5                   push    af
 207++6591 C5                   push    bc
 208++6592 3A 9B 66             ld      a, (ds12887_backend)
 209++6595 B7                   or      a
 210++6596 20 09                jr      nz, ds12887_close_done
 211++6598 01 F7 EF             ld      bc, #EFF7
 212++659B AF                   xor     a
 213++659C ED 79                out     (c), a
 214++659E                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
 215++659E                      ; path established by p126_atm_video_init. RTC access is performed
 216++659E                      ; after video initialization in Project126, so restore the documented
 217++659E                      ; #0177 state and RG=6 text mode before returning to the host.
 218++659E CD 7B A0             call    p126_atm_restore_dosen
