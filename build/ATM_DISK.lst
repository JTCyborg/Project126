   1++6482              ; =========================================================================
   2++6482              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++6482              ; Version: D1.07
   4++6482              ;
   5++6482              ; ATM710 dual interface:
   6++6482              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++6482              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++6482              ; The RTC data/control registers are never written by this driver.
   9++6482              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++6482              ;
  11++6482              ; DS12887 registers used:
  12++6482              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++6482              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++6482              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15++6482              ; =========================================================================
  16++6482
  17++6482              DS12887_PROBE:
  17++6482
  18++6482 F5                   push    af
  19++6483 C5                   push    bc
  20++6484 D5                   push    de
  21++6485 E5                   push    hl
  22++6486
  23++6486                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++6486 AF                   xor     a
  25++6487 32 9B 66             ld      (ds12887_backend), a
  26++648A CD 75 65             call    DS12887_OPEN
  27++648D CD 2C 65             call    DS12887_READ_STATUS
  28++6490                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++6490                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++6490 CD 61 65             call    DS12887_VALIDATE_STATUS
  31++6493 30 1C                jr      nc, ds12887_probe_status_ready
  32++6495
  33++6495                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++6495                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++6495 CD 90 65             call    DS12887_CLOSE
  36++6498 3E 01                ld      a, 1
  37++649A 32 9B 66             ld      (ds12887_backend), a
  38++649D CD 75 65             call    DS12887_OPEN
  39++64A0 CD 2C 65             call    DS12887_READ_STATUS
  40++64A3                      ; Read back the SMUC system port after selecting address mode.
  41++64A3                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42++64A3                      ; an FF readback therefore identifies a closed DOS-port gate.
  43++64A3 3A 9B 66             ld      a, (ds12887_backend)
  44++64A6 B7                   or      a
  45++64A7 28 08                jr      z, ds12887_probe_status_ready
  46++64A9                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47++64A9                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
  48++64A9                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
  49++64A9                      ; this is a useful decoder-presence test.
  50++64A9 01 BE 5F             ld      bc, #5FBE
  51++64AC ED 78                in      a, (c)
  52++64AE 32 9C 66             ld      (ds12887_smuc_control), a
