 191++6593              ds12887_open_smuc:
 192++6593                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++6593                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++6593                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++6593                      ; the SMUC multiplexed ISA address/control configuration and can
 196++6593                      ; interfere with later TR-DOS disk operations.
 197++6593 01 BA FF             ld      bc, #FFBA
