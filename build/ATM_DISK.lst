 40++ 6480                      ; Read back the SMUC system port after selecting address mode.
 41++ 6480                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
 42++ 6480                      ; an FF readback therefore identifies a closed DOS-port gate.
 43++ 6480 3A 75 66             ld      a, (ds12887_backend)
