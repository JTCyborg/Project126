 205++657F              DS12887_CLOSE:
 206++657F F5                   push    af
 207++6580 C5                   push    bc
 208++6581 3A 8A 66             ld      a, (ds12887_backend)
 209++6584 B7                   or      a
 210++6585 20 09                jr      nz, ds12887_close_done
 211++6587 01 F7 EF             ld      bc, #EFF7
