 177++657B              ; -------------------------------------------------------------------------
 178++657B              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++657B              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++657B              ; -------------------------------------------------------------------------
 181++657B              DS12887_OPEN:
 182++657B F5                   push    af
 183++657C C5                   push    bc
 184++657D 3A A1 66             ld      a, (ds12887_backend)
 185++6580 B7                   or      a
 186++6581 20 09                jr      nz, ds12887_open_smuc
 187++6583 01 F7 EF             ld      bc, #EFF7
 188++6586 3E 80                ld      a, #80
 189++6588 ED 79                out     (c), a
 190++658A 18 07                jr      ds12887_open_done
 191++658C              ds12887_open_smuc:
 192++658C                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++658C                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++658C                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++658C                      ; the SMUC multiplexed ISA address/control configuration and can
 196++658C                      ; interfere with later TR-DOS disk operations.
 197++658C 01 BA FF             ld      bc, #FFBA
 198++658F 3E 71                ld      a, #71
 199++6591 ED 79                out     (c), a
 200++6593              ds12887_open_done:
 201++6593 C1                   pop     bc
 202++6594 F1                   pop     af
 203++6595 C9                   ret
 204++6596
 205++6596              DS12887_CLOSE:
 206++6596 F5                   push    af
 207++6597 C5                   push    bc
 208++6598 3A A1 66             ld      a, (ds12887_backend)
 209++659B B7                   or      a
 210++659C 20 09                jr      nz, ds12887_close_done
 211++659E 01 F7 EF             ld      bc, #EFF7
 212++65A1 AF                   xor     a
 213++65A2 ED 79                out     (c), a
 214++65A4                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
 215++65A4                      ; path established by p126_atm_video_init. RTC access is performed
 216++65A4                      ; after video initialization in Project126, so restore the documented
 217++65A4                      ; #0177 state and RG=6 text mode before returning to the host.
 218++65A4 CD 7B A0             call    p126_atm_restore_dosen
 219++65A7              ds12887_close_done:
 220++65A7 C1                   pop     bc
 221++65A8 F1                   pop     af
 222++65A9 C9                   ret
