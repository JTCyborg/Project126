 23++ 64A5                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
 24++ 64A5 AF                   xor     a
 25++ 64A6 32 B7 66             ld      (ds12887_backend), a
 26++ 64A9 CD 94 65             call    DS12887_OPEN
 27++ 64AC CD 4B 65             call    DS12887_READ_STATUS
 28++ 64AF                      ; A floating/unimplemented port often reads FF. A valid DS12887
 29++ 64AF                      ; has Status D exactly 80h and Status A divider bits 010b.
