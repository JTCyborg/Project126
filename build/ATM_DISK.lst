  1+++6043              ; =========================================================================
  2+++6043              ; PROJECT126 — ATM / NeoGS IPC public interface
  3+++6043              ; Version: P126_ATM_IPC_API v0.1.0
  4+++6043              ;
  5+++6043              ; Include this file in ATM-side Z80 modules that call neogs_ipc.asm.
  6+++6043              ; Physical transport: GSCOM/GSSTAT (#BB), GSDAT (#B3), GSCTR (#33).
  7+++6043              ; The ATM-side driver never accesses NeoGS-local DMA registers.
  8+++6043              ; =========================================================================
  9+++6043
 10+++6043              P126_GSCOM          EQU #BB
 11+++6043              P126_GSSTAT         EQU #BB
 12+++6043              P126_GSDAT          EQU #B3
 13+++6043              P126_GSCTR          EQU #33
 14+++6043
 15+++6043              P126_CBIT           EQU 0
 16+++6043              P126_DBIT           EQU 7
 17+++6043              P126_M_CBIT         EQU #01
 18+++6043              P126_M_DBIT         EQU #80
 19+++6043
 20+++6043              P126_GS_RESET       EQU #80
 21+++6043              P126_GS_NMI         EQU #40
 22+++6043              P126_GS_LED         EQU #20
 23+++6043
 24+++6043              ; Driver result convention:
 25+++6043              ;   Carry clear = operation completed.
 26+++6043              ;   Carry set   = timeout.
 27+++6043              ;   A           = last observed GSSTAT on timeout / final status on wait.
 28+++6043              ;   p126_ipc_last_status always contains the last sampled GSSTAT byte.
 29+++6043
 30+++6043              ; Public entry points (see docs/ATM_HOST_INTERFACE.md):
 31+++6043              ;   p126_ipc_read_status
 32+++6043              ;   p126_ipc_wait_cbit_clear
 33+++6043              ;   p126_ipc_wait_dbit_clear
 34+++6043              ;   p126_ipc_wait_dbit_set
 35+++6043              ;   p126_ipc_send_command       A=command
 36+++6043              ;   p126_ipc_send_argument      A=argument; preloads GSDAT before GSCOM
 37+++6043              ;   p126_ipc_send_byte          A=data; waits for consumption
 38+++6043              ;   p126_ipc_receive_byte       returns A=data
 39+++6043              ;   p126_ipc_emit_version
