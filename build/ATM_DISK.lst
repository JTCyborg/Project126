 189++64BE ED 79                out     (c), a
 190++64C0 18 07                jr      ds12887_open_done
 191++64C2              ds12887_open_smuc:
 192++64C2                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++64C2                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++64C2                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++64C2                      ; the SMUC multiplexed ISA address/control configuration and can
 196++64C2                      ; interfere with later TR-DOS disk operations.
 197++64C2 01 BA FF             ld      bc, #FFBA
 198++64C5 3E 71                ld      a, #71
 199++64C7 ED 79                out     (c), a
