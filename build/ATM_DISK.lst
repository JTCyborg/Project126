 173++A0A4              p126_screen_clear_guest_display:
 173++A0A4
 174++A0A4 F5                   push    af
 175++A0A5 C5                   push    bc
 176++A0A6 D5                   push    de
 177++A0A7 E5                   push    hl
 178++A0A8 CD 5F A3             call    p126_screen_map_video_pages
 179++A0AB
 180++A0AB                      ; Clear 25 rows x 64-byte stride in both character parity planes.
 181++A0AB 21 C0 41             ld      hl, #41C0
 182++A0AE 11 C1 41             ld      de, #41C1
 183++A0B1 36 20                ld      (hl), 32
 184++A0B3 01 3F 06             ld      bc, #063F
 185++A0B6 ED B0                ldir
 186++A0B8 21 C0 61             ld      hl, #61C0
 187++A0BB 11 C1 61             ld      de, #61C1
 188++A0BE 36 20                ld      (hl), 32
 189++A0C0 01 3F 06             ld      bc, #063F
 190++A0C3 ED B0                ldir
 191++A0C5
 192++A0C5                      ; Uniform neutral VGA-like text attributes across all 25 rows.
 193++A0C5                      ; No status panel, no log panel: the next guest frame owns the screen.
 194++A0C5 21 C0 E1             ld      hl, #E1C0
 195++A0C8 11 C1 E1             ld      de, #E1C1
 196++A0CB 36 07                ld      (hl), #07
 197++A0CD 01 3F 06             ld      bc, #063F
 198++A0D0 ED B0                ldir
 199++A0D2 21 C1 C1             ld      hl, #C1C1
 200++A0D5 11 C2 C1             ld      de, #C1C2
 201++A0D8 36 07                ld      (hl), #07
 202++A0DA 01 3F 06             ld      bc, #063F
 203++A0DD ED B0                ldir
 204++A0DF
 205++A0DF CD 6E A3             call    p126_screen_restore_host_pages
 206++A0E2 E1                   pop     hl
 207++A0E3 D1                   pop     de
 208++A0E4 C1                   pop     bc
 209++A0E5 F1                   pop     af
 210++A0E6 C9                   ret
