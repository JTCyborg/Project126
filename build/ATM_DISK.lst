  1++ 627C              ; =========================================================================
  2++ 627C              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
  3++ 627C              ; Version: D1.07
  4++ 627C              ;
  5++ 627C              ; ATM710 dual interface:
  6++ 627C              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 627C              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 627C              ; The RTC data/control registers are never written by this driver.
  9++ 627C              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 627C              ;
 11++ 627C              ; DS12887 registers used:
 12++ 627C              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 627C              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 627C              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
 15++ 627C              ; =========================================================================
