 157++6560 3E 20                ld      a, ' '
 158++6562 CD 96 66             call    DS12887_PRINT_CHAR
 159++6565 3A A8 66             ld      a, (ds12887_status_b)
 160++6568 C3 7B 66             jp      DS12887_PRINT_HEX8
 161++656B
 162++656B              ; Carry clear only for a plausible live DS12887 register set.
 163++656B              DS12887_VALIDATE_STATUS:
 164++656B 3A A9 66             ld      a, (ds12887_status_d)
 165++656E FE 80                cp      #80
 166++6570 20 0B                jr      nz, ds12887_status_invalid
 167++6572 3A A7 66             ld      a, (ds12887_status_a)
 168++6575 E6 70                and     #70
 169++6577 FE 20                cp      #20
 170++6579 20 02                jr      nz, ds12887_status_invalid
 171++657B B7                   or      a
