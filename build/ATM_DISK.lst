 23++ 6280                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
 24++ 6280 AF                   xor     a
 25++ 6281 32 92 64             ld      (ds12887_backend), a
 26++ 6284 CD 6F 63             call    DS12887_OPEN
 27++ 6287 CD 26 63             call    DS12887_READ_STATUS
 28++ 628A                      ; A floating/unimplemented port often reads FF. A valid DS12887
 29++ 628A                      ; has Status D exactly 80h and Status A divider bits 010b.
 30++ 628A CD 5B 63             call    DS12887_VALIDATE_STATUS
 31++ 628D 30 1C                jr      nc, ds12887_probe_status_ready
 32++ 628F
 33++ 628F                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
 34++ 628F                      ; Retry through the SMUC DFBA/FFBA index/data interface.
 35++ 628F CD 8A 63             call    DS12887_CLOSE
 36++ 6292 3E 01                ld      a, 1
 37++ 6294 32 92 64             ld      (ds12887_backend), a
 38++ 6297 CD 6F 63             call    DS12887_OPEN
 39++ 629A CD 26 63             call    DS12887_READ_STATUS
 40++ 629D                      ; Read back the SMUC system port after selecting address mode.
 41++ 629D                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
 42++ 629D                      ; an FF readback therefore identifies a closed DOS-port gate.
 43++ 629D 3A 92 64             ld      a, (ds12887_backend)
 44++ 62A0 B7                   or      a
 45++ 62A1 28 08                jr      z, ds12887_probe_status_ready
 46++ 62A3                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
 47++ 62A3                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
 48++ 62A3                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
 49++ 62A3                      ; this is a useful decoder-presence test.
 50++ 62A3 01 BE 5F             ld      bc, #5FBE
 51++ 62A6 ED 78                in      a, (c)
 52++ 62A8 32 93 64             ld      (ds12887_smuc_control), a
