294+  6383                      INCLUDE "atm_host/ds12887_rtc.asm"
# file opened: ds12887_rtc.asm
  1++ 6383              ; =========================================================================
  2++ 6383              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
  3++ 6383              ; Version: D1.07
  4++ 6383              ;
  5++ 6383              ; ATM710 dual interface:
  6++ 6383              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 6383              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 6383              ; The RTC data/control registers are never written by this driver.
  9++ 6383              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 6383              ;
 11++ 6383              ; DS12887 registers used:
 12++ 6383              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 6383              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 6383              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
 15++ 6383              ; =========================================================================
 16++ 6383
 17++ 6383              DS12887_PROBE:
 17++ 6383
 18++ 6383 F5                   push    af
 19++ 6384 C5                   push    bc
 20++ 6385 D5                   push    de
 21++ 6386 E5                   push    hl
 22++ 6387
 23++ 6387                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
 24++ 6387 AF                   xor     a
 25++ 6388 32 99 65             ld      (ds12887_backend), a
 26++ 638B CD 76 64             call    DS12887_OPEN
 27++ 638E CD 2D 64             call    DS12887_READ_STATUS
 28++ 6391                      ; A floating/unimplemented port often reads FF. A valid DS12887
 29++ 6391                      ; has Status D exactly 80h and Status A divider bits 010b.
 30++ 6391 CD 62 64             call    DS12887_VALIDATE_STATUS
 31++ 6394 30 1C                jr      nc, ds12887_probe_status_ready
 32++ 6396
 33++ 6396                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
 34++ 6396                      ; Retry through the SMUC DFBA/FFBA index/data interface.
 35++ 6396 CD 91 64             call    DS12887_CLOSE
 36++ 6399 3E 01                ld      a, 1
 37++ 639B 32 99 65             ld      (ds12887_backend), a
 38++ 639E CD 76 64             call    DS12887_OPEN
 39++ 63A1 CD 2D 64             call    DS12887_READ_STATUS
 40++ 63A4                      ; Read back the SMUC system port after selecting address mode.
 41++ 63A4                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
 42++ 63A4                      ; an FF readback therefore identifies a closed DOS-port gate.
 43++ 63A4 3A 99 65             ld      a, (ds12887_backend)
 44++ 63A7 B7                   or      a
 45++ 63A8 28 08                jr      z, ds12887_probe_status_ready
 46++ 63AA                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
 47++ 63AA                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
 48++ 63AA                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
 49++ 63AA                      ; this is a useful decoder-presence test.
 50++ 63AA 01 BE 5F             ld      bc, #5FBE
 51++ 63AD ED 78                in      a, (c)
 52++ 63AF 32 9A 65             ld      (ds12887_smuc_control), a
 53++ 63B2
