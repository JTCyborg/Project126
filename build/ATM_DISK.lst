# file opened: ds12887_rtc.asm
   1++648F              ; =========================================================================
   2++648F              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++648F              ; Version: D1.07
   4++648F              ;
   5++648F              ; ATM710 dual interface:
   6++648F              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++648F              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++648F              ; The RTC data/control registers are never written by this driver.
   9++648F              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++648F              ;
  11++648F              ; DS12887 registers used:
  12++648F              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++648F              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++648F              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15++648F              ; =========================================================================
  16++648F
  17++648F              DS12887_PROBE:
  17++648F
  18++648F F5                   push    af
  19++6490 C5                   push    bc
  20++6491 D5                   push    de
  21++6492 E5                   push    hl
  22++6493
  23++6493                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++6493 AF                   xor     a
  25++6494 32 A8 66             ld      (ds12887_backend), a
  26++6497 CD 82 65             call    DS12887_OPEN
  27++649A CD 39 65             call    DS12887_READ_STATUS
  28++649D                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++649D                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++649D CD 6E 65             call    DS12887_VALIDATE_STATUS
  31++64A0 30 1C                jr      nc, ds12887_probe_status_ready
  32++64A2
  33++64A2                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++64A2                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++64A2 CD 9D 65             call    DS12887_CLOSE
  36++64A5 3E 01                ld      a, 1
  37++64A7 32 A8 66             ld      (ds12887_backend), a
  38++64AA CD 82 65             call    DS12887_OPEN
  39++64AD CD 39 65             call    DS12887_READ_STATUS
  40++64B0                      ; Read back the SMUC system port after selecting address mode.
  41++64B0                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42++64B0                      ; an FF readback therefore identifies a closed DOS-port gate.
  43++64B0 3A A8 66             ld      a, (ds12887_backend)
  44++64B3 B7                   or      a
  45++64B4 28 08                jr      z, ds12887_probe_status_ready
  46++64B6                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47++64B6                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
  48++64B6                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
  49++64B6                      ; this is a useful decoder-presence test.
  50++64B6 01 BE 5F             ld      bc, #5FBE
  51++64B9 ED 78                in      a, (c)
  52++64BB 32 A9 66             ld      (ds12887_smuc_control), a
  53++64BE
