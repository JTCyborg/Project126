 128++652E              ds12887_time_done:
 129++652E CD 9A 65             call    DS12887_CLOSE
 130++6531 E1                   pop     hl
 131++6532 D1                   pop     de
 132++6533 C1                   pop     bc
 133++6534 F1                   pop     af
 134++6535 C9                   ret
