  57++64A6
  58++64A6 3E 01                ld      a, 1
  59++64A8 32 89 66             ld      (ds12887_available), a
  60++64AB
  61++64AB CD B2 65             call    DS12887_READ_SNAPSHOT
  62++64AE DA BB 64             jp      c, ds12887_probe_read_error
  63++64B1
  64++64B1 C3 BF 64             jp      ds12887_probe_done
