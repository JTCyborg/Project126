 177++6582              ; -------------------------------------------------------------------------
 178++6582              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++6582              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++6582              ; -------------------------------------------------------------------------
 181++6582              DS12887_OPEN:
 182++6582 F5                   push    af
 183++6583 C5                   push    bc
 184++6584 3A A8 66             ld      a, (ds12887_backend)
 185++6587 B7                   or      a
 186++6588 20 09                jr      nz, ds12887_open_smuc
