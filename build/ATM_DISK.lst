  2++ 667F              ; PROJECT126 — ATM Turbo 2+ / NeoGS host-side IPC driver
  3++ 667F              ; Version: P126_ATM_IPC v0.1.0
  4++ 667F              ;
  5++ 667F              ; This is ATM Z80 code. It runs on the 7 MHz host CPU.
  6++ 667F              ; NeoGS is an independent Z80 and has its own private debug port #EF.
  7++ 667F              ;
  8++ 667F              ; The implementation follows the proven Project125 host transport v2
  9++ 667F              ; handshake semantics. It intentionally contains no NeoGS-local IN/OUT
