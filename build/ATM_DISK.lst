  25++66AF              ; Driver result convention:
  26++66AF              ;   Carry clear = operation completed.
  27++66AF              ;   Carry set   = timeout.
  28++66AF              ;   A           = last observed GSSTAT on timeout / final status on wait.
  29++66AF              ;   p126_ipc_last_status always contains the last sampled GSSTAT byte.
  30++66AF
  31++66AF              ; Public entry points (see docs/ATM_HOST_INTERFACE.md):
  32++66AF              ;   p126_ipc_read_status
  33++66AF              ;   p126_ipc_wait_cbit_clear
  34++66AF              ;   p126_ipc_wait_dbit_clear
  35++66AF              ;   p126_ipc_wait_dbit_set
  36++66AF              ;   p126_ipc_send_command       A=command
  37++66AF              ;   p126_ipc_send_argument      A=argument; preloads GSDAT before GSCOM
  38++66AF              ;   p126_ipc_send_byte          A=data; waits for consumption
  39++66AF              ;   p126_ipc_receive_byte       returns A=data
  40++66AF              ;   p126_ipc_emit_version
  41++66AF              ;   p126_ipc_validate_frame HL=frame, BC=size; carry/A=status
  42++66AF              ;   p126_ipc_dma_send_frame HL=frame, BC=size; carry/A=status
  43++66AF              ;   p126_ipc_dma_receive_test returns carry clear only after reverse-DMA CRC/pattern PASS
  44++66AF              ; ABI 1.0 constants are imported from shared/p126_ipc_protocol.inc.
  45++66AF
  46++66AF              P126_IPC_TIMEOUT    EQU #FFFF
