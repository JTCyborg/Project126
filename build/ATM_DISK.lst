 177++64B1              ; -------------------------------------------------------------------------
 178++64B1              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++64B1              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++64B1              ; -------------------------------------------------------------------------
 181++64B1              DS12887_OPEN:
 182++64B1 F5                   push    af
 183++64B2 C5                   push    bc
