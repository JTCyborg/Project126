 191++64F9              ds12887_open_smuc:
 192++64F9                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++64F9                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++64F9                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++64F9                      ; the SMUC multiplexed ISA address/control configuration and can
 196++64F9                      ; interfere with later TR-DOS disk operations.
 197++64F9 01 BA FF             ld      bc, #FFBA
 198++64FC 3E 71                ld      a, #71
