# file opened: ds12887_rtc.asm
   1++63BE              ; =========================================================================
   2++63BE              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++63BE              ; Version: D1.07
   4++63BE              ;
   5++63BE              ; ATM710 dual interface:
   6++63BE              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++63BE              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++63BE              ; The RTC data/control registers are never written by this driver.
   9++63BE              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++63BE              ;
  11++63BE              ; DS12887 registers used:
  12++63BE              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++63BE              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++63BE              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
  15++63BE              ; =========================================================================
  16++63BE
  17++63BE              DS12887_PROBE:
  17++63BE
  18++63BE F5                   push    af
  19++63BF C5                   push    bc
  20++63C0 D5                   push    de
  21++63C1 E5                   push    hl
  22++63C2
  23++63C2                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++63C2 AF                   xor     a
  25++63C3 32 D7 65             ld      (ds12887_backend), a
  26++63C6 CD B1 64             call    DS12887_OPEN
  27++63C9 CD 68 64             call    DS12887_READ_STATUS
  28++63CC                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++63CC                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++63CC CD 9D 64             call    DS12887_VALIDATE_STATUS
  31++63CF 30 1C                jr      nc, ds12887_probe_status_ready
  32++63D1
  33++63D1                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++63D1                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++63D1 CD CC 64             call    DS12887_CLOSE
  36++63D4 3E 01                ld      a, 1
