 191++6586              ds12887_open_smuc:
 192++6586                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++6586                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++6586                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++6586                      ; the SMUC multiplexed ISA address/control configuration and can
 196++6586                      ; interfere with later TR-DOS disk operations.
 197++6586 01 BA FF             ld      bc, #FFBA
 198++6589 3E 71                ld      a, #71
 199++658B ED 79                out     (c), a
