 201++648E C1                   pop     bc
 202++648F F1                   pop     af
 203++6490 C9                   ret
 204++6491
 205++6491              DS12887_CLOSE:
 206++6491 F5                   push    af
 207++6492 C5                   push    bc
 208++6493 3A 9C 65             ld      a, (ds12887_backend)
 209++6496 B7                   or      a
 210++6497 20 09                jr      nz, ds12887_close_done
 211++6499 01 F7 EF             ld      bc, #EFF7
 212++649C AF                   xor     a
 213++649D ED 79                out     (c), a
 214++649F                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
 215++649F                      ; path established by p126_atm_video_init. RTC access is performed
 216++649F                      ; after video initialization in Project126, so restore the documented
 217++649F                      ; #0177 state and RG=6 text mode before returning to the host.
 218++649F CD 6D A0             call    p126_atm_restore_dosen
 219++64A2              ds12887_close_done:
 220++64A2 C1                   pop     bc
 221++64A3 F1                   pop     af
 222++64A4 C9                   ret
