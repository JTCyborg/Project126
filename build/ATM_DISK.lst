 163++A096 CD 31 A3             call    p126_screen_map_video_pages
 164++A099
 165++A099                      ; Clear 25 rows x 64-byte stride in both character parity planes.
 166++A099 21 C0 41             ld      hl, #41C0
 167++A09C 11 C1 41             ld      de, #41C1
 168++A09F 36 20                ld      (hl), 32
 169++A0A1 01 3F 06             ld      bc, #063F
