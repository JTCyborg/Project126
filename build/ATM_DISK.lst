  23++6475                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
  24++6475 AF                   xor     a
  25++6476 32 8A 66             ld      (ds12887_backend), a
  26++6479 CD 64 65             call    DS12887_OPEN
  27++647C CD 1B 65             call    DS12887_READ_STATUS
  28++647F                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++647F                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++647F CD 50 65             call    DS12887_VALIDATE_STATUS
  31++6482 30 1C                jr      nc, ds12887_probe_status_ready
  32++6484
  33++6484                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
  34++6484                      ; Retry through the SMUC DFBA/FFBA index/data interface.
  35++6484 CD 7F 65             call    DS12887_CLOSE
  36++6487 3E 01                ld      a, 1
  37++6489 32 8A 66             ld      (ds12887_backend), a
  38++648C CD 64 65             call    DS12887_OPEN
  39++648F CD 1B 65             call    DS12887_READ_STATUS
  40++6492                      ; Read back the SMUC system port after selecting address mode.
  41++6492                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
  42++6492                      ; an FF readback therefore identifies a closed DOS-port gate.
  43++6492 3A 8A 66             ld      a, (ds12887_backend)
  44++6495 B7                   or      a
  45++6496 28 08                jr      z, ds12887_probe_status_ready
  46++6498                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
  47++6498                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
  48++6498                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
  49++6498                      ; this is a useful decoder-presence test.
  50++6498 01 BE 5F             ld      bc, #5FBE
  51++649B ED 78                in      a, (c)
  52++649D 32 8B 66             ld      (ds12887_smuc_control), a
