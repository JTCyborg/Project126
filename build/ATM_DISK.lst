 191++657B              ds12887_open_smuc:
 192++657B                      ; SMUC FFBA is not a plain 0/1 selector: D6-D4 and D0
 193++657B                      ; must retain the documented fixed pattern 111...1. With D7=0,
 194++657B                      ; #71 selects RTC address/read mode on DFBA. Writing #00 corrupts
 195++657B                      ; the SMUC multiplexed ISA address/control configuration and can
 196++657B                      ; interfere with later TR-DOS disk operations.
 197++657B 01 BA FF             ld      bc, #FFBA
 198++657E 3E 71                ld      a, #71
 199++6580 ED 79                out     (c), a
