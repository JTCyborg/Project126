 235++65B2 79                   ld      a, c
 236++65B3 01 F7 DF             ld      bc, #DFF7
 237++65B6 ED 79                out     (c), a
 238++65B8 01 F7 BF             ld      bc, #BFF7
 239++65BB ED 78                in      a, (c)
 240++65BD C1                   pop     bc
 241++65BE C9                   ret
