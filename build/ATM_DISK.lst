 201++64C9 C1                   pop     bc
 202++64CA F1                   pop     af
 203++64CB C9                   ret
 204++64CC
 205++64CC              DS12887_CLOSE:
 206++64CC F5                   push    af
 207++64CD C5                   push    bc
 208++64CE 3A D7 65             ld      a, (ds12887_backend)
 209++64D1 B7                   or      a
 210++64D2 20 09                jr      nz, ds12887_close_done
 211++64D4 01 F7 EF             ld      bc, #EFF7
 212++64D7 AF                   xor     a
 213++64D8 ED 79                out     (c), a
 214++64DA                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
 215++64DA                      ; path established by p126_atm_video_init. RTC access is performed
 216++64DA                      ; after video initialization in Project126, so restore the documented
 217++64DA                      ; #0177 state and RG=6 text mode before returning to the host.
 218++64DA CD 6D A0             call    p126_atm_restore_dosen
 219++64DD              ds12887_close_done:
 220++64DD C1                   pop     bc
 221++64DE F1                   pop     af
 222++64DF C9                   ret
