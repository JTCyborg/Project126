   1++6491              ; =========================================================================
   2++6491              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++6491              ; Version: D1.07
   4++6491              ;
   5++6491              ; ATM710 dual interface:
   6++6491              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++6491              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++6491              ; The RTC data/control registers are never written by this driver.
   9++6491              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++6491              ;
  11++6491              ; DS12887 registers used:
  12++6491              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++6491              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
  14++6491              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
