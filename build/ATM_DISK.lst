  5++ 64A1              ; ATM710 dual interface:
  6++ 64A1              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
  7++ 64A1              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
  8++ 64A1              ; The RTC data/control registers are never written by this driver.
  9++ 64A1              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
 10++ 64A1              ;
 11++ 64A1              ; DS12887 registers used:
 12++ 64A1              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
 13++ 64A1              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
 14++ 64A1              ; Status A bit 7: UIP. Status D bit 7: VRT (valid RAM/time).
