  1++ 72BC              ; =========================================================================
  2++ 72BC              ; PROJECT126 — ATM host NeoGS bootstrap/firmware loader
  3++ 72BC              ; Runs before ATM video paging is enabled. TR-DOS sector reads use the same
  4++ 72BC              ; C=5/B=1 ABI already validated by p126_catalog_read_disk.
  5++ 72BC              ; =========================================================================
  6++ 72BC              P126_NGS_GSCOM EQU #BB
  7++ 72BC              P126_NGS_GSSTAT EQU #BB
  8++ 72BC              P126_NGS_GSDAT EQU #B3
  9++ 72BC              P126_NGS_GSCTR EQU #33
 10++ 72BC              P126_NGS_CBIT EQU 0
 11++ 72BC              P126_NGS_DBIT EQU 7
 12++ 72BC              P126_NGS_CMD_RAM EQU #20
 13++ 72BC              P126_NGS_CMD_JUMP EQU #13
 14++ 72BC              P126_NGS_CMD_RECV EQU #14
 15++ 72BC              P126_NGS_ACK_READY EQU #A1
 16++ 72BC              P126_NGS_ACK_LENGTH EQU #A3
 17++ 72BC              P126_NGS_ACK_DONE EQU #A2
 18++ 72BC              P126_NGS_TIMEOUT EQU #FFFF
 19++ 72BC
 20++ 72BC              ; Called after directory preload and before ATM video initialization.
 21++ 72BC              ; Carry clear means the resident image sent its A2h ready acknowledgement.
 22++ 72BC              p126_neogs_startup:
 22++ 72BC
 23++ 72BC 3E 31                ld      a,'1'
 24++ 72BE 32 91 76             ld      (p126_neogs_startup_stage),a
 25++ 72C1 21 59 76             ld      hl,p126_neogs_boot_name
 26++ 72C4 CD 30 74             call    p126_neogs_open_file
 27++ 72C7 D8                   ret     c
 28++ 72C8 3E 32                ld      a,'2'
 29++ 72CA 32 91 76             ld      (p126_neogs_startup_stage),a
 30++ 72CD                      ; The build deliberately permits a full 256-byte ROM #14 block.
 31++ 72CD                      ; Accept lengths 1..255 and exactly 256 (0100h); reject 0 and >256.
 32++ 72CD 2A 6B 76             ld      hl,(p126_neogs_file_length)
 33++ 72D0 7C                   ld      a,h
 34++ 72D1 B7                   or      a
 35++ 72D2 28 0C                jr      z,.p126_neogs_boot_length_low
 36++ 72D4 FE 01                cp      1
 37++ 72D6 C2 1D 74             jp      nz,p126_neogs_boot_file_bad
 38++ 72D9 7D                   ld      a,l
 39++ 72DA B7                   or      a
 40++ 72DB C2 1D 74             jp      nz,p126_neogs_boot_file_bad
 41++ 72DE 18 05                jr      .p126_neogs_boot_length_ok
 42++ 72E0              .p126_neogs_boot_length_low:
 43++ 72E0 7D                   ld      a,l
 44++ 72E1 B7                   or      a
 45++ 72E2 CA 1D 74             jp      z,p126_neogs_boot_file_bad
 46++ 72E5              .p126_neogs_boot_length_ok:
 47++ 72E5
 48++ 72E5                      ; Cold-restart the GS105a ROM only to enter its known bootstrap
 49++ 72E5                      ; receive state. Do NOT query #20: its RAM-size report is not an
 50++ 72E5                      ; authority for Project126 physical memory and must not gate startup.
 51++ 72E5 3E 41                ld      a,'A'
 52++ 72E7 32 91 76             ld      (p126_neogs_startup_stage),a
 53++ 72EA 3E F4                ld      a,#F4
 54++ 72EC CD C8 75             call    p126_neogs_send_command_long
 55++ 72EF DA 25 74             jp      c,p126_neogs_ram_bad
 56++ 72F2
 57++ 72F2
 58++ 72F2
 59++ 72F2                      ; GS105a #14 receives P126BOOT at logical 4000h.
 60++ 72F2 3E 34                ld      a,'4'
 61++ 72F4 32 91 76             ld      (p126_neogs_startup_stage),a
 62++ 72F7 21 00 00             ld      hl,0
 63++ 72FA ED 5B 6B 76          ld      de,(p126_neogs_file_length)
