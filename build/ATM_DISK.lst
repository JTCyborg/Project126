 40++ 64D3                      ; Read back the SMUC system port after selecting address mode.
 41++ 64D3                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
 42++ 64D3                      ; an FF readback therefore identifies a closed DOS-port gate.
 43++ 64D3 3A C8 66             ld      a, (ds12887_backend)
 44++ 64D6 B7                   or      a
 45++ 64D7 28 08                jr      z, ds12887_probe_status_ready
 46++ 64D9                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
 47++ 64D9                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
 48++ 64D9                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
 49++ 64D9                      ; this is a useful decoder-presence test.
 50++ 64D9 01 BE 5F             ld      bc, #5FBE
