 410+ 8AE1
 411+ 8AE1              ; Project125-derived ATM-native text console, relocated to window 2.
 412+ 8AE1              ; Its renderer maps video pages only for each write and restores host pages.
 413+ 8AE1                      PAGE 0
 414+ 8AE1                      ORG #A000
 415+ A000                      INCLUDE "atm_host/p126_screen_console.asm"
# file opened: p126_screen_console.asm
   1++A000              ; =========================================================================
   2++A000              ; PROJECT126 — ATM TURBO 2+ native 80x25 text console
   3++A000              ;
   4++A000              ; This module is deliberately placed at #A000 in window 2. The host program
   5++A000              ; is loaded at #6000 in physical page 5; the ATM text screen uses the
   6++A000              ; alternate screen pair page 7/page 3 selected by bit 3 of port #7FFD.
   7++A000              ;
   8++A000              ; The renderer temporarily maps page 7 to #4000 and page 3 to #C000, writes
   9++A000              ; the character/attribute, then restores page 5/page 0 before returning to
  10++A000              ; the caller. Code at #6000 and the TR-DOS #C000 staging buffer are preserved.
  11++A000              ;
  12++A000              ; Text layout follows the tested Project112 ATM 80x25 renderer:
  13++A000              ;   offset = #01C0 + row*64 + column/2
  14++A000              ;   character even: page 7, #4000+offset
  15++A000              ;   character odd : page 7, #6000+offset
  16++A000              ;   attribute even: page 3, #E000+offset
  17++A000              ;   attribute odd : page 3, #C000+offset+1
  18++A000              ; =========================================================================
  19++A000
  20++A000              BIOS_DEBUG_COLUMNS EQU 80
  21++A000              BIOS_DEBUG_ROWS    EQU 13
  22++A000              BIOS_DEBUG_TOP     EQU 12
  23++A000              P126_VIDEO_PAGE7   EQU #78          ; RAM page 7, inverted page number
  24++A000              P126_VIDEO_PAGE3   EQU #7C          ; RAM page 3, inverted page number
  25++A000              P126_HOST_PAGE5    EQU #7A          ; RAM page 5, host code at #6000
  26++A000              P126_HOST_PAGE0    EQU #7F          ; RAM page 0, TR-DOS staging at #C000
  27++A000              P126_ATM_TEXT_WIDTH EQU 80
  28++A000              P126_ATM_TEXT_HEIGHT EQU 25
  29++A000              P126_ATM_TEXT_FRAME_SIZE EQU 4000
  30++A000
  31++A000 06           p126_atm_video_mode: db P126_ATM_VIDEO_MODE_RG6_TEXT80X25
  32++A001 00           p126_atm_video_enabled: db 0
  33++A002 00           p126_screen_frame_char: db 0
  34++A003 00 00        p126_screen_frame_char_ptr: dw 0
  35++A005 00 00        p126_screen_frame_attr_ptr: dw 0
  36++A007 00           p126_screen_frame_row:      db 0
  37++A008 00           p126_screen_frame_col:      db 0
  38++A009
  39++A009 00           Console_X: db 0
  40++A00A 0C           Console_Y: db BIOS_DEBUG_TOP
  41++A00B
  42++A00B              ; =========================================================================
  43++A00B              ; ATM shadow-port and text-mode initialization.
  44++A00B              ; The TR-DOS ROM trampoline must run before any #7FF7/#FFF7/#0177 access.
  45++A00B              ; =========================================================================
  46++A00B              p126_atm_video_init:
  46++A00B
  47++A00B F5                   push    af
  48++A00C C5                   push    bc
  49++A00D D5                   push    de
  50++A00E E5                   push    hl
  51++A00F
  52++A00F                      ; Reset the ATM paging/control latch BEFORE enabling permanent
  53++A00F                      ; DOSEN. On this board #EFF7 is part of the ATM paging control path;
  54++A00F                      ; resetting it after the #0177 shadow-port setup can undo the state
  55++A00F                      ; needed by the TR-DOS overlay.
  56++A00F AF                   xor     a
  57++A010 01 F7 EF             ld      bc, #EFF7
  58++A013 ED 79                out     (c), a
  59++A015
  60++A015                      ; ROM2=1 (D4) is required for TR-DOS overlay; D3 selects alternate
  61++A015                      ; video pages 7/3. This is #18, matching the host display setup.
  62++A015 3E 18                ld      a, #18
  63++A017 01 FD 7F             ld      bc, #7FFD
  64++A01A ED 79                out     (c), a
  65++A01C 32 3B 5C             ld      (#5C3B), a
  66++A01F
  67++A01F                      ; Open shadow ports and hold DOSEN permanently (A9=0) using the
  68++A01F                      ; documented TR-DOS ROM trampoline. Do this AFTER the paging reset.
  69++A01F 01 2F A0             ld      bc, p126_atm_ports_open_done
  70++A022 C5                   push    bc
  71++A023 01 53 2A             ld      bc, #2A53
  72++A026 C5                   push    bc
  73++A027 01 77 01             ld      bc, #0177
  74++A02A 3E C3                ld      a, #C3
  75++A02C C3 2F 3D             jp      #3D2F
  76++A02F
  77++A02F              p126_atm_ports_open_done:
  78++A02F                      ; Window 0 must use ROM with D7=1 so its ROM page selection is
  79++A02F                      ; coupled to ROM2/DOSEN. #BF selects the low ROM page with the
  80++A02F                      ; DOSEN-controlled low ROM select: BASIC-48 when DOSEN=0, TR-DOS
  81++A02F                      ; when DOSEN=1. This is the ATM2+ documented auto-TR-DOS mapping.
  82++A02F 3E BF                ld      a, #BF
  83++A031 01 F7 3F             ld      bc, #3FF7
  84++A034 ED 79                out     (c), a
  85++A036
  86++A036
  87++A036                      ; Map the alternate screen pages while the 32-byte mode trampoline
  88++A036                      ; is installed at #FFEC. Window 3 uses a fixed RAM page here; the
  89++A036                      ; TR-DOS auto-select mux is configured separately in window 0.
  90++A036 3E 78                ld      a, P126_VIDEO_PAGE7
  91++A038 01 F7 7F             ld      bc, #7FF7
  92++A03B ED 79                out     (c), a
  93++A03D 3E 7C                ld      a, P126_VIDEO_PAGE3
  94++A03F 01 F7 FF             ld      bc, #FFF7
  95++A042 ED 79                out     (c), a
  96++A044
  97++A044                      ; LD BC,#0177 / OUT (C),A / JP p126_atm_video_mode_ready
  98++A044 21 EC FF             ld      hl, #FFEC
  99++A047 36 01                ld      (hl), #01
 100++A049 23                   inc     hl
 101++A04A 36 77                ld      (hl), #77
 102++A04C 23                   inc     hl
 103++A04D 36 01                ld      (hl), #01
 104++A04F 23                   inc     hl
 105++A050 36 ED                ld      (hl), #ED
 106++A052 23                   inc     hl
 107++A053 36 79                ld      (hl), #79
 108++A055 23                   inc     hl
 109++A056 36 C3                ld      (hl), #C3
 110++A058 23                   inc     hl
 111++A059 36 68                ld      (hl), p126_atm_video_mode_ready & #FF
 112++A05B 23                   inc     hl
 113++A05C 36 A0                ld      (hl), p126_atm_video_mode_ready >> 8
 114++A05E
 115++A05E                      ; ATM Turbo 2+ RG=6: hardware text 80x25.
 116++A05E 3E 06                ld      a,P126_ATM_VIDEO_MODE_RG6_TEXT80X25
 117++A060 32 00 A0             ld      (p126_atm_video_mode),a
 118++A063 3E C6                ld      a, #C6
 119++A065 C3 EC FF             jp      #FFEC
