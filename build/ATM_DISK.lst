 180++6564              ; -------------------------------------------------------------------------
 181++6564              DS12887_OPEN:
 182++6564 F5                   push    af
 183++6565 C5                   push    bc
 184++6566 3A 8A 66             ld      a, (ds12887_backend)
 185++6569 B7                   or      a
