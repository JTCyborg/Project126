 205++6585              DS12887_CLOSE:
 206++6585 F5                   push    af
 207++6586 C5                   push    bc
 208++6587 3A 90 66             ld      a, (ds12887_backend)
 209++658A B7                   or      a
 210++658B 20 09                jr      nz, ds12887_close_done
 211++658D 01 F7 EF             ld      bc, #EFF7
 212++6590 AF                   xor     a
 213++6591 ED 79                out     (c), a
 214++6593                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
 215++6593                      ; path established by p126_atm_video_init. RTC access is performed
 216++6593                      ; after video initialization in Project126, so restore the documented
 217++6593                      ; #0177 state and RG=6 text mode before returning to the host.
 218++6593 CD 7B A0             call    p126_atm_restore_dosen
