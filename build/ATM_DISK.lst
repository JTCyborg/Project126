# file opened: ds12887_rtc.asm
   1++63F5              ; =========================================================================
   2++63F5              ; PROJECT125 — Dallas DS12887 RTC driver for ATM Turbo 2+
   3++63F5              ; Version: D1.07
   4++63F5              ;
   5++63F5              ; ATM710 dual interface:
   6++63F5              ;   Native GLUK: EFF7 bit 7 gate, DFF7 index, BFF7 data.
   7++63F5              ;   SMUC fallback: FFBA selects address mode, DFBA index/data.
   8++63F5              ; The RTC data/control registers are never written by this driver.
   9++63F5              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++63F5              ;
  11++63F5              ; DS12887 registers used:
  12++63F5              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
