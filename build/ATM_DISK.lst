 23++ 6213                      ; First try the native GLUK/ATM DFF7/BFF7 interface.
 24++ 6213 AF                   xor     a
 25++ 6214 32 25 64             ld      (ds12887_backend), a
 26++ 6217 CD 02 63             call    DS12887_OPEN
 27++ 621A CD B9 62             call    DS12887_READ_STATUS
 28++ 621D                      ; A floating/unimplemented port often reads FF. A valid DS12887
 29++ 621D                      ; has Status D exactly 80h and Status A divider bits 010b.
 30++ 621D CD EE 62             call    DS12887_VALIDATE_STATUS
 31++ 6220 30 1C                jr      nc, ds12887_probe_status_ready
 32++ 6222
 33++ 6222                      ; ATM710 emulators may expose the same Dallas CMOS through SMUC.
 34++ 6222                      ; Retry through the SMUC DFBA/FFBA index/data interface.
 35++ 6222 CD 1D 63             call    DS12887_CLOSE
 36++ 6225 3E 01                ld      a, 1
 37++ 6227 32 25 64             ld      (ds12887_backend), a
 38++ 622A CD 02 63             call    DS12887_OPEN
 39++ 622D CD B9 62             call    DS12887_READ_STATUS
 40++ 6230                      ; Read back the SMUC system port after selecting address mode.
 41++ 6230                      ; Unreal Speccy decodes SMUC only while CF_DOSPORTS is active;
 42++ 6230                      ; an FF readback therefore identifies a closed DOS-port gate.
 43++ 6230 3A 25 64             ld      a, (ds12887_backend)
 44++ 6233 B7                   or      a
 45++ 6234 28 08                jr      z, ds12887_probe_status_ready
 46++ 6236                      ; #5FBE is a fixed SMUC signature port in Unreal Speccy:
 47++ 6236                      ; it returns #57 only when both CF_DOSPORTS and SMUC decode are active.
 48++ 6236                      ; Unlike #FFBA (NVRAM output, which may legitimately be #FF),
 49++ 6236                      ; this is a useful decoder-presence test.
