  26++647F CD 6A 65             call    DS12887_OPEN
  27++6482 CD 21 65             call    DS12887_READ_STATUS
  28++6485                      ; A floating/unimplemented port often reads FF. A valid DS12887
  29++6485                      ; has Status D exactly 80h and Status A divider bits 010b.
  30++6485 CD 56 65             call    DS12887_VALIDATE_STATUS
