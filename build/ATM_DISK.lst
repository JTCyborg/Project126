 173++A0A5              BIOS_DebugConsole_Clear:
 173++A0A5
 174++A0A5 F5                   push    af
 175++A0A6 C5                   push    bc
 176++A0A7 D5                   push    de
 177++A0A8 E5                   push    hl
 178++A0A9 CD A3 A3             call    p126_screen_map_video_pages
 179++A0AC
 180++A0AC                      ; Clear 25 rows x 64-byte stride in both character parity planes.
 181++A0AC 21 C0 41             ld      hl, #41C0
 182++A0AF 11 C1 41             ld      de, #41C1
 183++A0B2 36 20                ld      (hl), 32
 184++A0B4 01 3F 06             ld      bc, #063F
 185++A0B7 ED B0                ldir
 186++A0B9 21 C0 61             ld      hl, #61C0
 187++A0BC 11 C1 61             ld      de, #61C1
 188++A0BF 36 20                ld      (hl), 32
 189++A0C1 01 3F 06             ld      bc, #063F
 190++A0C4 ED B0                ldir
 191++A0C6
 192++A0C6                      ; Default attributes, then color the status panel blue/white.
 193++A0C6 21 C0 E1             ld      hl, #E1C0
 194++A0C9 11 C1 E1             ld      de, #E1C1
 195++A0CC 36 47                ld      (hl), #47
 196++A0CE 01 3F 06             ld      bc, #063F
 197++A0D1 ED B0                ldir
 198++A0D3 21 C1 C1             ld      hl, #C1C1
 199++A0D6 11 C2 C1             ld      de, #C1C2
 200++A0D9 36 47                ld      (hl), #47
 201++A0DB 01 3F 06             ld      bc, #063F
 202++A0DE ED B0                ldir
 203++A0E0
 204++A0E0 21 C0 E1             ld      hl, #E1C0
