 153++A08D 3E C6                ld      a,#C6
 154++A08F C3 2F 3D             jp      #3D2F
 155++A092              p126_atm_restore_dosen_done:
 156++A092 C1                   pop     bc
 157++A093 F1                   pop     af
 158++A094 C9                   ret
