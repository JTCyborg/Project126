  56++64C3 DA D4 64             jp      c, ds12887_probe_invalid
  57++64C6
  58++64C6 3E 01                ld      a, 1
  59++64C8 32 A9 66             ld      (ds12887_available), a
  60++64CB
  61++64CB CD D2 65             call    DS12887_READ_SNAPSHOT
  62++64CE DA DB 64             jp      c, ds12887_probe_read_error
  63++64D1
  64++64D1 C3 DF 64             jp      ds12887_probe_done
