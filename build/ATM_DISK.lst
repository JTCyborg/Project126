 179++A0B6 11 C1 E1             ld      de, #E1C1
 180++A0B9 36 47                ld      (hl), #47
 181++A0BB 01 3F 06             ld      bc, #063F
 182++A0BE ED B0                ldir
 183++A0C0 21 C1 C1             ld      hl, #C1C1
 184++A0C3 11 C2 C1             ld      de, #C1C2
 185++A0C6 36 47                ld      (hl), #47
 186++A0C8 01 3F 06             ld      bc, #063F
 187++A0CB ED B0                ldir
 188++A0CD
 189++A0CD 21 C0 E1             ld      hl, #E1C0
