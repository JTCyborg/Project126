 211++64D5 01 F7 EF             ld      bc, #EFF7
 212++64D8 AF                   xor     a
 213++64D9 ED 79                out     (c), a
 214++64DB                      ; #EFF7 has A9=1 and therefore closes the permanent DOSEN/shadow
 215++64DB                      ; path established by p126_atm_video_init. RTC access is performed
 216++64DB                      ; after video initialization in Project126, so restore the documented
