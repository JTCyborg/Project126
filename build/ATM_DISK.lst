 27++ 72CD D8                   ret     c
 28++ 72CE 3E 32                ld      a,'2'
 29++ 72D0 32 97 76             ld      (p126_neogs_startup_stage),a
 30++ 72D3                      ; The build deliberately permits a full 256-byte ROM #14 block.
 31++ 72D3                      ; Accept lengths 1..255 and exactly 256 (0100h); reject 0 and >256.
 32++ 72D3 2A 71 76             ld      hl,(p126_neogs_file_length)
 33++ 72D6 7C                   ld      a,h
 34++ 72D7 B7                   or      a
 35++ 72D8 28 0C                jr      z,.p126_neogs_boot_length_low
 36++ 72DA FE 01                cp      1
