   8++6477              ; The RTC data/control registers are never written by this driver.
   9++6477              ; READ_CURRENT_TIME is the timestamp API used by main.asm.
  10++6477              ;
  11++6477              ; DS12887 registers used:
  12++6477              ;   00 seconds, 02 minutes, 04 hours, 0A Status A, 0B Status B, 0D Status D
  13++6477              ; Status B bit 2: 1=binary, 0=BCD; bit 1: 1=24-hour, 0=12-hour.
