  24++71A1 B7                   or      a
  25++71A2 20 08                jr      nz, .catalog_data_preloaded
  26++71A4                      ; Defensive fallback for standalone callers; normal startup preloads
  27++71A4                      ; the directory before ATM video initialization.
  28++71A4 CD 4F 74             call    p126_catalog_read_disk
  29++71A7 3E 01                ld      a, 1
  30++71A9 32 CD 77             ld      (p126_catalog_preloaded), a
