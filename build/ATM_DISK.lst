 121++A068              p126_atm_video_mode_ready:
 122++A068                      ; Restore CPU-visible host/staging pages. Keep D7 clear on #FFF7 so
 123++A068                      ; window 3 remains fixed to RAM page 0 for the TR-DOS staging buffer.
 124++A068 3E 7A                ld      a, P126_HOST_PAGE5
 125++A06A 01 F7 7F             ld      bc, #7FF7
 126++A06D ED 79                out     (c), a
 127++A06F 3E 7F                ld      a, P126_HOST_PAGE0
 128++A071 01 F7 FF             ld      bc, #FFF7
 129++A074 ED 79                out     (c), a
 130++A076
 131++A076 E1                   pop     hl
 132++A077 D1                   pop     de
 133++A078 C1                   pop     bc
 134++A079 F1                   pop     af
 135++A07A C9                   ret
 136++A07B
 137++A07B              ; Reopen the permanent ATM shadow-port/DOSEN state after an RTC access.
 138++A07B              ; DS12887_OPEN/CLOSE uses #EFF7, whose A9=1 write closes the permanent
 139++A07B              ; DOSEN path. Re-enter #3Dxx, execute OUT (C),A from the TR-DOS ROM, and
 140++A07B              ; write #C6 to #0177: A9=0 keeps shadow ports/DOSEN active and RG=6 restores
 141++A07B              ; the fixed ATM 80x25 text mode. ROM2 and WIN0 selector #3FF7=#BF must remain
 142++A07B              ; configured by p126_atm_video_init.
 143++A07B              p126_atm_restore_dosen:
 143++A07B
 144++A07B F5                   push    af
 145++A07C C5                   push    bc
 146++A07D 01 92 A0             ld      bc,p126_atm_restore_dosen_done
 147++A080 C5                   push    bc
 148++A081 01 53 2A             ld      bc,#2A53
 149++A084 C5                   push    bc
 150++A085 01 77 01             ld      bc,#0177
 151++A088 3E 06                ld      a,P126_ATM_VIDEO_MODE_RG6_TEXT80X25
 152++A08A 32 00 A0             ld      (p126_atm_video_mode),a
 153++A08D 3E C6                ld      a,#C6
 154++A08F C3 2F 3D             jp      #3D2F
 155++A092              p126_atm_restore_dosen_done:
 156++A092 C1                   pop     bc
 157++A093 F1                   pop     af
 158++A094 C9                   ret
