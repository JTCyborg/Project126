 177++6575              ; -------------------------------------------------------------------------
 178++6575              ; GLUK/ATM CMOS gate. Match the known-working Project124 sequence.
 179++6575              ; EFF7 bit 7 enables the DFF7/BFF7 RTC/CMOS port decoder.
 180++6575              ; -------------------------------------------------------------------------
 181++6575              DS12887_OPEN:
 182++6575 F5                   push    af
 183++6576 C5                   push    bc
 184++6577 3A 9B 66             ld      a, (ds12887_backend)
 185++657A B7                   or      a
 186++657B 20 09                jr      nz, ds12887_open_smuc
 187++657D 01 F7 EF             ld      bc, #EFF7
 188++6580 3E 80                ld      a, #80
 189++6582 ED 79                out     (c), a
