160+  00E5              P126_NGS_DMA_CST      EQU #1F
161+  00E5              P126_NGS_ZXSTAT       EQU #04
162+  00E5              P126_NGS_CLRCBIT      EQU #05
163+  00E5              P126_NGS_MPAGEX_PORT  EQU #10
164+  00E5              ; Production DMA staging allocation: physical page 42h = 108000h.
165+  00E5              ; WIN3 (C000h-FFFFh) is the dedicated bank window; resident code/data/stack
166+  00E5              ; remain outside WIN3. Map the page before arming DMA and keep it mapped
167+  00E5              ; until frame validation or reverse-transfer completion.
168+  00E5              P126_NGS_DMA_PROD_PAGE EQU #42
169+  00E5              P126_NGS_DMA_WAIT_LIMIT EQU #FFFF
