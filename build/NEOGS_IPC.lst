237+  0154              ; -------------------------------------------------------------------------
238+  0154              ; Resident command-dispatch entry, one bounded unit of work.
239+  0154              ; OUT: carry clear/Z=1/A=0 when no command is pending;
240+  0154              ;      carry clear/Z=0 with HL=#C000, BC=size on a valid E0h frame;
241+  0154              ;      carry set/A=status for a rejected command or receive failure.
242+  0154              ; The caller owns the resident main loop and must keep its stack/code outside
243+  0154              ; WIN3. E0h is consumed from ZXCMD while CBIT stays asserted until DMA is armed.
244+  0154              ; -------------------------------------------------------------------------
245+  0154              P126_NGS_ZXCMD       EQU #01
246+  0154
247+  0154              p126_ngs_ipc_dispatch_once:
247+  0154
248+  0154 DB 04                in      a,(P126_NGS_ZXSTAT)
249+  0156 CB 47                bit     0,a
250+  0158 20 02                jr      nz,.p126_ngs_dispatch_command
251+  015A AF                   xor     a
252+  015B C9                   ret
253+  015C
254+  015C              .p126_ngs_dispatch_command:
255+  015C DB 01                in      a,(P126_NGS_ZXCMD)
256+  015E FE E0                cp      P126_CMD_HOST_FRAME
257+  0160 28 07                jr      z,.p126_ngs_dispatch_host_frame
