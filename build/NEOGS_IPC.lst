1808+ 0EFA 7E                   ld      a,(hl)
1809+ 0EFB 23                   inc     hl
1810+ 0EFC B7                   or      a
1811+ 0EFD 20 FB                jr      nz,.p126_ngs_ipc_log_suppressed
1812+ 0EFF C1                   pop     bc
1813+ 0F00 F1                   pop     af
1814+ 0F01 C9                   ret
