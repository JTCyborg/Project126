 8+   0000              ; CRC-16/CCITT-FALSE byte update.
 9+   0000              ; IN : HL=current CRC, A=next byte.
10+   0000              ; OUT: HL=updated CRC. BC preserved.
11+   0000              p126_ngs_ipc_crc16_update:
11+   0000
12+   0000 C5                   push    bc
13+   0001 AC                   xor     h
14+   0002 67                   ld      h, a
15+   0003 06 08                ld      b, 8
16+   0005              .p126_ngs_crc_bit:
17+   0005 29                   add     hl, hl
18+   0006 30 08                jr      nc, .p126_ngs_crc_no_xor
19+   0008 7C                   ld      a, h
20+   0009 EE 10                xor     #10
21+   000B 67                   ld      h, a
22+   000C 7D                   ld      a, l
23+   000D EE 21                xor     #21
24+   000F 6F                   ld      l, a
25+   0010              .p126_ngs_crc_no_xor:
26+   0010 10 F3                djnz    .p126_ngs_crc_bit
27+   0012 C1                   pop     bc
28+   0013 C9                   ret
29+   0014
30+   0014              ; Standard CRC-16/CCITT-FALSE regression vector.
31+   0014              ; OUT: Carry clear and HL=#29B1 on pass; Carry set on failure.
32+   0014              p126_ngs_ipc_crc16_selftest:
32+   0014
33+   0014 C5                   push    bc
34+   0015 D5                   push    de
35+   0016 21 FF FF             ld      hl, #FFFF
36+   0019 11 38 00             ld      de, p126_ngs_ipc_crc16_test_vector
37+   001C 06 09                ld      b, 9
38+   001E              .p126_ngs_crc_test_loop:
39+   001E 1A                   ld      a, (de)
40+   001F 13                   inc     de
41+   0020 CD 00 00             call    p126_ngs_ipc_crc16_update
42+   0023 10 F9                djnz    .p126_ngs_crc_test_loop
43+   0025 11 B1 29             ld      de, #29B1
44+   0028 B7                   or      a
45+   0029 ED 52                sbc     hl, de
46+   002B 20 07                jr      nz, .p126_ngs_crc_test_failed
47+   002D D1                   pop     de
48+   002E C1                   pop     bc
49+   002F 21 B1 29             ld      hl, #29B1
50+   0032 B7                   or      a
51+   0033 C9                   ret
52+   0034              .p126_ngs_crc_test_failed:
53+   0034 D1                   pop     de
54+   0035 C1                   pop     bc
55+   0036 37                   scf
56+   0037 C9                   ret
57+   0038
58+   0038              p126_ngs_ipc_crc16_test_vector:
59+   0038 31 32 33 34          db "123456789"
59+   003C 35 36 37 38
59+   0040 39
60+   0041
