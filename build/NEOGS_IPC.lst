175+  00E5                      ; rotated right once (RRCA); PG3 (#23) is not the WIN3 selector.
176+  00E5                      ; Resident stack/code remain in WIN0-WIN2.
177+  00E5 3E 42                ld      a,P126_NGS_DMA_PROD_PAGE
