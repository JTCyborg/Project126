146+  00E6              ; -------------------------------------------------------------------------
147+  00E6              ; Receive one ATM -> NeoGS ABI 1.0 frame through ZX DMA.
148+  00E6              ; Entry: resident dispatcher consumed E0h from ZXCMD; CBIT remains asserted.
149+  00E6              ; Resident code, stack and interrupt handlers must stay in WIN0-WIN2.
150+  00E6              ; OUT: carry clear/A=0, HL=#C000 and BC=derived frame size; otherwise
151+  00E6              ; carry set/A=status. Uses physical DMA page 42h (108000h), then maps it
152+  00E6              ; into WIN3. The callable dispatcher below routes E0h to this endpoint.
153+  00E6              ; -------------------------------------------------------------------------
154+  00E6              P126_NGS_DMA_MOD      EQU #1B
155+  00E6              P126_NGS_DMA_HAD      EQU #1C
156+  00E6              P126_NGS_DMA_MAD      EQU #1D
157+  00E6              P126_NGS_DMA_LAD      EQU #1E
158+  00E6              P126_NGS_DMA_CST      EQU #1F
159+  00E6              P126_NGS_ZXSTAT       EQU #04
160+  00E6              P126_NGS_CLRCBIT      EQU #05
161+  00E6              P126_NGS_WIN3_PORT    EQU #23
162+  00E6              P126_NGS_DMA_TARGET_PAGE     EQU #42
163+  00E6              P126_NGS_DMA_TIMEOUT  EQU #FFFF
164+  00E6
165+  00E6              p126_ngs_ipc_dma_receive_frame:
165+  00E6
166+  00E6 3E 01                ld      a,1
167+  00E8 D3 1B                out     (P126_NGS_DMA_MOD),a
168+  00EA 3E 10                ld      a,#10
169+  00EC D3 1C                out     (P126_NGS_DMA_HAD),a
170+  00EE 3E 80                ld      a,#80
171+  00F0 D3 1D                out     (P126_NGS_DMA_MAD),a
172+  00F2 AF                   xor     a
173+  00F3 D3 1E                out     (P126_NGS_DMA_LAD),a
174+  00F5 3E 80                ld      a,#80
175+  00F7 D3 1F                out     (P126_NGS_DMA_CST),a
176+  00F9 AF                   xor     a
177+  00FA D3 05                out     (P126_NGS_CLRCBIT),a
178+  00FC
179+  00FC 01 FF FF             ld      bc,P126_NGS_DMA_TIMEOUT
