285+  01AB              ; -------------------------------------------------------------------------
286+  01AB              ; Resident command-dispatch entry, one bounded unit of work.
287+  01AB              ; OUT: carry clear/Z=1/A=0 when no command is pending;
288+  01AB              ;      carry clear/Z=0 with HL=#C000, BC=size on a valid E0h frame;
289+  01AB              ;      carry set/A=status for a rejected command or receive failure.
290+  01AB              ; The caller owns the resident main loop and must keep its stack/code outside
291+  01AB              ; WIN3. E0h is consumed from ZXCMD while CBIT stays asserted until DMA is armed.
292+  01AB              ; -------------------------------------------------------------------------
293+  01AB              P126_NGS_ZXCMD       EQU #01
