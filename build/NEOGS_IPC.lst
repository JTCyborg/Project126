261+  016F              ; -------------------------------------------------------------------------
262+  016F              ; Resident command-dispatch entry, one bounded unit of work.
263+  016F              ; OUT: carry clear/Z=1/A=0 when no command is pending;
264+  016F              ;      carry clear/Z=0 with HL=#C000, BC=size on a valid E0h frame;
265+  016F              ;      carry set/A=status for a rejected command or receive failure.
266+  016F              ; The caller owns the resident main loop and must keep its stack/code outside
267+  016F              ; WIN3. E0h is consumed from ZXCMD while CBIT stays asserted until DMA is armed.
268+  016F              ; -------------------------------------------------------------------------
269+  016F              P126_NGS_ZXCMD       EQU #01
270+  016F
271+  016F              p126_ngs_ipc_dispatch_once:
271+  016F
272+  016F DB 04                in      a,(P126_NGS_ZXSTAT)
273+  0171 CB 47                bit     0,a
274+  0173 20 02                jr      nz,.p126_ngs_dispatch_command
