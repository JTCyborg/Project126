862+  07F9 ED 79                out     (c),a
863+  07FB 18 F7                jr      .p126_ngs_ipc_log_loop
864+  07FD              .p126_ngs_ipc_log_done:
865+  07FD C1                   pop     bc
866+  07FE F1                   pop     af
867+  07FF C9                   ret
